---
// La date limite des inscriptions (ticket 148 ; v2 du 13/11 : un bandeau jaune pâle, comme sur le canevas). Le site est
// statique : la date passée disparaît à la construction suivante.
import type { DateInscription } from '../modele/inscriptions';
import { dateLongue } from '../modele/pointe-noire';

interface Props {
  inscription: DateInscription;
}
const { inscription } = Astro.props;
---

<section class="inscriptions" aria-label="Inscriptions">
  <h2>Inscriptions {inscription.anneeScolaire}</h2>
  <p>
    Date limite annoncée&nbsp;: <strong>{dateLongue(inscription.limite)}</strong>
  </p>
  <p class="declaree">Annoncée par l’école le {dateLongue(inscription.declareeLe)}.</p>
</section>

<style>
  .inscriptions {
    display: grid;
    gap: var(--espace-1);
    padding: var(--espace-3) var(--espace-4);
    border-radius: var(--rayon-m);
    background: var(--statut-attention-fond);
    color: var(--statut-attention-texte);
  }
  .inscriptions h2 {
    font-size: var(--taille-intertitre);
  }
  .declaree {
    font-size: var(--taille-secondaire);
  }
</style>
