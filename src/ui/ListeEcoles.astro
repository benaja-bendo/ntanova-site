---
// Les écoles en lignes cliquables : la liste d'une zone, d'un coin vu de près, d'une formation. Chaque ligne est celle de
// toutes les listes d'écoles du site (`LigneEcole.astro`, audit du 05/11/2026, D6) : disque du cycle, nom, niveaux et type,
// lieu et repère, preuve.
import './carte-pieces.css';
import { ligneDeEcole } from '../modele/ligne-ecole';
import type { EcolePubliee } from '../modele/ports';
import LigneEcole from './LigneEcole.astro';

interface Props {
  ecoles: EcolePubliee[];
  id?: string;
}
const { ecoles, id } = Astro.props;
---

<ul class="liste-lignes" id={id}>
  {ecoles.map((e) => (
    <LigneEcole d={ligneDeEcole(e)} />
  ))}
</ul>
