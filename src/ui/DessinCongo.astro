---
// Le dessin de l'accueil (refonte publique, lot 1, 24/11/2026) : le Congo-Brazzaville en points, un point jaune là où une
// école publiée a sa fiche, une étiquette par ville (un vrai lien vers sa page), et la famille du canevas. Une illustration
// en SVG écrit dans la page : ni carte interactive, ni script, ni tuile. Les points et les villes viennent du catalogue
// (`modele/carte-accueil.ts`) ; la liste « Par ville » de l'accueil dit la même chose sans le dessin.
import type { CarteDeLAccueil } from '../modele/carte-accueil';
import { compterEcoles } from '../modele/geo-divisions';

interface Props {
  carte: CarteDeLAccueil;
  /** « 24/11 » : le jour de l'annuaire, à côté de chaque nombre. */
  jour: string;
  /** Le préfixe des identifiants du motif et du contour, pour deux dessins dans une même page (le catalogue). */
  id?: string;
  /**
   * Lot 4 (« Toutes les villes ») : sans les étiquettes des villes ni la famille, le dessin seul, sur le fond clair de la page
   * (trame et légende foncées, légende sous le dessin). La page liste déjà les villes en liens : deux fois le même lien serait
   * du bruit au clavier.
   */
  seul?: boolean;
}
const { carte, jour, id = 'congo', seul = false } = Astro.props;
const [x0, y0, largeur, hauteur] = carte.boite;
const demi = carte.pas / 2;
---

<figure class:list={['dessin-congo', { 'dessin-seul': seul }]}>
  <div class="dessin-cadre" style={`aspect-ratio: ${largeur} / ${hauteur}`}>
    <svg
      class="dessin-carte"
      viewBox={`${x0} ${y0} ${largeur} ${hauteur}`}
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <pattern
          id={`${id}-trame`}
          width={carte.pas}
          height={carte.pas}
          x={-demi}
          y={-demi}
          patternUnits="userSpaceOnUse"
        >
          <circle class="dessin-trame" cx={demi} cy={demi} r={carte.rayon}></circle>
        </pattern>
        <clipPath id={`${id}-pays`}>
          <polygon points={carte.contour}></polygon>
        </clipPath>
      </defs>
      <rect
        x={x0}
        y={y0}
        width={largeur}
        height={hauteur}
        fill={`url(#${id}-trame)`}
        clip-path={`url(#${id}-pays)`}
      ></rect>
      {carte.points.map((p) => (
        <circle class="dessin-ecoles" cx={p.x} cy={p.y} r={p.r} />
      ))}
      {seul && carte.villes.map((v) => <circle class="dessin-halo" cx={v.x} cy={v.y} r="20" />)}
    </svg>
    {/* Retours du fondateur (26/11) : sur l'accueil, un cercle part de chaque ville, comme sur la planche, pour dire que
        l'annuaire vit. Un battement régulier mais espacé : une vague d'une ville à l'autre, puis le calme. */}
    {!seul &&
      carte.villes.map((v, i) => (
        <span
          class="dessin-pouls"
          aria-hidden="true"
          style={`left: ${v.gauche}%; top: ${v.haut}%; --retard: ${0.6 + Math.min(i, 5) * 0.5}s`}
        />
      ))}
    {/* L'étiquette : le nom et le nombre, sans cadre ni date (la date est dite une fois, dans la légende). */}
    {!seul &&
      carte.villes.map((v) => (
        <a
          class={`dessin-ville dessin-${v.place}`}
          href={v.lien}
          style={`left: ${v.gauche}%; top: ${v.haut}%`}
        >
          <b>{v.nom}</b>
          <span>{compterEcoles(v.total)}</span>
        </a>
      ))}
    {!seul && (
      <img
        class="dessin-famille"
        src="/dessins/accueil-famille.svg"
        alt=""
        width="252"
        height="300"
        decoding="async"
      />
    )}
  </div>
  <figcaption class="dessin-legende">
    <span class="dessin-pastille" aria-hidden="true"></span>
    <span>
      Un point jaune&nbsp;: au moins une école y a sa fiche.
      {!seul && <span class="dessin-jour">Nombres au {jour}.</span>}
    </span>
  </figcaption>
</figure>

<style>
  .dessin-congo {
    position: relative;
    margin: 0;
  }
  .dessin-cadre {
    position: relative;
    width: 100%;
  }
  .dessin-carte {
    display: block;
    width: 100%;
    height: 100%;
  }
  .dessin-trame {
    fill: var(--vert-pale);
    fill-opacity: 0.42;
  }
  .dessin-ecoles {
    fill: var(--accent);
  }
  .dessin-halo {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-dasharray: 2 5;
    stroke-linecap: round;
  }
  /*
   * Le cercle d'une ville (planche « Accueil », `pouls`) : posé, il entoure le point. Fondateur, 26/11 : un battement
   * continu, régulier et espacé, pour un côté vivant, pas pour appeler l'œil. Toutes les 8 s, une onde part de chaque ville,
   * l'une après l'autre (une vague d'une demi-seconde par ville), dure 2 s, puis 6 s de calme. Le cercle posé (`::before`)
   * ne bouge pas ; l'onde est un second cercle (`::after`). Opacité et échelle seulement : le navigateur l'anime sans
   * repeindre la page. Sans mouvement demandé, aucune onde.
   */
  .dessin-pouls {
    position: absolute;
    width: 22px;
    height: 22px;
    margin: -11px 0 0 -11px;
    pointer-events: none;
  }
  .dessin-pouls::before,
  .dessin-pouls::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 2px solid var(--accent);
    border-radius: 50%;
  }
  .dessin-pouls::before {
    opacity: 0.55;
  }
  .dessin-pouls::after {
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .dessin-pouls::after {
      animation: dessin-pouls 8s ease-out var(--retard, 0s) infinite;
    }
  }
  @keyframes dessin-pouls {
    0% {
      opacity: 1;
      transform: scale(0.6);
    }
    25%,
    100% {
      opacity: 0;
      transform: scale(2.4);
    }
  }
  /* L'étiquette d'une ville : un lien de 44 px au moins, posé à côté de son point, jamais dessus. Retours du fondateur
     (26/11) : sans cadre ni date, le nom et le nombre se posent sur le dessin ; un liseré du vert du fond les détache des
     points de la trame. */
  .dessin-ville {
    position: absolute;
    z-index: 1;
    display: grid;
    align-content: center;
    min-height: var(--cible-min);
    padding: 2px var(--espace-1);
    border-radius: var(--rayon-s);
    color: var(--texte-sur-marque);
    line-height: 1.2;
    text-decoration: none;
    text-shadow:
      0 0 3px var(--marque-appuyee),
      0 0 6px var(--marque-appuyee);
    white-space: nowrap;
  }
  .dessin-ville b {
    font-family: var(--police-interface);
    font-size: 0.9375rem;
  }
  .dessin-ville span {
    color: var(--vert-pale);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .dessin-jour {
    display: block;
  }
  @media (hover: hover) {
    .dessin-ville:hover b {
      text-decoration: underline;
    }
  }
  /* L'appui (lot A, 26/11) : l'étiquette s'éclaircit d'un vert, la crème reste lisible (7,2:1). */
  .dessin-ville {
    -webkit-tap-highlight-color: transparent;
  }
  .dessin-ville:active {
    background: var(--marque);
  }
  .dessin-ville:active b {
    text-decoration: underline;
  }
  .dessin-ville:focus-visible {
    outline: var(--epaisseur-focus) solid var(--focus);
    outline-offset: 2px;
  }
  .dessin-droite-milieu {
    transform: translate(14px, -50%);
  }
  .dessin-gauche-milieu {
    transform: translate(calc(-100% - 14px), -50%);
  }
  .dessin-droite-haut {
    transform: translate(6px, calc(-100% - 10px));
  }
  .dessin-gauche-haut {
    transform: translate(calc(-100% - 6px), calc(-100% - 10px));
  }
  .dessin-droite-bas {
    transform: translate(6px, 10px);
  }
  .dessin-gauche-bas {
    transform: translate(calc(-100% - 6px), 10px);
  }
  .dessin-famille {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 38%;
    height: auto;
    pointer-events: none;
  }
  .dessin-legende {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    gap: var(--espace-2);
    max-width: 48%;
    color: var(--vert-pale);
    font-size: var(--taille-secondaire);
    line-height: 1.35;
  }
  /* Lot 4 : le dessin seul, sur la pierre : une trame lisible, la légende en texte doux, sous le pays. */
  .dessin-seul .dessin-trame {
    fill: var(--marque);
    fill-opacity: 0.22;
  }
  .dessin-seul .dessin-legende {
    position: static;
    max-width: none;
    margin-top: var(--espace-3);
    color: var(--texte-doux);
  }
  .dessin-pastille {
    flex: none;
    width: 12px;
    height: 12px;
    margin-top: 3px;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
