---
// La carte interactive, sur l'accueil (aperçu) et sur `/carte/` (l'application) : une seule carte sur tout le site (ticket
// 146). Tant qu'elle se charge, le signe d'attente (les trois barres du logo) ; l'ancien dessin (`ApercuCarte`) ne sert plus
// que sans JavaScript, sans WebGL2 ou après un échec.
import ApercuCarte from './ApercuCarte.astro';
import Marque from './Marque.astro';
import type { donneesDeLaCarte, arrondissementDuRepli } from '../modele/carte/instantane';
interface Props {
  donnees: ReturnType<typeof donneesDeLaCarte>;
  repli: ReturnType<typeof arrondissementDuRepli>;
  application?: boolean;
  /** Le lien WhatsApp de NTanova, avec le message « une école manque » : rien quand le numéro n'est pas configuré. */
  whatsapp?: string | null;
}
const {
  donnees: { zones, ecoles, cadre },
  repli,
  application = false,
  whatsapp = null,
} = Astro.props;
// La valeur est la lettre du cycle (celle de l'épingle), puis le mot de la puce, puis les mots complets en infobulle.
const cycles = [
  ['M', 'Maternelle', 'Crèche et maternelle'],
  ['P', 'Primaire', 'Primaire'],
  ['C', 'Collège', 'Collège'],
  ['L', 'Lycée', 'Lycée'],
  ['T', 'Technique', 'Technique et professionnel'],
  ['S', 'Supérieur', 'Supérieur et formation'],
] as const;
---

<section
  class:list={['explorateur', { 'explorateur-app': application }]}
  data-carte-page={application ? 'carte' : 'accueil'}
>
  <div
    id="carte"
    class="carte-interactive"
    data-etat="repli"
    data-boite={JSON.stringify(cadre.boite)}
    role="region"
    aria-label="Carte interactive des écoles"
  >
    {/* Le signe d'attente (canevas « Chargement », 08/11/2026) : voir le CSS plus bas. Sur l'accueil d'un téléphone qui
        économise ses données, les barres immobiles disent que la carte attend l'appui. Sans JavaScript : le dessin. */}
    <div class="carte-attente" role="status" aria-live="polite">
      <Marque taille={49} />
      <p class="attente-chargement">Chargement de la carte…</p>
      <p class="attente-lente">La connexion est lente.</p>
      <p class="attente-sortie">
        La carte arrive. En attendant&nbsp;: <a href="/ecoles/">voir la liste des écoles</a>
      </p>
      <p class="attente-appui">La carte se charge à la demande, pour ménager vos données.</p>
    </div>
    <div class="carte-repli">
      {repli.tete ? (
        <ApercuCarte arrondissement={repli.tete} ecoles={repli.ecoles} lienCarte="/carte/" />
      ) : (
        <p>La carte s’affiche ici quand elle est chargée.</p>
      )}
    </div>
    <div id="carte-toile" class="carte-toile"></div>
  </div>
  <button type="button" class="bouton activer-carte" hidden>
    Explorer la carte interactive
  </button>
  <p id="carte-note" class="carte-note" role="status"></p>
  {application && (
    <>
      <div class="rangee-puces" role="group" aria-label="Niveau des écoles" hidden>
        <button type="button" class="pastille-choix" data-cycle="" aria-pressed="true">
          Tous
        </button>
        {cycles.map(([lettre, mot, complet]) => (
          <button
            type="button"
            class="pastille-choix avec-disque"
            data-cycle={lettre}
            aria-pressed="false"
            title={complet}
          >
            <span class={`disque c-${lettre}`} aria-hidden="true">
              {lettre}
            </span>
            {mot}
          </button>
        ))}
      </div>
      <button type="button" class="rond" data-position aria-label="Ma position" hidden>
        <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M5 12a7 7 0 1 0 14 0a7 7 0 1 0-14 0" />
          <path d="M9.8 12a2.2 2.2 0 1 0 4.4 0a2.2 2.2 0 1 0-4.4 0" />
          <path d="M12 2v3M12 19v3M2 12h3M19 12h3" />
        </svg>
      </button>
      <aside class="panneau-carte" aria-label="Écoles et recherche" data-hauteur="petit">
        <button
          type="button"
          class="poignee-tiroir"
          data-poignee
          aria-controls="contenu-tiroir"
          aria-expanded="false"
          hidden
        >
          <span class="visuellement-cache">Voir les écoles</span>
          <i aria-hidden="true"></i>
        </button>
        <form role="search" aria-label="Chercher sur la carte" class="recherche-carte" hidden>
          <svg class="ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4 11a7 7 0 1 0 14 0a7 7 0 1 0-14 0" />
            <path d="M20 20l-4-4" />
          </svg>
          <label for="recherche-carte" class="visuellement-cache">
            Quelle école, où ?
          </label>
          <input
            id="recherche-carte"
            name="q"
            type="search"
            placeholder="Nom de l’école, quartier ou ville"
            autocomplete="off"
          />
          <button type="submit" class="valider" aria-label="Chercher">
            <svg class="ico ico-s" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </button>
        </form>
        <div id="contenu-tiroir">
          <p data-zone class="contexte"></p>
          <div data-selection></div>
          {/* « Voir en liste » : la bascule de la carte vers la liste, dans le tiroir (canevas, ticket 146). */}
          <div class="tete-liste">
            <p data-compte role="status" aria-live="polite" class="titre-liste"></p>
            <a class="voir-en-liste" href="/ecoles/">
              Voir en liste
            </a>
          </div>
          <ul data-resultats class="resultats-carte"></ul>
          <div class="ecole-manque" hidden>
            <h2>Une école manque ?</h2>
            <p>Signalez-nous un établissement à ajouter.</p>
            {whatsapp && (
              <a class="bouton" href={whatsapp} target="_blank" rel="noopener">
                <svg class="ico ico-s" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path d="M21 12a8.5 8.5 0 0 1-12.5 7.5L3 21l1.6-5A8.5 8.5 0 1 1 21 12z" />
                </svg>
                Écrire sur WhatsApp
              </a>
            )}
            <a class="lien-carte" href="/ecoles/">
              Chercher dans toutes les écoles
            </a>
          </div>
          <div class="listes-repli">
            <h2>Les zones</h2>
            <ul>
              {zones.features
                .filter((z) => z.properties.genre === 'zone')
                .map((z) => (
                  <li>
                    <a href={z.properties.lien}>{z.properties.nom}</a>
                  </li>
                ))}
            </ul>
            <h2>Les écoles sur la carte ({ecoles.features.length})</h2>
            <ul>
              {ecoles.features.map((e) => (
                <li>
                  <a href={e.properties.lien}>{e.properties.nom}</a> · {e.properties.preuveTexte}
                </li>
              ))}
            </ul>
          </div>
          <p class="carte-liens">
            <a href="/ecoles/">Toutes les écoles</a> ·{' '}
            <a href="/methode/">Comment les fiches sont tenues</a> ·{' '}
            <a href="/pour-les-ecoles/">Pour les écoles</a>
          </p>
          <p class="confidentialite-position" hidden>
            NTanova ne conserve pas votre position. Elle sert à vous situer sur la carte. Le fond de
            carte reçoit des demandes de tuiles correspondant à la zone consultée.
          </p>
        </div>
      </aside>
    </>
  )}
</section>
<style is:global>
  @import './carte-pieces.css';
  .explorateur {
    position: relative;
  }
  .carte-interactive {
    position: relative;
    height: min(70dvh, 42rem);
    min-height: 22rem;
    overflow: hidden;
    border: 1px solid var(--trait);
    border-radius: var(--rayon-s);
    background: var(--carte-fond);
  }
  /* Le signe d'attente (canevas « Chargement », 08/11/2026, ticket 146). Il vit dans le CSS pour paraître même avant que le
     script n'arrive : rien de 0 à 0,4 s, puis les barres et la phrase ; à 10 s, « La connexion est lente. » et la sortie vers
     la liste. Le chargeur ne fait que le garder au moins 0,5 s (`data-signe="garde"`) et dire quand la carte attend
     l'appui (`data-attente="appui"`) ou, sur l'accueil, l'arrivée de la carte à l'écran (`data-attente="vue"` : le compte
     ne part qu'à ce moment). Sans JavaScript, il ne paraît jamais : le dessin et les listes sont là. */
  .carte-attente {
    position: absolute;
    inset: 0;
    /* Sur la carte, sous les puces (3) et le tiroir (4) : le signe ne cache jamais ce qui sert déjà. */
    z-index: 2;
    display: grid;
    grid-template-areas: 'signe' 'phrase' 'sortie';
    align-content: center;
    justify-items: center;
    gap: var(--espace-2);
    padding: var(--espace-4);
    background: var(--carte-fond);
    color: var(--texte-doux);
    text-align: center;
    pointer-events: none;
    visibility: hidden;
  }
  .carte-attente .marque {
    grid-area: signe;
  }
  .carte-attente p {
    grid-area: phrase;
    margin: 0;
    font-family: var(--police-titre);
    font-weight: 700;
  }
  .carte-attente .attente-sortie {
    grid-area: sortie;
    font-family: var(--police-texte);
    font-weight: 400;
  }
  .carte-attente a {
    color: var(--marque);
    font-weight: 700;
    pointer-events: auto;
  }
  .carte-attente :is(.attente-lente, .attente-sortie) {
    visibility: hidden;
  }
  .carte-attente .attente-appui {
    display: none;
  }
  @keyframes attente-montrer {
    to {
      visibility: visible;
    }
  }
  @keyframes attente-cacher {
    to {
      visibility: hidden;
    }
  }
  @media (scripting: enabled) {
    .carte-interactive:is([data-etat='repli'], [data-etat='chargement']):not([data-attente])
      .carte-attente {
      animation: attente-montrer 0s linear 0.4s forwards;
    }
    .carte-interactive:is([data-etat='repli'], [data-etat='chargement']):not([data-attente])
      .attente-chargement {
      animation: attente-cacher 0s linear 10s forwards;
    }
    .carte-interactive:is([data-etat='repli'], [data-etat='chargement']):not([data-attente])
      :is(.attente-lente, .attente-sortie) {
      animation: attente-montrer 0s linear 10s forwards;
    }
  }
  /* La carte est prête juste après la venue du signe : il reste encore un peu, pour ne pas clignoter. */
  .carte-interactive[data-signe='garde'] .carte-attente {
    visibility: visible;
  }
  /* L'accueil d'un téléphone qui économise ses données : la carte attend l'appui, les barres immobiles le disent. */
  .carte-interactive[data-attente='appui'] .carte-attente {
    position: static;
    padding-block: var(--espace-6);
    visibility: visible;
  }
  .carte-interactive[data-attente='appui']
    :is(.attente-chargement, .attente-lente, .attente-sortie) {
    display: none;
  }
  .carte-interactive[data-attente='appui'] .attente-appui {
    display: block;
    font-family: var(--police-texte);
    font-weight: 400;
  }
  /* Les barres se lèvent tour à tour, depuis leur base : de la moitié à toute leur hauteur, en 1,2 s, à 0,15 s d'écart.
     Immobiles quand la carte attend l'appui, ou quand le téléphone demande moins de mouvement. */
  @keyframes lever-la-barre {
    0%,
    100% {
      transform: scaleY(0.5);
    }
    40% {
      transform: scaleY(1);
    }
    70% {
      transform: scaleY(0.78);
    }
  }
  .carte-attente .marque path {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  .carte-attente .marque .barre-jaune {
    --decalage: 0.15s;
  }
  .carte-attente .marque .barre-rouge {
    --decalage: 0.3s;
  }
  /* Les barres ne bougent que pendant l'attente : cachées, elles ne coûtent rien au téléphone. */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .carte-interactive:is([data-etat='repli'], [data-etat='chargement'], [data-signe='garde']):not(
        [data-attente]
      )
      .marque
      path {
      animation: lever-la-barre 1.2s ease-in-out var(--decalage, 0s) infinite;
    }
  }
  /* Dès le premier rendu HTML, avant même la réception du chargeur : avec JavaScript, l'ancien dessin ne paraît pas pendant
     l'attente (il « clignotait » avant la carte). Sans JavaScript, il reste ; l'absence de WebGL2 ou un échec le rétablit. */
  @media (scripting: enabled) {
    .carte-interactive:is([data-etat='repli'], [data-etat='chargement']) .carte-repli {
      visibility: hidden;
    }
  }
  .carte-interactive[data-attente='appui'] .carte-repli {
    display: none;
  }
  .carte-repli {
    position: absolute;
    inset: 0;
    overflow: auto;
    padding: var(--espace-3);
  }
  .carte-interactive .carte-toile {
    pointer-events: none;
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  [data-etat='prete'] .carte-toile {
    pointer-events: auto;
    opacity: 1;
  }
  [data-etat='prete'] .carte-repli {
    display: none;
  }
  /* Sur l'accueil, quand la carte ne vient pas d'office (économiseur de données, connexion lente, pas de WebGL2, échec), le
     cadre a la hauteur de ce qu'il montre, pas celle d'une carte qui n'est pas là. */
  .explorateur:not(.explorateur-app) .carte-interactive[data-attente='appui'][data-etat='repli'],
  .explorateur:not(.explorateur-app) .carte-interactive[data-etat='repli-sans-webgl2'],
  .explorateur:not(.explorateur-app) .carte-interactive[data-etat='echec'] {
    height: auto;
    min-height: 0;
  }
  .explorateur:not(.explorateur-app)
    .carte-interactive[data-attente='appui'][data-etat='repli']
    .carte-repli,
  .explorateur:not(.explorateur-app) .carte-interactive[data-etat='repli-sans-webgl2'] .carte-repli,
  .explorateur:not(.explorateur-app) .carte-interactive[data-etat='echec'] .carte-repli {
    position: static;
    overflow: visible;
  }
  .carte-note {
    color: var(--texte-doux);
    margin: var(--espace-2) 0;
  }
  .explorateur [hidden] {
    display: none !important;
  }
  /* Le panneau et le tiroir */
  .panneau-carte {
    background: var(--fond-releve);
    padding: var(--espace-3);
  }
  .panneau-carte a {
    text-underline-offset: 3px;
  }
  /* Le compte de la vue et « Voir en liste », sur une ligne. */
  .tete-liste {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--espace-1) var(--espace-3);
    margin: 0 0 var(--espace-3);
  }
  .tete-liste:has(.titre-liste:empty) {
    justify-content: flex-end;
  }
  .voir-en-liste {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
    color: var(--marque);
    font-weight: 700;
  }
  .titre-liste {
    margin: 0;
    font-family: var(--police-titre);
    font-size: var(--taille-intertitre);
    font-weight: 700;
    line-height: var(--interligne-titre);
  }
  .contexte {
    margin: 0 0 var(--espace-3);
    color: var(--texte-doux);
    font-size: var(--taille-secondaire);
  }
  .resultats-carte {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--espace-3);
  }
  .resultats-carte .ligne-vide {
    color: var(--texte-doux);
  }
  .ecole-manque {
    display: flex;
    flex-direction: column;
    gap: var(--espace-3);
    margin-top: var(--espace-4);
    padding: var(--espace-4);
    border-radius: var(--rayon-m);
    background: var(--fond-bande);
  }
  .ecole-manque h2 {
    margin: 0;
    font-size: var(--taille-courante);
  }
  .ecole-manque p {
    margin: 0;
    color: var(--texte-doux);
    font-size: var(--taille-secondaire);
  }
  .lien-carte {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
    font-weight: 700;
  }
  .recherche-carte {
    display: flex;
    align-items: center;
    gap: var(--espace-2);
    min-height: var(--hauteur-champ);
    /* Le haut du contour de focus (3 px, à 2 px du champ) ne passe pas sous la poignée collée en haut du tiroir. */
    margin: var(--espace-2) 0 var(--espace-3);
    padding: var(--espace-1) var(--espace-1) var(--espace-1) var(--espace-4);
    border: 2px solid var(--trait-fort);
    border-radius: var(--rayon-pilule);
    background: var(--fond-releve);
    color: var(--texte-doux);
  }
  .recherche-carte:focus-within {
    outline: var(--epaisseur-focus) solid var(--focus);
    outline-offset: 2px;
  }
  .recherche-carte input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--texte);
    font: inherit;
  }
  .recherche-carte input::placeholder {
    color: var(--texte-doux);
    opacity: 1;
  }
  .recherche-carte .valider {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: var(--cible-min);
    height: var(--cible-min);
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--marque);
    color: var(--texte-sur-marque);
    cursor: pointer;
  }
  .panneau-carte .carte-liens {
    margin-top: var(--espace-5);
  }
  .poignee-tiroir {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: var(--cible-min);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    touch-action: none;
  }
  .poignee-tiroir i {
    display: block;
    width: 44px;
    height: 5px;
    border-radius: 3px;
    background: var(--trait-fort);
  }
  /* La rangée défile avec le doigt, de gauche à droite, jusqu'à la dernière puce. Elle reçoit le toucher (un
     « pointer-events: none » sur un conteneur qui défile l'empêche de défiler sur iPhone) et ne laisse passer
     à la page que le geste horizontal : la carte, elle, n'est pas dessous mais à côté, hors de cette bande. */
  .rangee-puces {
    display: flex;
    gap: var(--espace-2);
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    touch-action: pan-x;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .rangee-puces::-webkit-scrollbar {
    display: none;
  }
  .rangee-puces .pastille-choix {
    flex: none;
    gap: var(--espace-2);
    padding-inline: var(--espace-3);
    box-shadow: var(--ombre-flottante);
  }
  .explorateur .rangee-puces .pastille-choix.avec-disque {
    padding-left: var(--espace-1);
  }
  .explorateur-app .maplibregl-ctrl-group {
    border-radius: 12px;
    box-shadow: var(--ombre-flottante);
  }
  /* Le zoom de MapLibre se dessine à 29 px : c'est une cible de doigt, elle en mesure 44 (accueil et /carte/). */
  .explorateur .maplibregl-ctrl-group button {
    width: var(--cible-min);
    height: var(--cible-min);
  }
  /* --- La page carte active : tiroir sur téléphone, panneau sur ordinateur ---
     Tout tient dans l'écran : seuls la carte, les puces et le tiroir bougent. Sur iPhone, `100vh` est la hauteur SANS les
     barres du navigateur et `100dvh` celle qu'on voit : le corps de la page prenait l'une (`base.css`) et la carte l'autre,
     la page débordait et défilait, et l'en-tête comme le haut des puces passaient sous la barre. Le corps prend donc
     `100dvh`, ne défile pas, et la carte remplit ce que l'en-tête lui laisse. */
  html:has(.explorateur-app[data-active]) {
    overflow: hidden;
    overscroll-behavior: none;
  }
  body:has(.explorateur-app[data-active]) {
    display: flex;
    flex-direction: column;
    height: 100dvh;
    min-height: 0;
    overflow: hidden;
    overscroll-behavior: none;
  }
  body:has(.explorateur-app[data-active]) .contenu,
  body:has(.explorateur-app[data-active]) .page-exploration {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
  }
  .explorateur-app[data-active] {
    flex: 1;
    min-height: 0;
    /* La hauteur du tiroir, mesurée par le script (`--tiroir-h`) ; en attendant, une valeur proche. */
    --tiroir-h: 13.5rem;
  }
  .explorateur-app[data-active] .carte-interactive {
    position: absolute;
    inset: 0;
    height: auto;
    min-height: 0;
    border-radius: 0;
  }
  /* Le clavier est ouvert : la carte et le tiroir prennent exactement la partie visible de l'écran, à l'endroit où le
     navigateur l'a fait glisser (`--vv-haut`, `--vv-hauteur`, posés par le script). Rien ne saute, rien ne passe dessous. */
  .explorateur-app[data-active][data-clavier] {
    position: fixed;
    z-index: 20;
    top: var(--vv-haut, 0);
    left: 0;
    right: 0;
    height: var(--vv-hauteur, 100dvh);
    flex: none;
  }
  .explorateur-app[data-active] .panneau-carte {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 4;
    max-height: 88%;
    /* Bas : la hauteur de son contenu (poignée, recherche, texte d'aide, légende). */
    height: auto;
    padding: 0 var(--espace-4) calc(var(--espace-3) + env(safe-area-inset-bottom, 0px));
    border-radius: var(--rayon-l) var(--rayon-l) 0 0;
    box-shadow: var(--ombre-tiroir);
    overflow: auto;
    overscroll-behavior: contain;
  }
  .explorateur-app[data-active] .panneau-carte[data-hauteur='moyen'] {
    height: 48%;
    padding-bottom: calc(2.5rem + env(safe-area-inset-bottom, 0px));
  }
  .explorateur-app[data-active] .panneau-carte[data-hauteur='grand'] {
    height: 88%;
    padding-bottom: calc(2.5rem + env(safe-area-inset-bottom, 0px));
  }
  /* Sur téléphone, le tiroir bas ne montre que de quoi chercher et se repérer (recherche, texte d'aide, légende) : la
     liste attend derrière la poignée, qui l'ouvre. Sans cela, sa hauteur « selon le contenu » compterait toute la liste. */
  @media (max-width: 63.99rem) {
    .explorateur-app[data-active]
      .panneau-carte[data-hauteur='petit']
      :is(.resultats-carte, .ecole-manque, .carte-liens, .confidentialite-position) {
      display: none;
    }
  }
  /* Une école choisie : le tiroir prend la hauteur de sa fiche, sans jamais cacher toute la carte. */
  .explorateur-app[data-active] .panneau-carte:has(.carte-apercu)[data-hauteur='moyen'] {
    height: auto;
  }
  .explorateur-app[data-active] .poignee-tiroir {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--fond-releve);
  }
  .explorateur-app[data-active] .rangee-puces {
    position: absolute;
    top: var(--espace-2);
    left: 0;
    right: 0;
    z-index: 3;
    padding: var(--espace-1) var(--espace-3) var(--espace-5);
  }
  .explorateur-app[data-active] .rond {
    position: absolute;
    right: var(--espace-3);
    bottom: calc(var(--tiroir-h) + 2.5rem);
    z-index: 3;
  }
  .explorateur-app[data-active][data-hauteur='grand'] .rond,
  .explorateur-app[data-active]:has(.carte-apercu) .rond {
    display: none !important;
  }
  /* Les commandes de MapLibre se rangent sous les puces. */
  .explorateur-app[data-active] .maplibregl-ctrl-top-right {
    top: 3.5rem;
  }
  /* L'attribution d'OpenStreetMap (celle de MapLibre : une seule) reste écrite, jamais repliée (ODbL), et se pose juste
     au-dessus du tiroir : elle ne passe jamais dessus. */
  .explorateur-app .maplibregl-ctrl-attrib {
    border-radius: var(--rayon-s) 0 0 0;
    background: var(--fond-releve);
    font-size: var(--taille-mention);
  }
  .explorateur-app .maplibregl-ctrl-attrib a {
    color: var(--texte);
  }
  .explorateur-app[data-active] .maplibregl-ctrl-bottom-right {
    bottom: var(--tiroir-h);
  }
  .explorateur-app[data-active] .listes-repli {
    display: none;
  }
  .explorateur-app[data-active] .carte-note:not(:empty) {
    position: absolute;
    top: 4.5rem;
    left: var(--espace-3);
    right: 4.5rem;
    z-index: 3;
    padding: var(--espace-2) var(--espace-3);
    border-radius: var(--rayon-s);
    background: var(--fond-releve);
    box-shadow: var(--ombre-flottante);
  }
  .page-exploration {
    padding: 0;
  }
  .page-exploration > h1 {
    font-size: var(--taille-courante);
    margin: var(--espace-2) var(--espace-3);
  }
  .page-exploration:has([data-active]) > h1 {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  body:has(.explorateur-app[data-active]) .pied {
    display: none;
  }
  /* L'aperçu ouvert montre sa fiche : la recherche, la zone et la liste attendent derrière le retour. */
  .panneau-carte:has(.carte-apercu) .recherche-carte,
  .panneau-carte:has(.carte-apercu) [data-zone],
  .panneau-carte:has(.carte-apercu) .tete-liste,
  .panneau-carte:has(.carte-apercu) .resultats-carte,
  .panneau-carte:has(.carte-apercu) .ecole-manque {
    display: none;
  }
  .explorateur-app .apercu-retour {
    display: none;
  }
  @media (min-width: 64rem) {
    .explorateur-app[data-active] .panneau-carte {
      top: 0;
      width: 25rem;
      max-height: 100%;
      height: 100% !important;
      right: auto;
      padding-top: var(--espace-5);
      border-radius: 0;
      box-shadow: var(--ombre-panneau);
    }
    .explorateur-app[data-active] .poignee-tiroir {
      display: none;
    }
    .explorateur-app[data-active] .rangee-puces {
      left: calc(25rem + var(--espace-4));
      right: 4.5rem;
      padding-left: 0;
    }
    .explorateur-app[data-active] .rond {
      bottom: 3rem;
      right: var(--espace-4);
    }
    .explorateur-app[data-active] .maplibregl-ctrl-bottom-right {
      bottom: 0;
    }
    .explorateur-app[data-active] .carte-note:not(:empty) {
      left: calc(25rem + var(--espace-4));
      right: 4.5rem;
    }
    .explorateur-app[data-active]:has(.carte-apercu) .rond,
    .explorateur-app[data-active][data-hauteur='grand'] .rond {
      display: flex !important;
    }
    .explorateur-app .apercu-retour {
      display: inline-flex;
    }
    .explorateur-app .carte-apercu .apercu-fermer {
      display: none;
    }
  }
</style>

