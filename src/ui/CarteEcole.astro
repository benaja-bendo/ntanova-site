---
// La carte d'une école, un seul composant (lot 4, décision du fondateur du 16/11/2026 ; planches de la version 44 et carte
// « sp-cartes-ecoles » de la version 46) : l'accueil (« Vues sur place récemment »), « Écoles proches » sur la fiche, et la
// liste du lot 4 bis. La vignette (photo de couverture, sinon d'enseigne, sinon le fond pierre et le rond), le nom, les
// niveaux, le lieu, la distance quand on la connaît, puis la preuve la plus forte, datée. Chaque ligne n'existe que si sa
// donnée existe. Aucun JavaScript.
//
// - `colonne` : la vignette en haut (accueil) ;
// - `ligne` : la vignette carrée à gauche sur téléphone, en haut à partir de 48 rem (« Écoles proches », liste).
import { distanceCourte } from '../modele/fiche-mince';
import { provenanceDe } from '../modele/libelles';
import { ligneDeEcole, niveauxEnMots } from '../modele/ligne-ecole';
import { dateCourte } from '../modele/pointe-noire';
import type { EcolePubliee } from '../modele/ports';
import Icone from './Icone.astro';
import VignetteEcole from './VignetteEcole.astro';

interface Props {
  ecole: EcolePubliee;
  forme?: 'colonne' | 'ligne';
  /** La distance à un point (la fiche ouverte, la position donnée), en mètres. */
  distanceM?: number | null;
}
const { ecole: e, forme = 'colonne', distanceM = null } = Astro.props;
const ligne = ligneDeEcole(e);
const confirmee = provenanceDe(e) === 'verifiee';
const date = confirmee ? e.verifieeLe : e.releveeLe;
const niveaux = niveauxEnMots(e.niveaux);
// La date ne se coupe pas : une preuve longue passe à la ligne avant elle (« … direction · » puis « 4 nov. 2026 »).
const preuve = `${confirmee ? 'Confirmée par la direction' : 'Vue sur place'}${date ? ` · ${dateCourte(date).replace(/ /g, ' ')}` : ''}`;
const avecPreuve = confirmee || e.releveeLe !== null;
---

<a class:list={['carte-ecole', `carte-ecole-${forme}`]} href={ligne.url}>
  <VignetteEcole ecole={e} forme={forme === 'ligne' ? 'adaptee' : 'large'} />
  <span class="carte-ecole-texte">
    <span class="carte-ecole-nom">{e.nom}</span>
    {niveaux && (
      <span class="carte-ecole-niveaux">
        <span class="carte-ecole-puces" aria-hidden="true">
          {ligne.lettres.map((l) => (
            <span class={`disque disque-s c-${l}`}>{l}</span>
          ))}
        </span>
        {niveaux}
      </span>
    )}
    <span class="carte-ecole-lieu">
      <b>{ligne.lieu.fort}</b>
      {ligne.lieu.reste && forme === 'colonne' && ` · ${ligne.lieu.reste}`}
      {distanceM !== null && ` · ${distanceCourte(distanceM)}`}
    </span>
    {avecPreuve && (
      <span class:list={['carte-ecole-preuve', { 'carte-ecole-preuve-confirmee': confirmee }]}>
        <Icone nom={confirmee ? 'bouclier' : 'oeil'} />
        {preuve}
      </span>
    )}
  </span>
  {forme === 'ligne' && (
    <span class="carte-ecole-chevron" aria-hidden="true">
      ›
    </span>
  )}
</a>

<style>
  .carte-ecole {
    display: flex;
    gap: var(--espace-2);
    height: 100%;
    box-sizing: border-box;
    padding: 10px;
    border: 1px solid var(--trait);
    border-radius: var(--rayon-m);
    background: var(--fond-releve);
    color: var(--texte);
    text-decoration: none;
  }
  .carte-ecole-colonne {
    flex-direction: column;
  }
  .carte-ecole-colonne :global(.vignette-ecole) {
    height: 104px;
    aspect-ratio: auto;
  }
  .carte-ecole-ligne {
    align-items: center;
    gap: var(--espace-3);
  }
  .carte-ecole-ligne :global(.vignette-ecole) {
    flex: none;
    width: 64px;
    height: 64px;
  }
  .carte-ecole-texte {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--espace-1);
    min-width: 0;
  }
  .carte-ecole-colonne .carte-ecole-texte {
    gap: var(--espace-2);
  }
  @media (hover: hover) {
    .carte-ecole:hover {
      border-color: var(--marque);
    }
  }
  .carte-ecole-nom {
    font-family: var(--police-titre);
    font-size: var(--taille-courante);
    font-weight: 700;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }
  .carte-ecole-niveaux {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--texte-doux);
    font-size: 0.8125rem;
  }
  .carte-ecole-puces {
    display: inline-flex;
    flex: none;
    gap: 3px;
  }
  .carte-ecole-lieu {
    font-size: var(--taille-secondaire);
  }
  /* La preuve en bas de la carte : alignée d'une carte à l'autre quand un nom prend deux lignes. */
  .carte-ecole-preuve {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 5px;
    margin-top: auto;
    padding: 2px var(--espace-2);
    border: 2px solid var(--preuve-terrain);
    border-radius: var(--rayon-pilule);
    color: var(--marque-appuyee);
    font-family: var(--police-interface);
    font-size: var(--taille-mention);
    font-weight: 700;
  }
  .carte-ecole-preuve-confirmee {
    background: var(--preuve-direction);
    color: var(--preuve-direction-texte);
  }
  .carte-ecole-preuve :global(svg) {
    width: 13px;
    height: 13px;
  }
  /* À partir de 48 rem, la carte en ligne passe en colonne (trois par rangée), comme sa vignette. */
  @media (min-width: 48rem) {
    .carte-ecole-ligne {
      flex-direction: column;
      align-items: stretch;
    }
    .carte-ecole-ligne :global(.vignette-ecole) {
      width: 100%;
      height: 104px;
    }
    .carte-ecole-ligne .carte-ecole-texte {
      gap: var(--espace-2);
    }
    .carte-ecole-chevron {
      display: none;
    }
  }
  .carte-ecole-chevron {
    flex: none;
    color: var(--texte-doux);
    font-size: 1.5rem;
    line-height: 1;
  }
</style>
