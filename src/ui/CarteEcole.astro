---
// La carte d'une école, un seul composant (lot 4, décision du fondateur du 16/11/2026) : l'accueil (« Vues sur place
// récemment »), « Écoles proches » sur la fiche, la liste et la vue Carte de « Les écoles ». Depuis le lot 4 bis, son HTML
// s'écrit une seule fois (`modele/carte-ecole.ts`) : la page construite et le navigateur posent exactement le même. Aucun
// JavaScript ici.
import '../ui/carte-ecole.css';
import { htmlCarteEcole } from '../modele/carte-ecole';
import type { EcolePubliee } from '../modele/ports';
import { ligneDe } from '../modele/recherche';

interface Props {
  ecole: EcolePubliee;
  forme?: 'colonne' | 'ligne';
  /** La distance à un point (la fiche ouverte, la position donnée), en mètres. */
  distanceM?: number | null;
}
const { ecole, forme = 'colonne', distanceM = null } = Astro.props;
---

<Fragment set:html={htmlCarteEcole(ligneDe(ecole), { forme, distanceM })} />
