---
// La page d'un lieu (pays, département, ville, arrondissement, quartier) : les lieux qu'il contient, avec leur nombre
// d'écoles, puis les écoles qui sont directement chez lui. Une vraie page, écrite à la construction et listée dans
// `sitemap.xml` dès qu'elle a une école (décision du fondateur du 08/11/2026). Aucun JavaScript.
//
// Ticket 146 : la page n'a plus de plan dessiné ni d'état de déploiement (« relevé en cours », « programmé ») ; la bascule
// mène à la seule carte du site, cadrée sur le lieu.
import { lienCarteDuLieu } from '../modele/carte/navigation';
import { vuesSurPlace } from '../modele/carte/plan';
import {
  compterEcoles,
  ecolesSous,
  lienDivision,
  lieuAvecPreposition,
  nomAffiche,
  NOM_NIVEAU,
  phraseDeCompte,
  type PageDivision,
} from '../modele/geo-divisions';
import BasculeVue from './BasculeVue.astro';
import EtatVide from './EtatVide.astro';
import ListeEcoles from './ListeEcoles.astro';

interface Props {
  page: PageDivision;
  /** « Une école manque ? » : le lien WhatsApp, s'il est configuré. */
  manque: string | null;
}
const { page, manque } = Astro.props;

const sous = ecolesSous(page);
const verifiees = sous.filter((e) => e.etat === 'verifiee').length;
const vues = vuesSurPlace(sous).length;
const nom = page.division.nom;
const niveau = page.division.niveau;
const genre = NOM_NIVEAU[niveau] ?? 'zone';
const ordinal = page.division.ordinal;
const parent = page.parent;
const lieu = lieuAvecPreposition(nom, niveau);
const detailDeZone = (enfant: PageDivision) => {
  const n = ecolesSous(enfant).length;
  return [
    enfant.division.ordinal ? `Arrondissement ${enfant.division.ordinal}` : null,
    n > 0 ? compterEcoles(n) : 'pas encore d’école publiée',
  ].filter((x): x is string => x !== null);
};
const adresseTexte = page.adresse.join('/');
const carte = lienCarteDuLieu({
  contour: page.division.contour,
  position: page.division.position,
  ecoles: sous,
});
---

<section class="cadre page hub">
  <a class="retour" href={parent ? lienDivision(parent.adresse) : '/ecoles/'}>
    ← {parent ? nomAffiche(parent.division.nom, parent.division.niveau) : 'Les écoles'}
  </a>

  <div class="titre-vue">
    <div>
      <h1>{nomAffiche(nom, niveau)}</h1>
      {niveau > 0 && (
        <p class="texte-doux">
          {ordinal ? `Arrondissement ${ordinal}` : genre.charAt(0).toUpperCase() + genre.slice(1)}
          {page.noms.length > 1 && (
            <>
              {' '}
              · <span>{page.noms.slice(0, -1).join(' › ')}</span>
            </>
          )}
        </p>
      )}
    </div>
    <BasculeVue liste={lienDivision(page.adresse)} carte={carte} actuelle="liste" />
  </div>

  {sous.length > 0 && <p class="compte">{phraseDeCompte(sous.length, vues, verifiees)}</p>}

  {page.enfants.length > 0 && (
    <section aria-label={`Les lieux de ${nom}`}>
      <ul class="zones">
        {page.enfants.map((enfant) => (
          <li>
            <a class="zone" href={lienDivision(enfant.adresse)}>
              <span class="zone-nom">{enfant.division.nom}</span>
              <span class="zone-detail">{detailDeZone(enfant).join(' · ')}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {page.ecoles.length > 0 && (
    <section aria-label={`Les écoles de ${nom}`} class="ecoles-ici">
      {page.enfants.length > 0 && <h2>Les écoles de {nom}</h2>}
      <ListeEcoles ecoles={page.ecoles} />
    </section>
  )}

  {/* Les écoles et le découpage d'abord ; ce qu'on demande aux directions vient après (audit du 05/11/2026, D10). */}
  {sous.length > 0 ? (
    <>
      <p>
        <a class="chercher" href={`/ecoles/?zone=${adresseTexte}`}>
          Chercher une école {lieu}
        </a>
      </p>

      <div class="encadre-pointille">
        <p>Une partie du territoire n’est pas encore relevée.</p>
        {manque && <a href={manque}>Une école manque&nbsp;? Dites-le-nous sur WhatsApp</a>}
        <a class="chercher" href="/pour-les-ecoles/#referencer">
          Ajouter mon école
        </a>
        <p>
          La demande est ouverte partout au Congo-Brazzaville&nbsp;; la publication reste une
          décision de NTanova.
        </p>
      </div>
    </>
  ) : (
    <EtatVide
      titre="Aucune école publiée pour l’instant."
      detail={`Vous connaissez ou vous dirigez une école ${lieu}\u00a0? Écrivez-nous : nous la noterons pour le prochain passage.`}
      actions={[{ texte: 'Voir les écoles déjà publiées', url: '/ecoles/' }]}
      manque={manque ? { texte: 'Une école manque\u00a0? Écrire sur WhatsApp', url: manque } : null}
      etiquette="Aucune école publiée"
    />
  )}
</section>

<style>
  .hub {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--espace-4);
  }
  .titre-vue > div {
    min-width: 0;
    max-width: 100%;
  }
  .hub h1,
  .titre-vue p,
  .zone-nom,
  .zone-detail {
    overflow-wrap: anywhere;
  }
  .hub h1 {
    margin: 0;
    color: var(--marque-appuyee);
    font-family: var(--police-titre);
    font-size: var(--taille-titre-page);
    line-height: var(--interligne-titre);
  }
  .hub h2 {
    margin: 0;
    font-family: var(--police-titre);
    font-size: var(--taille-intertitre);
  }
  .hub p {
    margin: 0;
  }
  .compte {
    font-family: var(--police-titre);
    font-weight: 700;
  }
  /* Les lieux : la même pièce que « Ville par ville » sur la page « Écoles ». */
  .zones {
    display: grid;
    gap: var(--espace-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .zone {
    display: grid;
    gap: var(--espace-1);
    min-height: var(--cible-principale);
    padding: var(--espace-3) var(--espace-4);
    border: 2px solid var(--trait);
    border-radius: var(--rayon-m);
    background: var(--fond-releve);
    color: var(--texte);
    text-decoration: none;
  }
  .zone:hover {
    border-color: var(--marque);
  }
  .zone-nom {
    font-family: var(--police-titre);
    font-weight: 700;
  }
  .zone-detail {
    color: var(--texte-doux);
    font-size: var(--taille-secondaire);
  }
  .ecoles-ici {
    display: grid;
    gap: var(--espace-3);
  }
  .encadre-pointille a:not(.bouton),
  .chercher {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
    color: var(--marque);
    font-weight: 700;
  }
  /* À partir de 48 rem : les lieux en grille, les titres plus grands. */
  @media (min-width: 48rem) {
    .hub {
      gap: var(--espace-5);
      padding-block: var(--espace-7);
    }
    .hub h1 {
      font-size: var(--taille-titre-public);
    }
    .zones {
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
      gap: var(--espace-3);
    }
  }
</style>
