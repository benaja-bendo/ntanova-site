---
// La page d'une zone (pays, département, ville, arrondissement, quartier) : les zones qu'elle contient, avec leur
// nombre d'écoles, puis les écoles qui sont directement chez elle. Quand le contour de la zone est dessiné
// (aujourd'hui les six arrondissements de Pointe-Noire), la carte est à un lien. Aucun JavaScript.
import {
  arrondissementDessine,
  arrondissementsDessines,
  cadreVille,
  vuesSurPlace,
  type ArrondissementSurCarte,
} from '../modele/carte/plan';
import {
  compterEcoles,
  ecolesSous,
  lienCarte,
  lienDivision,
  lieuAvecPreposition,
  nomAffiche,
  NOM_NIVEAU,
  phraseDeCompte,
  type PageDivision,
} from '../modele/geo-divisions';
import {
  etatPublicDe,
  libelleDeploiement,
  phraseDeLaSuite,
  phraseSansEcole,
} from '../modele/etat-zone';
import type { DivisionPublique } from '../modele/ports';
import Carte from './Carte.astro';
import BasculeVue from './BasculeVue.astro';
import ListeEcoles from './ListeEcoles.astro';

interface Props {
  page: PageDivision;
  /** Toutes les divisions du pays (même sans école) : la carte de la ville y lit celles où le relevé a commencé. */
  divisions: DivisionPublique[];
  /** « Une école manque ? » : le lien WhatsApp, s'il est configuré. */
  manque: string | null;
}
const { page, divisions, manque } = Astro.props;

const sous = ecolesSous(page);
const verifiees = sous.filter((e) => e.etat === 'verifiee').length;
const vues = vuesSurPlace(sous).length;
const nom = page.division.nom;
const niveau = page.division.niveau;
const genre = NOM_NIVEAU[niveau] ?? 'zone';
const ordinal = page.division.ordinal;
const parent = page.parent;
// L'état de la zone : le même que sur la carte (`etat-zone.ts`), jamais « relevé en cours » par défaut.
const etat = etatPublicDe(page.division, divisions);
const lieu = lieuAvecPreposition(nom, niveau);
const detailDeZone = (enfant: PageDivision) => {
  const n = ecolesSous(enfant).length;
  const sonEtat = etatPublicDe(enfant.division, divisions);
  const morceaux = [
    enfant.division.ordinal ? `Arrondissement ${enfant.division.ordinal}` : null,
    n > 0 ? compterEcoles(n) : null,
    sonEtat ? libelleDeploiement[sonEtat] : null,
  ].filter((x): x is string => x !== null);
  return n === 0 && !sonEtat ? [...morceaux, 'aucune école publiée'] : morceaux;
};

// Un arrondissement dessiné (Pointe-Noire) a sa carte, et la carte de la ville montre ses six arrondissements.
const adresseTexte = page.adresse.join('/');
const dessin =
  niveau === 3 && adresseTexte.startsWith('congo/pointe-noire/')
    ? arrondissementDessine(page.division.slug)
    : null;
const estPointeNoire = adresseTexte === 'congo/pointe-noire';
// Chaque arrondissement dessiné dit l'état de la carte : « en-cours » (vert), « programme » (pointillés), sinon « pas encore ».
const surLaCarte: ArrondissementSurCarte[] = estPointeNoire
  ? arrondissementsDessines.map((a) => {
      const fille = page.enfants.find((p) => p.division.slug === a.slug);
      const sienne = divisions.find(
        (d) =>
          d.niveau === 3 &&
          d.slug === a.slug &&
          d.adresse.join('/').startsWith('congo/pointe-noire/'),
      );
      const sonEtat = sienne ? etatPublicDe(sienne, divisions) : null;
      const n = fille ? ecolesSous(fille).length : 0;
      const lien = fille ? lienCarte(fille.adresse) : undefined;
      if (sonEtat === 'actif')
        return {
          arrondissement: a,
          role: 'en-cours',
          ...(lien ? { lien } : {}),
          etiquette: n > 0 ? compterEcoles(n) : 'relevé en cours',
        };
      if (sonEtat === 'programme')
        return {
          arrondissement: a,
          role: 'programme',
          // Une zone programmée sans école n'a rien à ouvrir : pas de lien (sa page est dans la liste, plus bas).
          ...(lien && n > 0 ? { lien } : {}),
          etiquette: n > 0 ? compterEcoles(n) : 'programmé',
        };
      return { arrondissement: a, role: 'pas-encore', etiquette: 'pas encore' };
    })
  : [];
const pasEncore = surLaCarte.filter((a) => a.role === 'pas-encore').length;
const sesEtats = [
  surLaCarte.some((a) => a.role === 'en-cours') ? 'En vert\u00a0: relevé en cours.' : '',
  surLaCarte.some((a) => a.role === 'programme')
    ? 'En pointillés\u00a0: déploiement programmé.'
    : '',
]
  .filter(Boolean)
  .join(' ');
const enLettres = ['aucun', 'un', 'deux', 'trois', 'quatre', 'cinq', 'six'];
const lienListe = lienDivision(page.adresse);
---

<section class="cadre page hub">
  <a class="retour" href={parent ? lienDivision(parent.adresse) : '/ecoles/'}>
    ← {parent ? nomAffiche(parent.division.nom, parent.division.niveau) : 'Les écoles'}
  </a>

  <div class="titre-vue">
    <div>
      <h1>{nomAffiche(nom, niveau)}</h1>
      {niveau > 0 && (
        <p class="texte-doux">
          {ordinal ? `Arrondissement ${ordinal}` : genre.charAt(0).toUpperCase() + genre.slice(1)}
          {page.noms.length > 1 && (
            <>
              {' '}
              · <span>{page.noms.slice(0, -1).join(' › ')}</span>
            </>
          )}
        </p>
      )}
      {etat && <p class={`etat-zone etat-${etat}`}>{libelleDeploiement[etat]}</p>}
    </div>
    {dessin && <BasculeVue carte={lienCarte(page.adresse)} liste={lienListe} actuelle="liste" />}
  </div>

  {sous.length === 0 ? (
    <p class="carte">{phraseSansEcole(etat)}</p>
  ) : (
    <p class="compte">{phraseDeCompte(sous.length, vues, verifiees)}</p>
  )}

  {sous.length > 0 && (
    <p class="carte">
      <a class="chercher" href="/pour-les-ecoles/#referencer">
        Ajouter mon école
      </a>
      <br />
      La demande est ouverte partout au Congo-Brazzaville ; la publication reste une décision de
      NTanova.
    </p>
  )}

  {estPointeNoire && surLaCarte.length > 0 && (
    <div class="disposition">
      <Carte
        id="ville"
        titre="Carte de Pointe-Noire par arrondissement"
        projection={cadreVille()}
        arrondissements={surLaCarte}
        noms
      />
      <p class="texte-doux">
        {sesEtats} Touchez un arrondissement.
        {pasEncore > 0 &&
          (pasEncore === 1
            ? ' L’autre arrondissement : pas encore relevé.'
            : ` Les ${enLettres[pasEncore]} autres arrondissements : pas encore relevés.`)}
      </p>
    </div>
  )}

  {page.enfants.length > 0 && (
    <section aria-label={`Les zones de ${nom}`}>
      <ul class="zones">
        {page.enfants.map((enfant) => (
          <li>
            <a
              class:list={[
                'zone',
                { 'zone-programme': etatPublicDe(enfant.division, divisions) === 'programme' },
              ]}
              href={lienDivision(enfant.adresse)}
            >
              <span class="zone-nom">{enfant.division.nom}</span>
              <span class="zone-detail">{detailDeZone(enfant).join(' · ')}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {page.ecoles.length > 0 && (
    <section aria-label={`Les écoles de ${nom}`} class="ecoles-ici">
      {page.enfants.length > 0 && <h2>Les écoles de {nom}</h2>}
      <ListeEcoles ecoles={page.ecoles} />
    </section>
  )}

  {sous.length > 0 ? (
    <>
      <p>
        <a class="chercher" href={`/recherche/?zone=${adresseTexte}`}>
          Chercher une école {lieu}
        </a>
      </p>

      <div class="encadre-pointille">
        <p>{phraseDeLaSuite(etat)}</p>
        {manque && <a href={manque}>Une école manque&nbsp;? Dites-le-nous sur WhatsApp</a>}
      </div>
    </>
  ) : (
    <aside class="encadre-pointille encart-unique" aria-label="Une école à ajouter">
      <p>
        <b>Vous connaissez ou vous dirigez une école {lieu}&nbsp;?</b>
      </p>
      <p>Écrivez-nous sur WhatsApp&nbsp;: nous la noterons pour le prochain passage.</p>
      {manque && (
        <a class="bouton" href={manque}>
          Écrire sur WhatsApp
        </a>
      )}
      <a class="chercher" href="/ecoles/">
        Voir les écoles déjà publiées
      </a>
    </aside>
  )}
</section>

<style>
  .hub {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--espace-4);
  }
  .titre-vue > div {
    min-width: 0;
    max-width: 100%;
  }
  .hub h1,
  .titre-vue p,
  .zone-nom,
  .zone-detail {
    overflow-wrap: anywhere;
  }
  .hub h1 {
    margin: 0;
    color: var(--marque-appuyee);
    font-family: var(--police-titre);
    font-size: var(--taille-titre-page);
    line-height: var(--interligne-titre);
  }
  .hub h2 {
    margin: 0;
    font-family: var(--police-titre);
    font-size: var(--taille-intertitre);
  }
  .hub p {
    margin: 0;
  }
  .compte {
    font-family: var(--police-titre);
    font-weight: 700;
  }
  .disposition {
    display: grid;
    gap: var(--espace-4);
  }
  .zones {
    display: grid;
    gap: var(--espace-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .zone {
    display: grid;
    gap: var(--espace-1);
    min-height: var(--cible-principale);
    padding: var(--espace-3) var(--espace-4);
    border-radius: var(--rayon-m);
    background: var(--carte-releve-en-cours);
    color: var(--texte);
    text-decoration: none;
  }
  .zone:hover {
    outline: 2px solid var(--marque);
  }
  .zone-programme {
    background: transparent;
    outline: 2px dashed var(--trait-fort);
    outline-offset: -2px;
  }
  .zone-programme .zone-detail {
    color: var(--texte-doux);
  }
  .zone-programme:hover {
    outline: 2px solid var(--marque);
  }
  .zone-nom {
    font-family: var(--police-titre);
    font-weight: 700;
  }
  .zone-detail {
    color: var(--marque-appuyee);
    font-size: var(--taille-secondaire);
  }
  .ecoles-ici {
    display: grid;
    gap: var(--espace-3);
  }
  .encadre-pointille a:not(.bouton),
  .chercher {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
    color: var(--marque);
    font-weight: 700;
  }
  /* L'état de la zone, le même mot que sur la carte : plein pour « relevé en cours », en pointillés pour « programmé ». */
  .etat-zone {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    min-height: 1.75rem;
    margin-top: var(--espace-2);
    padding: 0 var(--espace-3);
    border-radius: var(--rayon-pilule);
    font-family: var(--police-titre);
    font-size: var(--taille-mention);
    font-weight: 700;
  }
  .etat-actif {
    background: var(--vert-pale);
    color: var(--marque-appuyee);
  }
  .etat-programme {
    border: 2px dashed var(--trait-fort);
    color: var(--texte-doux);
  }
  /* Une zone sans école : un seul encart, qui dit comment la faire connaître. */
  .encart-unique {
    display: grid;
    gap: var(--espace-3);
    justify-items: start;
  }

  /* À partir de 48 rem : les zones en grille, les titres plus grands. */
  @media (min-width: 48rem) {
    .hub {
      gap: var(--espace-5);
      padding-block: var(--espace-7);
    }
    .hub h1 {
      font-size: var(--taille-titre-public);
    }
    .zones {
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
      gap: var(--espace-3);
    }
  }
  @media (min-width: 64rem) {
    .disposition {
      grid-template-columns: minmax(0, 3fr) minmax(16rem, 2fr);
      gap: var(--espace-6);
      align-items: start;
    }
  }
</style>
