---
// La fiche d'un campus publié (canevas « Écoles et fiches NTanova », validé le 08/11/2026, ticket 148) : la couverture dessinée, le
// disque du cycle, les preuves en pastilles, la barre « Y aller · WhatsApp · Appeler · Partager », ce qu'il enseigne, ses autres
// implantations, et comment y aller. Sur ordinateur, deux colonnes sous la couverture.
// Rien n'est écrit que la base ne sache : sans donnée, un bloc disparaît.
// Aucun JavaScript, sauf un script de moins de 2 Ko pour « Partager » (partage du téléphone, ou copie du lien) : sans lui, le
// bouton est un lien WhatsApp. Une institution à plusieurs campus a une fiche par campus, qui renvoient l'une vers l'autre.
import './carte-pieces.css';
import { cycleLePlusEleve, lettresDesCycles } from '../modele/carte/cycles';
import { zoomMaxEn } from '../modele/carte/fond';
import { adresseVue } from '../modele/carte/navigation';
import {
  ligneDeLieu,
  lienCourt,
  lienDivision,
  lienEcole,
  type PageDivision,
} from '../modele/geo-divisions';
import { libelleNiveau, libelleTypeEcole, typeInformatif } from '../modele/libelles';
import type { EcolePubliee } from '../modele/ports';
import {
  diplomesEnMots,
  invitationDirection,
  messageEcole,
  preuvesDeLaFiche,
  rythmesEnMots,
  titreOuTrouver,
} from '../modele/presentation-fiche';
import { dateLongue } from '../modele/pointe-noire';
import { jourDuCongo } from '../modele/date-declaration';
import { prochaineInscription } from '../modele/inscriptions';
import { LIEN_METHODE } from '../modele/pages-de-confiance';
import { lienWhatsApp } from '../modele/whatsapp';
import PhotoEcole from './PhotoEcole.astro';
import ProprietesEcole from './ProprietesEcole.astro';
import CouvertureEcole from './CouvertureEcole.astro';
import EquipementsEcole from './EquipementsEcole.astro';
import FormationsEcole from './FormationsEcole.astro';
import Icone from './Icone.astro';
import InscriptionsEcole from './InscriptionsEcole.astro';
import LigneAgrement from './LigneAgrement.astro';
import MotDirectionEcole from './MotDirectionEcole.astro';
import AdmissionEcole from './fiche/AdmissionEcole.astro';
import FraisDeLaFiche from './fiche/FraisDeLaFiche.astro';
import GalerieEcole from './fiche/GalerieEcole.astro';
import NouvellesEcole from './fiche/NouvellesEcole.astro';
import SitesEcole from './fiche/SitesEcole.astro';
import { libelleHoraire } from '../modele/libelles';
import {
  admissionAMontrer,
  cheminMedia,
  dossiersOuverts,
  estDuSuperieur,
  ficheCourte,
  ligneDIdentite,
  lignesDeFraisDeLEcole,
  nouvellesAMontrer,
  rondDeLEcole,
  rubriquesDeLaFiche,
} from '../modele/vitrine';

interface Props {
  e: EcolePubliee;
  /** La zone du campus, pour le fil d'Ariane. */
  zone: PageDivision;
  /** Les autres campus de la même institution. */
  autres: EcolePubliee[];
  /** « Une erreur sur la fiche… » : le lien WhatsApp, s'il est configuré. */
  erreur: string | null;
  /** « Je dirige cette école et je souhaite confirmer sa fiche » : le lien WhatsApp avec son nom et son adresse, s'il est configuré. */
  confirmer?: string | null;
}
const { e, zone, autres, erreur, confirmer = null } = Astro.props;

// Le fil d'Ariane : les lieux qui ont une page, du plus grand au plus fin (un département n'en a pas, ticket 147).
const ariane: { nom: string; lien: string }[] = [];
for (let p: PageDivision | null = zone; p; p = p.parent) {
  if (p.chemin.length > 0) ariane.unshift({ nom: p.division.nom, lien: lienDivision(p.chemin) });
}

const typeSeLit = typeInformatif(e.typeEcole);
const lieu = ligneDeLieu(e.quartier, zone.noms) || (zone.noms[0] ?? '');
const [lieuFort = '', ...lieuReste] = lieu.split(' · ');
const itineraire =
  e.latitude !== null && e.longitude !== null
    ? `https://www.google.com/maps/dir/?api=1&destination=${e.latitude},${e.longitude}`
    : null;

// Le disque de l'école (le cycle le plus élevé, comme son épingle) et la puce de chaque niveau : même lettre, même couleur.
const lettreEcole = cycleLePlusEleve(e.niveaux)?.lettre ?? '';
const classeDisque = (lettre: string) => (lettre ? `disque c-${lettre}` : 'disque');
const puces = e.niveaux.map((n) => ({ libelle: libelleNiveau[n], lettre: lettresDesCycles([n]) }));
// « Cours du jour et du soir » : utile à qui travaille, donc seulement là où l'on choisit une filière.
const rythme = e.niveaux.some((n) => n === 'superieur' || n === 'technique')
  ? rythmesEnMots(e.formations)
  : null;

const confirmee = e.etat === 'verifiee';
const preuves = preuvesDeLaFiche(e);
const classesPreuve = {
  direction: 'preuve preuve-direction',
  terrain: 'preuve',
  ecole: 'preuve preuve-ecole',
  vide: 'preuve preuve-vide',
} as const;

// La barre d'actions : l'adresse de la fiche (celle que WhatsApp montre avec son image), le numéro à appeler (le contact
// publié avec l'accord de la direction, sinon celui de l'enseigne), WhatsApp sur une fiche confirmée qui a un contact public.
const urlFiche = new URL(lienEcole(e), Astro.site ?? Astro.url).href;
const lienPartage = `https://wa.me/?text=${encodeURIComponent(`${e.nom} · ${urlFiche}`)}`;
const numeroAppel = e.contactPublic?.numero ?? e.numeroEnseigne;
const whatsappEcole =
  confirmee && e.contactPublic ? lienWhatsApp(e.contactPublic.numero, messageEcole(e.nom)) : null;
const nombreActions = 1 + Number(!!itineraire) + Number(!!numeroAppel) + Number(!!whatsappEcole);

// « Voir sur la carte » : la carte du site, centrée sur l'école. La fiche n'a plus de petit plan dessiné (ticket 146 : une
// seule carte) ; elle dit le repère en mots. L'école n'a son épingle sur la carte que vue sur place ; sinon la carte s'ouvre
// sur son quartier, et le lien le dit.
const vueSurPlace = e.releveeLe !== null;
const lienSurLaCarte =
  e.latitude !== null && e.longitude !== null
    ? `/carte/${vueSurPlace ? `?${new URLSearchParams({ ecole: e.numero })}` : ''}${adresseVue({
        zoom: Math.min(15, zoomMaxEn(e.longitude, e.latitude)),
        latitude: e.latitude,
        longitude: e.longitude,
      })}`
    : null;
// Plus d'état vide négatif (décision du fondateur du 08/11/2026) : sans repère, sans séries ni filières, la ligne ou le bloc
// disparaît, au lieu d'écrire « Repère pas encore relevé » ou « Pas encore renseignées ». L'invitation faite à la direction
// (« Vous dirigez cette école ? ») reste : ce n'est pas un état vide.

// Le contact et le programme : à droite sur une fiche confirmée, avec les filières à sa gauche ; sinon dans « À savoir ».
const diplomes = diplomesEnMots(e.formations);
const aSavoir = !!(e.programme || e.contactPublic || e.numeroEnseigne || diplomes);
const hote = new URL(lienCourt(e), Astro.site ?? Astro.url).host;

// La prochaine date limite annoncée : calculée à la construction, elle disparaît une fois passée.
const inscription = prochaineInscription(e.inscriptions ?? [], jourDuCongo());

// v2 (13/11, canevas « Fiche d'école ») ------------------------------------------------------------------------------------
// Une rubrique sans donnée n'existe pas : ni bloc, ni lien dans la barre des rubriques. Une fiche « courte » (le nom, les
// niveaux, le lieu) porte une seule carte sobre en bas, « Vous êtes de l'école ? » (décision du fondateur du 13/11).
const aujourdhui = jourDuCongo();
const superieur = estDuSuperieur(e);
const rond = rondDeLEcole(e);
const suiteIdentite = ligneDIdentite({ ...e, etiquette: null }, 1);
const couverture = e.medias?.couverture ?? null;
const galerie = e.medias?.galerie ?? [];
// La photo d'enseigne d'avant (choisie ou retenue d'office) : seule, dans « Photos », quand l'école n'a ni couverture ni galerie.
const photoSeule = !couverture && galerie.length === 0 ? (e.photo ?? null) : null;
const nouvelles = nouvellesAMontrer(e.nouvelles ?? [], aujourdhui);
const admission = admissionAMontrer(e.admission, aujourdhui) ? (e.admission ?? null) : null;
const ouverts = dossiersOuverts(e.admission, aujourdhui);
const fraisEcole = lignesDeFraisDeLEcole(e.frais ?? []);
const horaires = e.horaires ?? [];
const equipements = e.equipements ?? [];
const avecMot = confirmee && !!e.motDirection;
// L'ancre « L'école » se pose sur le premier bloc présent de la rubrique.
const premierDeLEcole = avecMot
  ? 'mot'
  : aSavoir
    ? 'savoir'
    : inscription
      ? 'inscription'
      : equipements.length > 0
        ? 'equipements'
        : null;
const ancre = (bloc: string) => (premierDeLEcole === bloc ? 'ecole' : undefined);
const rubriques = rubriquesDeLaFiche({
  ecole: premierDeLEcole !== null,
  formations: e.formations.length > 0,
  admission: !!admission,
  photos: galerie.length > 0 || !!photoSeule,
  frais: fraisEcole.length > 0,
  nouvelles: nouvelles.length > 0,
});
const courte = ficheCourte(e);
const lienPhotos = `${lienEcole(e)}photos/`;
const joursRestants = (n: number) =>
  n <= 0 ? 'Dernier jour.' : n === 1 ? 'Plus qu’un jour.' : `Plus que ${n} jours.`;
---

<article class="cadre page fiche">
  <nav class="ariane" aria-label="Fil d’Ariane">
    <ol>
      <li>
        <a href="/ecoles/">Écoles</a>
      </li>
      {ariane.map((a) => (
        <li>
          <a href={a.lien}>{a.nom}</a>
        </li>
      ))}
    </ol>
  </nav>

  <div class="fiche-entete">
    <div class="fiche-couverture">
      {couverture ? (
        <img
          class="couverture-photo"
          src={cheminMedia(couverture, 'couverture')}
          alt={`Vue de ${e.nom}`}
          width="720"
          height="300"
          decoding="async"
          fetchpriority="high"
        />
      ) : (
        <CouvertureEcole lettre={lettreEcole} />
      )}
    </div>

    <div class="fiche-tete">
      <div class="fiche-identite">
        {rond.genre === 'logo' ? (
          <span class="rond-ecole rond-logo">
            <img
              src={cheminMedia(rond.media, 'logo')}
              alt={`Logo de ${e.nom}`}
              width="76"
              height="76"
            />
          </span>
        ) : rond.genre === 'sigle' ? (
          <span class="rond-ecole rond-sigle" aria-hidden="true">
            {rond.texte}
          </span>
        ) : (
          <span class={`${classeDisque(lettreEcole)} disque-fiche`} aria-hidden="true">
            {lettreEcole}
          </span>
        )}
        <h1>{e.nom}</h1>
        {(e.etiquette || suiteIdentite) && (
          <p class="fiche-ligne">
            {e.etiquette && <span class="etiquette-campus">{e.etiquette}</span>}
            {e.etiquette && suiteIdentite && ' · '}
            {suiteIdentite}
          </p>
        )}
        <p class="fiche-lieu">
          <Icone nom="lieu" />
          <span>
            <strong>{lieuFort}</strong>
            {lieuReste.length > 0 && ` · ${lieuReste.join(' · ')}`}
          </span>
        </p>
        {e.agrement && <LigneAgrement agrement={e.agrement} />}

        {(puces.length > 0 || typeSeLit || rythme || horaires.length > 0) && (
          <ul class="apercu-meta puces" aria-label="Niveaux et type d’école">
            {puces.map((p) => (
              <li class="etiquette-niveau">
                <span class={classeDisque(p.lettre)} aria-hidden="true">
                  {p.lettre}
                </span>
                {p.libelle}
              </li>
            ))}
            {typeSeLit && <li class="etiquette-type">{libelleTypeEcole[e.typeEcole]}</li>}
            {horaires.map((h) => (
              <li class="etiquette-type">{libelleHoraire[h]}</li>
            ))}
            {rythme && <li class="etiquette-type">{rythme}</li>}
          </ul>
        )}

        <div class="preuves" aria-label="Sources de la fiche">
          {preuves.map((p) => (
            <p class={classesPreuve[p.genre]}>
              {p.icone && <Icone nom={p.icone} />}
              {p.texte}
            </p>
          ))}
          <a class="lien-methode" href={LIEN_METHODE}>
            Comment nous vérifions une fiche
          </a>
        </div>
      </div>

      {/* Les gestes d'une famille : uniquement ceux qui mènent quelque part. */}
      <div
        class:list={[
          'fiche-actions',
          {
            'fiche-actions-trois': nombreActions === 3,
            'fiche-actions-quatre': nombreActions === 4,
          },
        ]}
      >
        {itineraire && (
          <a class="bouton" href={itineraire}>
            <Icone nom="aller" />Y aller
          </a>
        )}
        {whatsappEcole && (
          <a class="bouton bouton-secondaire" href={whatsappEcole}>
            <Icone nom="bulle" />
            WhatsApp
          </a>
        )}
        {numeroAppel && (
          <a class="bouton bouton-secondaire" href={`tel:+${numeroAppel}`}>
            <Icone nom="appeler" />
            Appeler
          </a>
        )}
        <a
          class="bouton bouton-secondaire"
          href={lienPartage}
          data-partager
          data-url={urlFiche}
          data-titre={e.nom}
        >
          <Icone nom="partage" />
          <span data-libelle>Partager</span>
        </a>
      </div>
      <p class="visuellement-cache" role="status" data-partager-etat></p>
    </div>
  </div>

  <SitesEcole e={e} autres={autres} superieur={superieur} />

  {rubriques.length > 0 && (
    <nav class="rubriques" aria-label="Aller à une rubrique">
      {rubriques.map((r) => (
        <a href={`#${r.ancre}`}>{r.titre}</a>
      ))}
    </nav>
  )}

  {/* Sur téléphone, une seule colonne dans l'ordre du canevas (`o-…`) ; à partir de 64 rem, deux colonnes. */}
  <div class="fiche-corps">
    <div class="fiche-principale">
      {e.formations.length > 0 && (
        <div class="o-1">
          <FormationsEcole e={e} />
        </div>
      )}
      {admission && (
        <div class="o-2">
          <AdmissionEcole admission={admission} formations={e.formations} aujourdhui={aujourdhui} />
        </div>
      )}
      {avecMot && (
        <div class="o-3" id={ancre('mot')}>
          <MotDirectionEcole mot={e.motDirection!} />
        </div>
      )}
      {aSavoir && !confirmee && (
        <section class="a-savoir o-4" aria-label="À savoir" id={ancre('savoir')}>
          <h2 class="titre-ordinateur">À savoir</h2>
          <ProprietesEcole e={e} diplomes={diplomes} />
        </section>
      )}
      {inscription && (
        <div class="o-5" id={ancre('inscription')}>
          <InscriptionsEcole inscription={inscription} />
        </div>
      )}
      {equipements.length > 0 && (
        <div class="o-6">
          <EquipementsEcole equipements={equipements} id={ancre('equipements')} />
        </div>
      )}
      {galerie.length > 0 && (
        <div class="o-7">
          <GalerieEcole galerie={galerie} nom={e.nom} lienPhotos={lienPhotos} />
        </div>
      )}
      {photoSeule && (
        <section class="photos o-7" id="photos" aria-label="Photos">
          <h2>Photos</h2>
          <PhotoEcole photo={photoSeule} nom={e.nom} />
        </section>
      )}
      {nouvelles.length > 0 && (
        <div class="o-9">
          <NouvellesEcole nouvelles={nouvelles} />
        </div>
      )}
    </div>

    <div class="fiche-cote">
      {ouverts && (
        <section class="dossiers-ouverts o-0" aria-label="Dossiers ouverts">
          <b>Dossiers ouverts jusqu’au {dateLongue(ouverts.jusquau)}</b>
          <p>
            {joursRestants(ouverts.joursRestants)} La date vient de l’école&nbsp;: vérifiez-la avant
            de vous déplacer.
          </p>
        </section>
      )}
      {aSavoir && confirmee && (
        <section class="contact o-4" aria-label="Contact" id={avecMot ? undefined : 'ecole'}>
          <h2>Contact</h2>
          <ProprietesEcole e={e} diplomes={diplomes} />
        </section>
      )}
      {fraisEcole.length > 0 && (
        <div class="o-8">
          <FraisDeLaFiche frais={fraisEcole} />
        </div>
      )}

      {(e.repere || lienSurLaCarte || e.memeLieu) && (
        <section class="bloc ou o-10" aria-label="Où est l'école">
          <h2>{titreOuTrouver(e.nom)}</h2>
          {e.repere && (
            <p class="apercu-repere">
              <Icone nom="repere" petite={false} />
              <span>{e.repere}</span>
            </p>
          )}
          {e.memeLieu && (
            <p class="meme-lieu">
              Même lieu que <a href={lienCourt(e.memeLieu)}>{e.memeLieu.nom}</a>
            </p>
          )}
          <p class="texte-doux">{lieu}</p>
          {lienSurLaCarte && (
            <a class="bouton bouton-secondaire ou-carte" href={lienSurLaCarte}>
              <Icone nom="plan" />
              {vueSurPlace ? 'Voir sur la carte' : 'Voir le quartier sur la carte'}
            </a>
          )}
        </section>
      )}

      {!confirmee && courte && (
        <aside class="ecoles-appel ecoles-appel-court o-11">
          <h2>Vous êtes de l’école&nbsp;?</h2>
          <p>
            Complétez cette fiche&nbsp;: photos, frais, contact. Rien n’est publié sans votre
            accord.
          </p>
          <a class="bouton" href={confirmer ?? '/pour-les-ecoles/'}>
            <Icone nom="bulle" />
            Compléter cette fiche
          </a>
        </aside>
      )}
      {!confirmee && !courte && (
        <aside class="ecoles-appel o-11">
          <h2>{invitationDirection(e.nom)}</h2>
          <p>
            Confirmez sa fiche avec nous&nbsp;: la date de votre accord y paraîtra. Ajoutez vos
            filières, vos frais et votre contact. Ce que vous nous transmettez n’est publié qu’avec
            votre accord.
          </p>
          <a class="bouton" href={confirmer ?? '/pour-les-ecoles/'}>
            <Icone nom="bulle" />
            Confirmer cette fiche
          </a>
          {confirmer && <a href="/pour-les-ecoles/">Ce que nous vous demanderons</a>}
        </aside>
      )}

      <div class="liens-fiche o-12">
        {confirmee && (
          <a href={confirmer ?? '/pour-les-ecoles/'}>
            <Icone nom="bulle" />
            Mettre à jour cette fiche
          </a>
        )}
        {erreur && (
          <a href={erreur}>
            <Icone nom="repere" />
            Signaler une erreur sur cette fiche
          </a>
        )}
      </div>

      {/* Ticket 147 : l'identifiant NTanova, permanent, et le lien court, la seule forme courte (`/ecoles/<identifiant>/`). */}
      <div class="identifiant o-13">
        <p>
          Identifiant NTanova&nbsp;: <b>{e.numero}</b>
        </p>
        <p>
          Lien court&nbsp;:{' '}
          <a href={lienCourt(e)}>
            {hote}
            {lienCourt(e)}
          </a>
        </p>
        <p>Fiche mise à jour le {dateLongue(e.misAJourLe)}</p>
      </div>
    </div>
  </div>
</article>

{/* « Partager » : le partage du téléphone quand il existe, sinon la copie du lien avec un retour visible. Sans l'un ni l'autre
    (page sans connexion sécurisée, navigateur ancien) ou sans JavaScript, le lien WhatsApp du bouton fait le travail. */}
<script is:inline>
  (function () {
    const a = document.querySelector('[data-partager]');
    if (!a) return;
    const libelle = a.querySelector('[data-libelle]');
    const etat = document.querySelector('[data-partager-etat]');
    let minuteur;
    a.addEventListener('click', function (ev) {
      const url = a.getAttribute('data-url');
      if (navigator.share) {
        ev.preventDefault();
        navigator.share({ title: a.getAttribute('data-titre'), url: url }).catch(function () {});
      } else if (navigator.clipboard && navigator.clipboard.writeText) {
        ev.preventDefault();
        navigator.clipboard.writeText(url).then(
          function () {
            libelle.textContent = 'Lien copié';
            a.classList.add('copie');
            etat.textContent = 'Lien de la fiche copié.';
            clearTimeout(minuteur);
            minuteur = setTimeout(function () {
              libelle.textContent = 'Partager';
              a.classList.remove('copie');
              etat.textContent = '';
            }, 2500);
          },
          function () {
            location.href = a.href;
          },
        );
      }
    });
  })();
</script>

<style>
  .fiche {
    display: grid;
    gap: var(--espace-4);
    padding-block-start: var(--espace-2);
  }
  .fiche h1 {
    margin: var(--espace-1) 0 0;
    font-family: var(--police-titre);
    font-size: 1.5rem;
    line-height: var(--interligne-titre);
    overflow-wrap: anywhere;
  }
  .fiche :global(h2) {
    margin: 0;
    font-family: var(--police-titre);
    font-size: var(--taille-intertitre);
  }
  .fiche :global(p) {
    margin: 0;
  }

  /* Le fil d'Ariane : le séparateur est un décor, il ne se lit pas. */
  .ariane ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--espace-1);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--taille-secondaire);
    font-weight: 700;
  }
  .ariane li + li::before {
    content: '›' / '';
    margin-inline-end: var(--espace-1);
    color: var(--trait-fort);
  }
  .ariane a {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
    color: var(--marque);
  }

  /* La couverture touche les bords du téléphone ; l'en-tête remonte dessus. */
  .fiche-couverture {
    margin-inline: calc(var(--espace-4) * -1);
  }
  .fiche-tete {
    position: relative;
    display: grid;
    gap: var(--espace-4);
    margin-top: -30px;
  }
  .fiche-identite {
    display: grid;
    gap: var(--espace-2);
    min-width: 0;
  }
  .disque-fiche {
    width: 60px;
    height: 60px;
    font-size: 1.625rem;
    box-shadow: 0 0 0 4px var(--fond);
  }
  .etiquette-campus {
    color: var(--marque-appuyee);
    font-family: var(--police-titre);
    font-weight: 700;
  }
  .fiche-lieu {
    display: flex;
    align-items: center;
    gap: var(--espace-1);
