---
// La fiche d'un campus publié : ce qui se voit de la rue, ce qu'il enseigne (cycles, séries, diplômes,
// domaines, rythmes), ses autres implantations, et comment y aller.
// Elle parle comme l'aperçu de la carte (audit du 05/11/2026, chantier 2) : le disque et les puces de niveau, les deux
// preuves en blocs, la barre « Y aller · Appeler · Partager ». Les pièces viennent de `carte-pieces.css`.
// Aucun JavaScript, sauf un script de moins de 2 Ko pour « Partager » (partage du téléphone, ou copie du lien) :
// sans lui, le bouton est un lien WhatsApp.
// Une institution à plusieurs campus a une fiche par campus, qui renvoient l'une vers l'autre.
import { cycleLePlusEleve, lettresDesCycles } from '../modele/carte/donnees';
import { zoomMaxEn } from '../modele/carte/fond';
import { adresseVue } from '../modele/carte/navigation';
import {
  arrondissementDessine,
  arrondissementsDessines,
  cadreEcole,
  marqueDe,
  planer,
  ruesDe,
  situees,
} from '../modele/carte/plan';
import { reperes } from '../modele/carte/reperes';
import {
  ligneDeLieu,
  lienCarte,
  lienDivision,
  lienEcole,
  type PageDivision,
} from '../modele/geo-divisions';
import {
  libelleDiplome,
  libelleNiveau,
  libelleRythme,
  libelleSerie,
  libelleTypeEcole,
  typeInformatif,
} from '../modele/libelles';
import { listes } from '../modele/listes';
import type { EcolePubliee, FormationPublique } from '../modele/ports';
import { dateLongue } from '../modele/pointe-noire';
import { lienFacette } from '../modele/recherche';
import PhotoEcole from './PhotoEcole.astro';
import ContactEcole from './ContactEcole.astro';
import Carte from './Carte.astro';
import FraisEcole from './FraisEcole.astro';
import EquipementsEcole from './EquipementsEcole.astro';
import Icone from './Icone.astro';

interface Props {
  e: EcolePubliee;
  /** La zone du campus, pour le fil d'Ariane. */
  zone: PageDivision;
  /** Les autres campus de la même institution. */
  autres: EcolePubliee[];
  /** « Une erreur sur la fiche… » : le lien WhatsApp, s'il est configuré. */
  erreur: string | null;
  /** « Je dirige cette école et je souhaite confirmer sa fiche » : le lien WhatsApp avec son nom et son adresse, s'il est configuré. */
  confirmer?: string | null;
}
const { e, zone, autres, erreur, confirmer = null } = Astro.props;

const niveaux = e.niveaux.map((n) => libelleNiveau[n]).join(', ');
const typeSeLit = typeInformatif(e.typeEcole);
const lieu = ligneDeLieu(e.quartier, zone.noms);
const itineraire =
  e.latitude !== null && e.longitude !== null
    ? `https://www.google.com/maps/dir/?api=1&destination=${e.latitude},${e.longitude}`
    : null;

// Le disque de l'école (le cycle le plus élevé, comme son épingle) et la puce de chaque niveau : même lettre, même couleur.
const lettreEcole = cycleLePlusEleve(e.niveaux)?.lettre ?? '';
const classeDisque = (lettre: string) => (lettre ? `disque c-${lettre}` : 'disque');
const puces = e.niveaux.map((n) => ({ libelle: libelleNiveau[n], lettre: lettresDesCycles([n]) }));

// Les formations, cycle par cycle (dans l'ordre de la liste des cycles).
const parCycle = listes.niveau
  .map((cycle) => ({ cycle, formations: e.formations.filter((f) => f.cycle === cycle) }))
  .filter((c) => c.formations.length > 0);
// Un cycle qui a normalement des filières, sans aucune de notée : on le dit.
const cyclesSansFormation = e.niveaux.filter(
  (n) =>
    ['lycee', 'technique', 'superieur', 'autre_formation'].includes(n) &&
    !e.formations.some((f) => f.cycle === n),
);
// Ce que le relais n'a pas encore noté ; ce que seule la direction peut donner est à part.
const pasReleve = [
  !niveaux && 'Niveaux',
  !typeSeLit && "Type d'école",
  cyclesSansFormation.length > 0 && 'Séries ou filières',
].filter((x): x is string => !!x);
const rythmes = (f: FormationPublique) => f.rythmes.map((r) => libelleRythme[r]).join(', ');

// Ce que seule la direction peut compléter. Tant que l'école n'est pas confirmée, on dit qu'il reste à compléter avec elle ;
// confirmée, ce qui manque encore est ce qu'elle n'a pas communiqué.
const confirmee = e.etat === 'verifiee';
const aCompleter = [
  !e.frais?.length && 'Frais',
  !e.photo && 'Photos de l’école',
  !e.equipements?.length && 'Équipements',
  !e.contactPublic && "Contact de l'école",
].filter((x): x is string => !!x);

// La barre d'actions : l'adresse de la fiche (celle que WhatsApp montre avec son image), le numéro à appeler (le contact
// publié avec l'accord de la direction, sinon celui de l'enseigne).
const urlFiche = new URL(lienEcole(e), Astro.site ?? Astro.url).href;
const lienPartage = `https://wa.me/?text=${encodeURIComponent(`${e.nom} · ${urlFiche}`)}`;
const numeroAppel = e.contactPublic?.numero ?? e.numeroEnseigne;

// Le petit plan de la fiche : seulement quand le contour de l'arrondissement ET ses rues sont dessinés. Un contour sans rues
// n'est qu'un grand rectangle vide avec une maison (D21) : la fiche dit alors le repère en mots et renvoie à la vraie carte.
const dessin = zone.adresse.join('/').startsWith('congo/pointe-noire/')
  ? arrondissementDessine(zone.adresse[zone.adresse.length - 1] ?? '')
  : null;
const rues = dessin ? ruesDe(dessin.slug) : null;
const situee = situees([e]).map(marqueDe)[0];
const carteDuQuartier = dessin ? lienCarte(zone.adresse) : '';
const plan =
  situee && dessin && rues
    ? (() => {
        const { boite, projection } = cadreEcole(situee);
        return planer(boite, [{ ...situee, lien: carteDuQuartier }], projection);
      })()
    : null;
// Sans plan dessiné : la carte interactive, centrée sur l'école. L'école n'y a son épingle que vue sur place ; sinon la carte
// s'ouvre sur son quartier, et le lien le dit.
const vueSurPlace = e.releveeLe !== null;
const lienSurLaCarte =
  !plan && e.latitude !== null && e.longitude !== null
    ? `/carte/${vueSurPlace ? `?${new URLSearchParams({ ecole: lienEcole(e) })}` : ''}${adresseVue({
        zoom: Math.min(15, zoomMaxEn(e.longitude, e.latitude)),
        latitude: e.latitude,
        longitude: e.longitude,
      })}`
    : null;
const nomZone = zone.division.nom;
---

<article class="cadre page fiche">
  <a class="retour" href={lienDivision(zone.adresse)}>
    ← Les écoles de {nomZone}
  </a>

  <div class="fiche-corps">
    <div class="fiche-principale">
      <header class="apercu-tete">
        <span class={`${classeDisque(lettreEcole)} disque-xl`} aria-hidden="true">
          {lettreEcole}
        </span>
        <div class="apercu-titres">
          <h1>{e.nom}</h1>
          {e.etiquette && <p class="etiquette-campus">{e.etiquette}</p>}
          <p class="apercu-lieu">
            <Icone nom="lieu" />
            <span>{lieu || zone.noms[0]}</span>
          </p>
        </div>
      </header>

      {(puces.length > 0 || typeSeLit) && (
        <ul class="apercu-meta puces" aria-label="Niveaux et type d’école">
          {puces.map((p) => (
            <li class="etiquette-niveau">
              <span class={classeDisque(p.lettre)} aria-hidden="true">
                {p.lettre}
              </span>
              {p.libelle}
            </li>
          ))}
          {typeSeLit && <li class="etiquette-type">{libelleTypeEcole[e.typeEcole]}</li>}
        </ul>
      )}

      {/* Deux preuves, jamais fusionnées (décision du fondateur du 03/11) : l'accord daté de la direction,
          et le passage d'un relais. Sans passage, la fiche le dit. */}
      <div class="preuves">
        {confirmee && (
          <div class="preuve preuve-direction">
            <Icone nom="bouclier" petite={false} />
            <div>
              <strong>
                Confirmée par la direction{e.verifieeLe ? ` le ${dateLongue(e.verifieeLe)}` : ''}
              </strong>
            </div>
          </div>
        )}
        {e.origine === 'school' && (
          <div class="preuve preuve-vide">
            <Icone nom="repere" petite={false} />
            <div>
              <strong>
                Déclarée par l’école{e.declareeLe ? ` le ${dateLongue(e.declareeLe)}` : ''}
              </strong>
              Informations transmises par l’école ; cette déclaration ne confirme pas toute la
              fiche.
            </div>
          </div>
        )}
        {e.releveeLe ? (
          <div class="preuve">
            <Icone nom="oeil" petite={false} />
            <div>
              <strong>Vue sur place le {dateLongue(e.releveeLe)}</strong>
              Par un jeune du quartier&nbsp;: seulement ce qui se voit de la rue.
            </div>
          </div>
        ) : (
          <div class="preuve preuve-vide">
            <Icone nom="oeil" petite={false} />
            <div>
              {e.origine !== 'school' && (
                <strong>
                  Ajoutée par NTanova{e.situeeLe ? ` le ${dateLongue(e.situeeLe)}` : ''}
                </strong>
              )}
              Pas encore vue sur place par un jeune du quartier.
            </div>
          </div>
        )}
      </div>

      {/* Les trois gestes d'une famille. Le premier est plein : « Y aller » quand l'école est située, sinon « Appeler ». */}
      <div class="apercu-actions fiche-actions">
        {itineraire && (
          <a class="bouton bouton-large" href={itineraire}>
            <Icone nom="aller" />Y aller
          </a>
        )}
        {numeroAppel && (
          <a
            class:list={['bouton', itineraire ? 'bouton-secondaire' : 'bouton-large']}
            href={`tel:+${numeroAppel}`}
          >
            <Icone nom="appeler" />
            Appeler
          </a>
        )}
        <a
          class:list={['bouton', itineraire || numeroAppel ? 'bouton-secondaire' : 'bouton-large']}
          href={lienPartage}
          data-partager
          data-url={urlFiche}
          data-titre={e.nom}
        >
          <Icone nom="partage" />
          <span data-libelle>Partager</span>
        </a>
      </div>
      <p class="visuellement-cache" role="status" data-partager-etat></p>

      {e.photo && <PhotoEcole photo={e.photo} nom={e.nom} />}

      {(e.programme || e.contactPublic || e.numeroEnseigne) && (
        <dl class="carte proprietes">
          {e.programme && (
            <>
              <dt>Programme et langues</dt>
              <dd>{e.programme}</dd>
            </>
          )}
          <ContactEcole contact={e.contactPublic ?? null} enseigne={e.numeroEnseigne} />
        </dl>
      )}

      {parCycle.length > 0 && (
        <section class="carte formations" aria-label="Formations">
          <h2>Ce qui est enseigné</h2>
          {parCycle.map((c) => (
            <div class="cycle">
              <h3>{libelleNiveau[c.cycle]}</h3>
              <ul>
                {c.formations.map((f) => (
                  <li>
                    <b>{f.titre}</b>
                    <span class="liens-formation">
                      {f.serie && (
                        <a href={lienFacette({ facette: 'serie', valeur: f.serie })}>
                          {libelleSerie[f.serie]}
                        </a>
                      )}
                      {f.diplome && (
                        <a href={lienFacette({ facette: 'diplome', valeur: f.diplome })}>
                          {libelleDiplome[f.diplome]}
                        </a>
                      )}
                      {f.domaine && (
                        <a href={lienFacette({ facette: 'domaine', valeur: f.domaine.slug })}>
                          {f.domaine.nom}
                        </a>
                      )}
                      {f.rythmes.length > 0 && <span>{rythmes(f)}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      )}

      {autres.length > 0 && (
        <section class="carte autres" aria-label="Autres implantations">
          <h2>Les autres implantations de {e.nom}</h2>
          <ul>
            {autres.map((a) => (
              <li>
                <a href={lienEcole(a)}>
                  <b>{a.etiquette ?? a.nom}</b>
                  <span class="texte-doux">
                    {a.divisionNoms.slice(1).join(' · ')}
                    {a.niveaux.length > 0
                      ? ` · ${a.niveaux.map((n) => libelleNiveau[n]).join(', ')}`
                      : ''}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="carte ou" aria-label="Où est l'école">
        {plan && dessin && situee && (
          <Carte
            id="fiche"
            titre={`${e.nom} sur la carte de ${nomZone}`}
            projection={plan.projection}
            arrondissements={arrondissementsDessines.map((a) => ({
              arrondissement: a,
              role: a.slug === dessin.slug ? 'focus' : 'voisin',
            }))}
            rues={rues}
            marques={plan.marques}
            reperes={reperes}
            halo={situee}
          />
        )}
        <p class="apercu-repere">
          <Icone nom="repere" petite={false} />
          <span>
            <b>Repère&nbsp;:</b> {e.repere ?? 'pas encore relevé'}
          </span>
        </p>
        {plan && <a href={carteDuQuartier}>Voir sur la carte de {nomZone}</a>}
        {lienSurLaCarte && (
          <a href={lienSurLaCarte}>
            {vueSurPlace ? 'Voir sur la carte' : 'Voir le quartier sur la carte'}
          </a>
        )}
      </section>
    </div>

    <div class="fiche-cote">
      <FraisEcole frais={e.frais ?? []} />
      <EquipementsEcole equipements={e.equipements ?? []} />
      {pasReleve.length > 0 && (
        <section class="manque">
          <p class="surtitre-doux-public">Pas encore relevé</p>
          <ul class="pastilles-vides">
            {pasReleve.map((x) => (
              <li>{x}</li>
            ))}
          </ul>
        </section>
      )}
      {aCompleter.length > 0 && (
        <section class="manque">
          <p class="surtitre-doux-public">
            {confirmee ? 'Non communiqué par la direction' : 'À compléter avec la direction'}
          </p>
          <ul class="pastilles-vides">
            {aCompleter.map((x) => (
              <li>{x}</li>
            ))}
          </ul>
        </section>
      )}
      <aside class="ecoles-appel">
        <p>
          <b>Vous gérez cet établissement&nbsp;?</b>
        </p>
        <p>Confirmez cette fiche avec nous. Rien n'est publié sans votre accord daté.</p>
        <a class="bouton bouton-accent" href={confirmer ?? '/pour-les-ecoles/'}>
          Confirmer cette fiche
        </a>
        {confirmer && <a href="/pour-les-ecoles/">Ce que nous vous demanderons</a>}
        {erreur && <a href={erreur}>Signaler une erreur</a>}
      </aside>
    </div>
  </div>
</article>

{/* « Partager » : le partage du téléphone quand il existe, sinon la copie du lien avec un retour visible. Sans l'un ni l'autre
    (page sans connexion sécurisée, navigateur ancien) ou sans JavaScript, le lien WhatsApp du bouton fait le travail. */}
<script is:inline>
  (function () {
    const a = document.querySelector('[data-partager]');
    if (!a) return;
    const libelle = a.querySelector('[data-libelle]');
    const etat = document.querySelector('[data-partager-etat]');
    let minuteur;
    a.addEventListener('click', function (ev) {
      const url = a.getAttribute('data-url');
      if (navigator.share) {
        ev.preventDefault();
        navigator.share({ title: a.getAttribute('data-titre'), url: url }).catch(function () {});
      } else if (navigator.clipboard && navigator.clipboard.writeText) {
        ev.preventDefault();
        navigator.clipboard.writeText(url).then(
          function () {
            libelle.textContent = 'Lien copié';
            a.classList.add('copie');
            etat.textContent = 'Lien de la fiche copié.';
            clearTimeout(minuteur);
            minuteur = setTimeout(function () {
              libelle.textContent = 'Partager';
              a.classList.remove('copie');
              etat.textContent = '';
            }, 2500);
          },
          function () {
            location.href = a.href;
          },
        );
      }
    });
  })();
</script>

<style is:global>
  @import './carte-pieces.css';
</style>

<style>
  .fiche {
    display: grid;
    gap: var(--espace-4);
  }
  .fiche h1 {
    margin: 0;
    font-family: var(--police-titre);
    font-size: var(--taille-titre-fiche);
    line-height: var(--interligne-titre);
    overflow-wrap: anywhere;
  }
  .fiche h2 {
    margin: 0;
    font-family: var(--police-titre);
    font-size: var(--taille-intertitre);
  }
  .fiche h3 {
    margin: 0;
    font-family: var(--police-titre);
    font-size: var(--taille-courante);
  }
  .fiche p {
    margin: 0;
  }
  .etiquette-campus {
    color: var(--marque-appuyee);
    font-family: var(--police-titre);
    font-weight: 700;
  }
  .puces {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .preuves {
    display: grid;
    gap: var(--espace-2);
  }
  /* Le bouton « Partager » dit qu'il a copié le lien. */
  .fiche-actions .copie {
    border-color: var(--preuve-terrain);
    background: var(--vert-pale);
    color: var(--marque-appuyee);
  }
  /* Deux actions seulement : la seconde prend toute la largeur au lieu de la moitié. */
  .fiche-actions .bouton:last-child:nth-child(even) {
    grid-column: 1 / -1;
  }
  .proprietes {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--espace-3) var(--espace-4);
    margin: 0;
    padding: var(--espace-4);
  }
  /* Le contact est écrit par ContactEcole : ses dt et dd n'ont pas l'attribut de cette feuille, d'où `:global`. Les lignes
     « Programme », « Contact » et « Numéro sur l'enseigne » sont alignées de la même façon. */
  .proprietes :global(dt) {
    color: var(--texte-doux);
    font-size: var(--taille-secondaire);
  }
  .proprietes :global(dd) {
    margin: 0;
    font-weight: 700;
    text-align: right;
  }
  .formations,
  .autres {
    display: grid;
    gap: var(--espace-3);
    padding: var(--espace-4);
  }
  .cycle {
    display: grid;
    gap: var(--espace-2);
  }
  .formations ul,
  .autres ul {
    display: grid;
    gap: var(--espace-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .formations li {
    display: grid;
    gap: var(--espace-1);
  }
  .liens-formation {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--espace-1) var(--espace-3);
    color: var(--texte-doux);
    font-size: var(--taille-secondaire);
  }
  .liens-formation a {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
    color: var(--marque);
  }
  .autres a {
    display: grid;
    gap: var(--espace-1);
    min-height: var(--cible-min);
    color: var(--texte);
    text-decoration: none;
  }
  .autres a:hover b {
    color: var(--marque);
    text-decoration: underline;
  }
  .ou {
    display: grid;
    gap: var(--espace-3);
    padding: var(--espace-4);
  }
  .ou > a {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
    color: var(--marque);
    font-weight: 700;
  }
  .manque {
    display: grid;
    gap: var(--espace-2);
  }
  .surtitre-doux-public {
    color: var(--texte-doux);
    font-family: var(--police-titre);
    font-size: var(--taille-mention);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  /* Sur téléphone, les blocs se suivent : la fiche, puis ce qui manque, puis l'appel aux directions. */
  .fiche-corps,
  .fiche-principale,
  .fiche-cote {
    display: grid;
    gap: var(--espace-4);
  }

  /* À partir de 48 rem : une colonne plus aérée ; à partir de 64 rem, l'appel aux directions passe à droite. */
  @media (min-width: 48rem) {
    .fiche {
      gap: var(--espace-5);
      padding-block: var(--espace-7);
    }
    .fiche h1 {
      font-size: var(--taille-titre-public);
    }
    /* La colonne de la fiche garde la largeur d'une ligne de texte : cadre pointillé, cartes et texte alignés. */
    .fiche-corps {
      gap: var(--espace-5);
      max-width: var(--largeur-texte);
    }
    .fiche-principale,
    .fiche-cote {
      align-content: start;
      gap: var(--espace-5);
    }
    .proprietes {
      grid-template-columns: minmax(9rem, auto) 1fr;
    }
    .proprietes :global(dt) {
      align-self: center;
    }
    .proprietes :global(dd) {
      text-align: left;
    }
    .ou > a,
    .ou .bouton {
      justify-self: start;
    }
  }
  @media (min-width: 64rem) {
    .fiche-corps {
      /* Les pistes occupent le cadre ; les paragraphes gardent leur limite de lecture. */
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      gap: var(--espace-7);
      align-items: start;
      max-width: none;
    }
  }
</style>
