---
// Le téléphone de l'école, en une ligne de la carte « Contact » (lot 3, planche « Fiche publique ») : le numéro publié avec
// l'accord de la direction, sinon celui de l'enseigne. D'où il vient et quand se lit en note, sous la carte.
import type { ContactPublic } from '../modele/contact-public';
import { afficherTelephone } from '../modele/telephone';
interface Props {
  contact?: ContactPublic | null;
  enseigne: string | null;
}
const { contact, enseigne } = Astro.props;
const numero = contact?.numero ?? enseigne;
---

{numero && (
  <li>
    <span class="libelle">Téléphone</span>
    <a class="valeur" href={`tel:+${numero}`}>
      {afficherTelephone(numero)}
    </a>
  </li>
)}
<style>
  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
    color: var(--marque);
    white-space: nowrap;
  }
</style>
