---
// La vignette d'une école dans une carte d'école (accueil, « Écoles proches », plus tard la liste du lot 4 bis) : planches de la
// version 44 et décision du fondateur du 16/11. La couverture choisie, sinon la photo d'enseigne, réduites à la construction ;
// sans photo, le fond pierre et le rond de l'école : son logo, sinon son sigle sur le vert foncé, sinon la lettre de son niveau
// le plus élevé dans la couleur du cycle (`rondDeLEcole`). Jamais les anciennes vignettes bleues à grande lettre.
import type { EcolePubliee } from '../modele/ports';
import { vignetteDeLaCarte } from '../modele/fiche-mince';
import { cheminMedia, rondDeLEcole } from '../modele/vitrine';

interface Props {
  ecole: Pick<EcolePubliee, 'medias' | 'sigle' | 'niveaux' | 'photo'>;
  /**
   * `large` : la bande d'une carte en colonne ; `adaptee` : carrée sur téléphone (carte en ligne), large à partir de 48 rem ;
   * le navigateur ne charge que l'une des deux.
   */
  forme?: 'large' | 'adaptee';
}
const { ecole, forme = 'large' } = Astro.props;
const image = vignetteDeLaCarte(ecole);
const rond = rondDeLEcole(ecole);
---

{image ? (
  forme === 'adaptee' ? (
    <picture>
      <source media="(min-width: 48rem)" srcset={image.large} width="400" height="208" />
      <img
        class="vignette-ecole vignette-adaptee"
        src={image.carree}
        alt=""
        width="152"
        height="152"
        loading="lazy"
        decoding="async"
      />
    </picture>
  ) : (
    <img
      class="vignette-ecole vignette-large"
      src={image.large}
      alt=""
      width="400"
      height="208"
      loading="lazy"
      decoding="async"
    />
  )
) : (
  <span class:list={['vignette-ecole', 'vignette-vide', `vignette-${forme}`]} aria-hidden="true">
    {rond.genre === 'logo' ? (
      <span class="vignette-rond vignette-logo">
        <img src={cheminMedia(rond.media, 'logo')} alt="" width="100" height="100" loading="lazy" />
      </span>
    ) : rond.genre === 'sigle' ? (
      <span class="vignette-rond vignette-sigle">{rond.texte}</span>
    ) : rond.genre === 'cycle' ? (
      <span class={`disque c-${rond.lettre} vignette-rond vignette-cycle`}>{rond.lettre}</span>
    ) : null}
  </span>
)}

<style>
  /* La vignette adaptée choisit sa source ; c'est l'image qui se place dans la carte. */
  picture {
    display: contents;
  }
  .vignette-ecole {
    display: block;
    width: 100%;
    border-radius: var(--rayon-s);
    background: var(--couverture-vide);
    object-fit: cover;
  }
  .vignette-large {
    aspect-ratio: 400 / 208;
  }
  .vignette-adaptee {
    aspect-ratio: 1;
  }
  .vignette-vide {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* Le rond de la planche : 56 px dans une carte en colonne, 40 px dans une carte en ligne. */
  .vignette-rond {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    overflow: hidden;
    border-radius: 50%;
  }
  .vignette-adaptee .vignette-rond {
    width: 40px;
    height: 40px;
  }
  .vignette-sigle {
    padding: 4px;
    background: var(--marque-appuyee);
    color: var(--texte-sur-marque);
    font-family: var(--police-titre);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1;
    text-align: center;
    overflow-wrap: anywhere;
  }
  .vignette-adaptee .vignette-sigle {
    font-size: 0.6875rem;
  }
  .vignette-cycle {
    font-size: 1.375rem;
  }
  .vignette-adaptee .vignette-cycle {
    font-size: 1.125rem;
  }
  .vignette-logo {
    background: var(--fond-releve);
  }
  .vignette-logo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (min-width: 48rem) {
    .vignette-adaptee {
      aspect-ratio: 400 / 208;
    }
    .vignette-adaptee .vignette-rond {
      width: 56px;
      height: 56px;
    }
    .vignette-adaptee .vignette-sigle {
      font-size: 0.9375rem;
    }
    .vignette-adaptee .vignette-cycle {
      font-size: 1.375rem;
    }
  }
</style>
