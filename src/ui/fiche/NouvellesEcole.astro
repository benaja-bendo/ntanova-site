---
// « Nouvelles » (v2 du 13/11) : les trois plus récentes, publiées par l'administration avec l'accord daté de l'école. Le
// surtitre dit d'où elle vient : « Nouvelle de l'école » si l'école l'a fournie, sinon « Nouvelle ». Sans nouvelle, la
// rubrique n'existe pas. Lot 3 (planche) : une vignette, ou une teinte unie, à gauche ; sur ordinateur, deux cartes par ligne.
import { dateLongue } from '../../modele/pointe-noire';
import { cheminMedia, surtitreNouvelle, type NouvellePublique } from '../../modele/vitrine';
interface Props {
  nouvelles: NouvellePublique[];
}
const { nouvelles } = Astro.props;
---

{nouvelles.length > 0 && (
  <section class="nouvelles" id="nouvelles" aria-label="Nouvelles">
    <h2>Nouvelles</h2>
    <div class="liste-nouvelles">
    {nouvelles.map((n) => (
      <article class="nouvelle">
        {n.media ? (
          <img
            src={cheminMedia(n.media, 'vignette')}
            alt={n.media.legende ?? ''}
            width="400"
            height="225"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <span class="sans-image" aria-hidden="true" />
        )}
        <div class="nouvelle-texte">
          <span class="surtitre-nouvelle">
            {surtitreNouvelle(n)} · {dateLongue(n.publieeLe)}
          </span>
          <h3>{n.titre}</h3>
          <p>{n.texte}</p>
        </div>
      </article>
    ))}
    </div>
  </section>
)}

<style>
  .nouvelles {
    display: grid;
    gap: var(--espace-2);
  }
  .liste-nouvelles {
    display: grid;
    gap: var(--espace-3);
  }
  .nouvelle {
    display: flex;
    gap: var(--espace-3);
    padding: var(--espace-3);
    border: 1px solid var(--trait);
    border-radius: var(--rayon-m);
    background: var(--fond-releve);
  }
  img,
  .sans-image {
    flex: none;
    width: 76px;
    height: 76px;
    border-radius: var(--rayon-s);
    background: var(--fond-bande);
    object-fit: cover;
  }
  .nouvelle-texte {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .surtitre-nouvelle {
    color: var(--texte-doux);
    font-size: var(--taille-mention);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  h3 {
    font-family: var(--police-interface);
    font-size: var(--taille-courante);
    overflow-wrap: anywhere;
  }
  p {
    color: var(--texte-doux);
    font-size: var(--taille-secondaire);
    overflow-wrap: anywhere;
  }
  /* Ordinateur (planche) : deux cartes côte à côte, l'image en haut (une teinte unie quand l'école n'en a pas donné). */
  @media (min-width: 64rem) {
    .liste-nouvelles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .nouvelle {
      flex-direction: column;
    }
    img,
    .sans-image {
      width: 100%;
      height: auto;
      aspect-ratio: 3 / 1;
    }
  }
</style>
