---
// Le gabarit des pages publiques : aucun JavaScript, du HTML et du CSS. Le menu du téléphone est un `<details>`.
import './jetons.css';
import './base.css';
import './composants.css';
import './public.css';
import Icone from './Icone.astro';
import Marque from './Marque.astro';
import { HAUTEUR_PARTAGE, IMAGE_PARTAGE_SITE, LARGEUR_PARTAGE } from '../modele/partage';
import { LIEN_A_PROPOS, PAGES_DE_TRANSPARENCE } from '../modele/pages-de-confiance';

interface Props {
  titre: string;
  description: string;
  /** Le lien WhatsApp de NTanova, s'il est configuré (voir src/modele/whatsapp.ts). */
  whatsapp?: string | null;
  /** Une page de renvoi (fiche fusionnée, ancien plan) : l'adresse où aller, sans JavaScript. */
  renvoi?: string;
  /** Une page qu'un moteur de recherche ne garde pas : la page d'un lieu sans école publiée (ticket 146). */
  nonIndexee?: boolean;
  /** L'image que WhatsApp montre sous un lien partagé (ticket 101) : celle de la fiche, sinon celle du site. */
  image?: { chemin: string; alt: string };
  /** Les données structurées de la page (`schema.org`), écrites en JSON-LD : jamais exécutées. */
  donnees?: Record<string, unknown>;
}
const {
  titre,
  description,
  whatsapp = null,
  renvoi,
  nonIndexee = false,
  image = { chemin: IMAGE_PARTAGE_SITE, alt: 'NTanova : les écoles près de chez vous' },
  donnees,
} = Astro.props;
// Les adresses absolues que demandent les aperçus de lien : celles de ntanova.com (`site` d'astro.config.mjs).
const absolue = (chemin: string) => new URL(chemin, Astro.site ?? Astro.url).href;
const canonique = absolue(Astro.url.pathname);
const chemin = Astro.url.pathname;
const surPourLesEcoles = chemin.startsWith('/pour-les-ecoles');
// Les anciennes portes (rechercher, autour de moi, formations) renvoient vers « Écoles » (`public/_redirects`).
const surEcoles = chemin.startsWith('/ecoles');
const surCarte = chemin.startsWith('/carte/');
// Les quatre entrées du site (décision du fondateur du 08/11/2026, ticket 146) : des choses, pas des outils. Rechercher, Autour
// de moi et les formations sont des filtres de la page « Écoles ». La navigation du haut (à partir de 48 rem) et le menu du
// téléphone les écrivent toutes deux.
const portes = [
  { href: '/ecoles/', texte: 'Écoles', courante: surEcoles },
  { href: '/carte/', texte: 'Carte', courante: surCarte },
  { href: '/pour-les-ecoles/', texte: 'Pour les écoles', courante: surPourLesEcoles },
  { href: LIEN_A_PROPOS, texte: 'À propos', courante: chemin.startsWith(LIEN_A_PROPOS) },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    {renvoi && (
      <>
        <meta http-equiv="refresh" content={`0; url=${renvoi}`} />
        <link rel="canonical" href={renvoi} />
      </>
    )}
    {(renvoi || nonIndexee) && <meta name="robots" content="noindex" />}
    {!renvoi && <link rel="canonical" href={canonique} />}
    <meta property="og:site_name" content="NTanova" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content={donnees ? 'article' : 'website'} />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={absolue(image.chemin)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(LARGEUR_PARTAGE)} />
    <meta property="og:image:height" content={String(HAUTEUR_PARTAGE)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    {donnees && <script type="application/ld+json" set:html={JSON.stringify(donnees)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/polices/nunito-sans-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body data-page={surCarte ? 'carte' : undefined}>
    <header class="entete">
      <div class="cadre entete-cadre">
        <div class="identite">
          <a class="lien-marque" href="/">
            <Marque taille={28} />
            <span>NTanova</span>
          </a>
          {/* Le pays s'ouvre et dit que NTanova recense pour le moment le seul Congo-Brazzaville, sans rien promettre d'autre
              (décision du fondateur du 08/11/2026, ticket 146 ; il était une simple étiquette depuis l'audit du 05/11, D13). Un
              `<details>` : aucun JavaScript. */}
          <details class="pays">
            <summary class="ville">
              <Icone nom="globe" />
              Congo-Brazzaville
              <Icone nom="bas" />
            </summary>
            <div class="pays-bulle">
              <p class="pays-titre">Pays</p>
              <p class="pays-choisi">
                Congo-Brazzaville
                <Icone nom="coche" />
              </p>
              <p>
                Pour le moment, NTanova recense les écoles du Congo-Brazzaville, ville après ville.
              </p>
            </div>
          </details>
        </div>
        <div class="entete-droite">
          {/* La navigation du haut n'existe qu'à partir de 48 rem ; sur téléphone, le menu l'ouvre (et le pied la répète). */}
          <nav aria-label="Navigation principale" class="nav-haut">
            {portes.map((p) => (
              <a href={p.href} aria-current={p.courante ? 'page' : undefined}>
                {p.texte}
              </a>
            ))}
          </nav>
          {/* Sans JavaScript : un `<details>`. Le panneau passe sous l'en-tête, sur toute sa largeur. */}
          <details class="menu-tel">
            <summary class="menu-bouton">
              <span class="menu-icone menu-icone-ferme">
                <Icone nom="menu" petite={false} />
              </span>
              <span class="menu-icone menu-icone-ouvert">
                <Icone nom="croix" petite={false} />
              </span>
              Menu
            </summary>
            <nav aria-label="Menu principal" class="menu-liens">
              {portes.map((p) => (
                <a href={p.href} aria-current={p.courante ? 'page' : undefined}>
                  {p.texte}
                </a>
              ))}
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main class="contenu">
      <slot />
    </main>
    <footer class="pied">
      <div class="cadre pied-cadre">
        <nav aria-label="NTanova" class="pied-liens">
          <div class="pied-groupe">
            <p class="pied-titre" id="pied-trouver">
              Trouver une école
            </p>
            <ul aria-labelledby="pied-trouver">
              <li>
                <a href="/ecoles/">Les écoles</a>
              </li>
              <li>
                <a href="/carte/">Carte</a>
              </li>
            </ul>
          </div>
          <div class="pied-groupe">
            <p class="pied-titre" id="pied-ntanova">
              NTanova
            </p>
            <ul aria-labelledby="pied-ntanova">
              <li>
                <a href="/pour-les-ecoles/">Pour les écoles</a>
              </li>
              <li>
                <a href={LIEN_A_PROPOS}>À propos</a>
              </li>
              {whatsapp && (
                <li>
                  <a href={whatsapp}>Écrire à NTanova sur WhatsApp</a>
                </li>
              )}
            </ul>
          </div>
          {/* Les pages qu'une administration, une direction ou une famille lit pour savoir à qui elle a affaire (ticket 149). */}
          <div class="pied-groupe pied-groupe-transparence">
            <p class="pied-titre" id="pied-transparence">
              Transparence
            </p>
            <ul aria-labelledby="pied-transparence">
              {PAGES_DE_TRANSPARENCE.map((p) => (
                <li>
                  <a href={p.href}>{p.texte}</a>
                </li>
              ))}
            </ul>
          </div>
        </nav>
        <p>NTanova · République du Congo</p>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Le panneau du menu s'ouvre sous l'en-tête et passe au-dessus de la page (la carte, ses commandes). */
  .entete {
    position: relative;
    z-index: 30;
  }
  .entete-cadre {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--espace-3);
    padding-block: var(--espace-3);
  }
  .entete-droite {
    display: flex;
    align-items: center;
    gap: var(--espace-5);
  }
  .nav-haut {
    display: none;
  }
  /* Sur téléphone, la marque et, juste dessous, le pays. */
  .identite {
    display: grid;
    gap: 0;
    min-width: 0;
  }
  /* Le pays n'est pas une porte : du texte posé, sans trait ni fond, qui ne ressemble pas à un bouton. */
  .ville {
    margin-top: calc(var(--espace-1) * -1);
    color: var(--texte-doux);
    font-family: var(--police-titre);
    font-size: var(--taille-mention);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  /* Le pays (ticket 146) : sur téléphone sous la marque, sa bulle sous l'en-tête ; un petit texte, mais une cible de 32 px. */
  .pays > summary {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--espace-1);
    min-height: 2rem;
    list-style: none;
    cursor: pointer;
  }
  /* Une cible de 44 px pour le doigt, sans grandir l'en-tête : la zone touchable déborde du texte. */
  .pays > summary::after {
    content: '';
    position: absolute;
    inset: -6px -8px;
  }
  .pays > summary::-webkit-details-marker {
    display: none;
  }
  .pays > summary :global(svg) {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pays[open] > summary :global(svg:last-child) {
    transform: rotate(180deg);
  }
  .pays > summary:focus-visible {
    outline: var(--epaisseur-focus) solid var(--focus);
    outline-offset: 2px;
    border-radius: var(--rayon-s);
  }
  .pays-bulle {
    position: absolute;
    top: 100%;
    left: var(--espace-4);
    right: var(--espace-4);
    z-index: 1;
    display: grid;
    gap: var(--espace-2);
    max-width: 20rem;
    padding: var(--espace-4);
    border-radius: var(--rayon-m);
    background: var(--fond-releve);
    box-shadow: var(--ombre-flottante);
    color: var(--texte);
    font-size: var(--taille-secondaire);
  }
  .pays-bulle p {
    margin: 0;
  }
  .pays-titre {
    color: var(--texte-doux);
    font-family: var(--police-titre);
    font-size: var(--taille-mention);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pays-choisi {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--espace-2);
    min-height: var(--cible-min);
    padding: 0 var(--espace-3);
    border: 2px solid var(--marque);
    border-radius: var(--rayon-s);
    background: var(--vert-pale);
    color: var(--marque-appuyee);
    font-family: var(--police-titre);
    font-weight: 700;
  }
  .pays-choisi :global(svg) {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Sur la carte, au téléphone : l'en-tête se réduit et le pays se cache, pour laisser la place à la carte entre les filtres
     et le tiroir (arbitrage du fondateur du 08/11/2026, ticket 146). */
  @media (max-width: 47.99rem) {
    [data-page='carte'] .pays {
      display: none;
    }
    [data-page='carte'] .entete-cadre {
      padding-block: var(--espace-1);
    }
    [data-page='carte'] .menu-bouton {
      min-height: var(--cible-min);
    }
  }
  .menu-bouton {
    display: inline-flex;
    align-items: center;
    gap: var(--espace-2);
    min-height: var(--cible-principale);
    padding: 0 var(--espace-4);
    border: 2px solid var(--marque);
    border-radius: var(--rayon-pilule);
    background: var(--fond-releve);
    color: var(--marque);
    font-family: var(--police-titre);
    font-size: var(--taille-courante);
    font-weight: 700;
    list-style: none;
    cursor: pointer;
  }
  .menu-bouton::-webkit-details-marker {
    display: none;
  }
  .menu-bouton:hover,
  .menu-tel[open] .menu-bouton {
    background: var(--vert-pale);
    color: var(--marque-appuyee);
  }
  .menu-bouton:focus-visible {
    outline: var(--epaisseur-focus) solid var(--focus);
    outline-offset: 2px;
  }
  .menu-icone :global(svg) {
    display: block;
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .menu-icone-ouvert,
  .menu-tel[open] .menu-icone-ferme {
    display: none;
  }
  .menu-tel[open] .menu-icone-ouvert {
    display: block;
  }
  .menu-liens {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: grid;
    padding: var(--espace-2) var(--espace-4) var(--espace-4);
    border-bottom: 1px solid var(--trait);
    background: var(--fond-releve);
    box-shadow: var(--ombre-flottante);
  }
  .menu-liens a {
    display: flex;
    align-items: center;
    min-height: var(--cible-principale);
    border-bottom: 1px solid var(--trait);
    color: var(--texte);
    font-family: var(--police-titre);
    font-size: var(--taille-intertitre);
    font-weight: 700;
    text-decoration: none;
  }
  .menu-liens a:last-child {
    border-bottom: 0;
  }
  .menu-liens a[aria-current='page'] {
    color: var(--marque);
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.35em;
  }
  .lien-marque {
    display: inline-flex;
    align-items: center;
    gap: var(--espace-2);
    min-height: var(--cible-min);
    color: var(--texte);
    font-family: var(--police-titre);
    font-size: var(--taille-intertitre);
    font-weight: 700;
    text-decoration: none;
  }
  .pied {
    border-top: 1px solid var(--trait);
    color: var(--texte-doux);
    font-size: var(--taille-secondaire);
  }
  .pied-cadre {
    display: grid;
    gap: var(--espace-3);
    padding-block: var(--espace-6);
  }
  .pied p {
    margin: 0;
  }
  /* Deux groupes côte à côte sur téléphone (≈ 180 px de haut au lieu de ≈ 310 px), l'un sous l'autre sous 22 rem. */
  .pied-liens {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--espace-3) var(--espace-4);
  }
  @media (max-width: 21.99rem) {
    .pied-liens {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .pied-groupe {
    display: grid;
    align-content: start;
  }
  /* Le groupe « Transparence » (ticket 149) prend toute la largeur sous les deux autres, ses quatre liens sur deux colonnes. */
  .pied-groupe-transparence {
    grid-column: 1 / -1;
  }
  .pied-groupe-transparence ul {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (max-width: 21.99rem) {
    .pied-groupe-transparence ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .pied-titre {
    color: var(--texte-doux);
    font-family: var(--police-titre);
    font-size: var(--taille-mention);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pied ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pied-liens a {
    display: flex;
    align-items: center;
    min-height: var(--cible-min);
    color: var(--marque);
    font-weight: 700;
  }

  /* Sur tablette, la navigation a sa ligne : une police de repli plus large ne pousse pas le pays hors du cadre. */
  @media (min-width: 48rem) {
    .entete {
      border-bottom: 1px solid var(--trait);
    }
    .entete-cadre {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--espace-2) var(--espace-3);
      min-height: 4.75rem;
      padding-block: var(--espace-3);
    }
    .entete-droite,
    .identite {
      display: contents;
    }
    .menu-tel {
      display: none;
    }
    .lien-marque {
      grid-column: 1;
      grid-row: 1;
      justify-self: start;
      gap: var(--espace-3);
      font-size: var(--taille-titre-fiche);
    }
    .lien-marque :global(.marque) {
      width: auto;
      height: 2.25rem;
    }
    .nav-haut {
      grid-column: 1 / -1;
      grid-row: 2;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--espace-4);
    }
    .nav-haut a {
      display: inline-flex;
      align-items: center;
      min-height: var(--cible-min);
      padding-inline: var(--espace-2);
      color: var(--texte);
      font-family: var(--police-titre);
      font-weight: 700;
      text-decoration: none;
    }
    .nav-haut a:hover {
      color: var(--marque);
      text-decoration: underline;
      text-underline-offset: 0.35em;
    }
    .nav-haut a[aria-current='page'] {
      text-decoration: underline;
      text-decoration-thickness: 3px;
      text-underline-offset: 0.35em;
    }
    .pays {
      position: relative;
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
    }
    .ville {
      margin-top: 0;
      font-size: var(--taille-secondaire);
    }
    .pays > summary {
      min-height: var(--cible-min);
      padding: 0 var(--espace-3);
      border: 2px solid var(--trait);
      border-radius: var(--rayon-pilule);
    }
    .pays[open] > summary {
      border-color: var(--marque);
      background: var(--vert-pale);
      color: var(--marque-appuyee);
    }
    .pays-bulle {
      top: calc(100% + var(--espace-2));
      left: auto;
      right: 0;
      width: 20rem;
    }
    /* Les deux groupes l'un sous l'autre, titres et liens alignés à gauche, le bloc à droite de la phrase. */
    .pied-liens {
      display: grid;
      grid-template-columns: minmax(0, auto);
      justify-items: start;
      justify-self: end;
      gap: var(--espace-3);
    }
    .pied ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0 var(--espace-5);
    }
  }

  /* À partir de 64 rem : la phrase à gauche, les liens à droite. */
  @media (min-width: 64rem) {
    .entete-cadre {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }
    .nav-haut {
      grid-column: 2;
      grid-row: 1;
      justify-content: flex-end;
    }
    .pays {
      grid-column: 3;
    }
    /* La phrase garde sa place et ne se casse pas en trois lignes : ce sont les liens qui se partagent le reste. */
    .pied-cadre {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas: 'phrase liens';
      align-items: center;
      gap: var(--espace-5);
    }
    .pied-cadre > p {
      grid-area: phrase;
      white-space: nowrap;
    }
    .pied-liens {
      grid-area: liens;
      justify-content: flex-end;
    }
  }
</style>
