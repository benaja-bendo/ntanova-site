---
// Le gabarit des pages publiques : aucun JavaScript, du HTML et du CSS.
//
// Refonte publique, lot 1 (24/11/2026 ; canevas « Accueil : trois directions », exploration « Points de repère », lancement
// du fondateur qui accepte les cinq choix du lot) :
// - l'en-tête est vert sur toutes les pages : la marque, les trois entrées Trouver une école · S'orienter · Pour les écoles,
//   puis le pays. Sur téléphone, un bouton « Menu » les ouvre : un `<details>`, sans script, au clavier comme au doigt (il
//   remplace les trois piliers toujours visibles du 15/11). « Pour les écoles » remplace « Espace écoles » ; l'adresse
//   `/pour-les-ecoles/` ne change pas ;
// - le pied : quatre groupes (Chercher, Pour les écoles, Comprendre nos informations, NTanova), sans lien vers une page qui
//   n'existe pas encore : écrire et signaler passent par WhatsApp jusqu'aux formulaires du lot 3, « Ajouter mon école » mène à
//   la page des écoles comme sur les pages de lieu ; « Outils en préparation » (lot 5, 25/11) ouvre une présentation, jamais un
//   logiciel ; on ne dit jamais « toutes les écoles ». Lot 4 (24/11) : « Toutes les villes » (`/villes/`) remplace la liste des villes, comme la planche ;
//   chaque ville reste à un geste, et le pied ne grandit plus avec l'annuaire.
// Le logo reste celui de la charte (les trois barres et leur contour, 30/10).
import { PUBLIC_WHATSAPP } from 'astro:env/client';
import './jetons.css';
import './base.css';
import './composants.css';
import './public.css';
import jetons from './jetons.css?raw';
import Icone from './Icone.astro';
import Marque from './Marque.astro';
import { ICONES_SITE } from '../modele/icones';
import { HAUTEUR_PARTAGE, IMAGE_PARTAGE_SITE, LARGEUR_PARTAGE } from '../modele/partage';
import {
  LIEN_A_PROPOS,
  LIEN_CONFIDENTIALITE,
  LIEN_DONNEES,
  LIEN_MENTIONS_LEGALES,
  LIEN_METHODE,
  PAGES_DE_TRANSPARENCE,
} from '../modele/pages-de-confiance';
import { lireJeton } from '../modele/carte/jetons';
import { jourDuCongo } from '../modele/date-declaration';
import { dateCourte } from '../modele/pointe-noire';
import { porte } from '../modele/liens-demandes';
import { LIEN_OUTILS } from '../modele/services-ecoles';
import { LIEN_VILLES } from '../modele/villes';
import { avecMessage, lienWhatsApp } from '../modele/whatsapp';
import { formulairesOuverts } from './formulaires/ouverture';

interface Props {
  titre: string;
  description: string;
  /** Le lien WhatsApp de NTanova, s'il est configuré (voir src/modele/whatsapp.ts) ; sinon celui de la configuration. */
  whatsapp?: string | null;
  /** Une page de renvoi (fiche fusionnée, ancien plan) : l'adresse où aller, sans JavaScript. */
  renvoi?: string;
  /** Une page qu'un moteur de recherche ne garde pas : la page d'un lieu sans école publiée (ticket 146), la démonstration. */
  nonIndexee?: boolean;
  /** L'image que WhatsApp montre sous un lien partagé (ticket 101) : celle de la fiche, sinon celle du site. */
  image?: { chemin: string; alt: string };
  /** Les données structurées de la page (`schema.org`), écrites en JSON-LD : jamais exécutées. */
  donnees?: Record<string, unknown>;
  /** Le type Open Graph : `article` pour une page qui décrit une école, `website` sinon (l'accueil a des données, lot 1). */
  typeOg?: 'website' | 'article';
}
const {
  titre,
  description,
  whatsapp = lienWhatsApp(PUBLIC_WHATSAPP, 'Bonjour NTanova, '),
  renvoi,
  nonIndexee = false,
  image = { chemin: IMAGE_PARTAGE_SITE, alt: 'NTanova : les écoles près de chez vous' },
  donnees,
  typeOg = donnees ? 'article' : 'website',
} = Astro.props;
// Les adresses absolues que demandent les aperçus de lien : celles de ntanova.com (`site` d'astro.config.mjs).
const absolue = (chemin: string) => new URL(chemin, Astro.site ?? Astro.url).href;
const canonique = absolue(Astro.url.pathname);
const chemin = Astro.url.pathname;
// Les trois entrées : des choses que cherche le visiteur, pas des outils. « Trouver une école », c'est l'accueil, la liste,
// les lieux, les fiches et la carte : il mène à la liste, `/ecoles/` (fondateur, 16/11), et reste allumé sur l'accueil.
const entrees = [
  {
    href: '/ecoles/',
    texte: 'Trouver une école',
    courant: chemin === '/' || chemin.startsWith('/ecoles'),
  },
  { href: '/orienter/', texte: 'S’orienter', courant: chemin.startsWith('/orienter') },
  {
    href: '/pour-les-ecoles/',
    texte: 'Pour les écoles',
    courant: chemin.startsWith('/pour-les-ecoles'),
  },
];
// Le pied : la date du jour où l'annuaire a été construit.
const misAJourLe = dateCourte(jourDuCongo());
// Lot 3C : fermés, les formulaires laissent ces trois portes où elles sont (WhatsApp, la page des écoles).
const signaler = porte(
  formulairesOuverts,
  { vers: 'erreur', depuis: 'pied' },
  avecMessage(whatsapp, 'Bonjour NTanova, une erreur sur une fiche : '),
);
const ecrire = porte(formulairesOuverts, { vers: 'contact', depuis: 'pied' }, whatsapp);
const ajouter = porte(
  formulairesOuverts,
  { vers: 'manque', depuis: 'pied' },
  '/pour-les-ecoles/#referencer',
);
const pageDe = (href: string) => PAGES_DE_TRANSPARENCE.find((p) => p.href === href)!.texte;
// Lot A (26/11/2026) : sur Android, la barre du navigateur prend la couleur de l'en-tête, lue dans les jetons à la construction.
// Le site n'a qu'un thème, clair ; l'en-tête est vert dans les deux réglages du téléphone : une seule valeur.
const couleurDeLaBarre = lireJeton(jetons, 'fond-entete');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={couleurDeLaBarre} />
    <title>{titre}</title>
    <meta name="description" content={description} />
    {renvoi && (
      <>
        <meta http-equiv="refresh" content={`0; url=${renvoi}`} />
        <link rel="canonical" href={renvoi} />
      </>
    )}
    {(renvoi || nonIndexee) && <meta name="robots" content="noindex" />}
    {!renvoi && <link rel="canonical" href={canonique} />}
    <meta property="og:site_name" content="NTanova" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content={typeOg} />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={absolue(image.chemin)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(LARGEUR_PARTAGE)} />
    <meta property="og:image:height" content={String(HAUTEUR_PARTAGE)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    {donnees && <script type="application/ld+json" set:html={JSON.stringify(donnees)} />}
    {ICONES_SITE.map((icone) => (
      <link {...icone} />
    ))}
    <link
      rel="preload"
      href="/polices/nunito-sans-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <header class="entete sur-marque">
      <div class="cadre entete-cadre">
        <a class="lien-marque" href="/">
          <Marque taille={21} />
          <span>NTanova</span>
        </a>
        <nav aria-label="Navigation principale" class="entrees">
          {entrees.map((e) => (
            <a href={e.href} aria-current={e.courant ? 'page' : undefined}>
              {e.texte}
            </a>
          ))}
        </nav>
        {/* Le pays s'ouvre et dit que NTanova recense pour le moment le seul Congo-Brazzaville, sans rien promettre d'autre
            (décision du fondateur du 08/11/2026, ticket 146). Un `<details>` : aucun JavaScript. */}
        <details class="pays">
          <summary class="ville">
            <Icone nom="globe" />
            Congo-Brazzaville
            <Icone nom="bas" />
          </summary>
          <div class="pays-bulle">
            <p class="pays-titre">Pays</p>
            <p class="pays-choisi">
              Congo-Brazzaville
              <Icone nom="coche" />
            </p>
            <p>
              Pour le moment, NTanova recense les écoles du Congo-Brazzaville, ville après ville.
            </p>
          </div>
        </details>
        {/* Le menu du téléphone : un `<details>` ; son bouton dit « Menu », puis « Fermer ». Rien n'y est caché qui ne soit
            ailleurs : les trois entrées, et le pays. */}
        <details class="menu">
          <summary class="menu-bouton">
            <span class="menu-ouvrir">
              <Icone nom="menu" />
              Menu
            </span>
            <span class="menu-fermer">
              <Icone nom="croix" />
              Fermer
            </span>
          </summary>
          <div class="menu-panneau">
            <nav aria-label="Navigation principale" class="menu-entrees">
              {entrees.map((e) => (
                <a href={e.href} aria-current={e.courant ? 'page' : undefined}>
                  {e.texte}
                  <Icone nom="suite" />
                </a>
              ))}
            </nav>
            <p class="menu-pays">
              Congo-Brazzaville. Pour le moment, NTanova recense les écoles du Congo-Brazzaville,
              ville après ville.
            </p>
          </div>
        </details>
      </div>
    </header>
    <main class="contenu">
      <slot />
    </main>
    <footer class="pied">
      <div class="cadre pied-cadre">
        <div class="pied-grille">
          <div class="pied-marque">
            <p class="pied-nom">
              <Marque taille={20} />
              NTanova
            </p>
            <p class="pied-phrase">
              Les écoles du Congo-Brazzaville. Des informations datées, avec leur origine.
            </p>
          </div>
          {/* Une seule navigation : chaque liste porte le nom de son groupe. */}
          <nav aria-label="NTanova" class="pied-liens">
            <div class="pied-groupe">
              <p class="pied-titre" id="pied-chercher">
                Chercher
              </p>
              <ul aria-labelledby="pied-chercher">
                <li>
                  <a href="/ecoles/">Les écoles</a>
                </li>
                <li>
                  <a href={LIEN_VILLES}>Toutes les villes</a>
                </li>
                <li>
                  <a href="/orienter/">S’orienter</a>
                </li>
              </ul>
            </div>
            <div class="pied-groupe">
              <p class="pied-titre" id="pied-ecoles">
                Pour les écoles
              </p>
              <ul aria-labelledby="pied-ecoles">
                <li>
                  <a href="/pour-les-ecoles/">Présenter mon école</a>
                </li>
                <li>
                  <a href={LIEN_OUTILS}>Outils en préparation</a>
                </li>
                <li>
                  {/* La même porte que les pages de lieu : la page dit comment ajouter son école. */}
                  <a href={ajouter!.href}>Ajouter mon école</a>
                </li>
              </ul>
            </div>
            <div class="pied-groupe">
              <p class="pied-titre" id="pied-comprendre">
                Comprendre nos informations
              </p>
              <ul aria-labelledby="pied-comprendre">
                <li>
                  <a href={LIEN_METHODE}>{pageDe(LIEN_METHODE)}</a>
                </li>
                <li>
                  <a href={LIEN_DONNEES}>{pageDe(LIEN_DONNEES)}</a>
                </li>
                {signaler && (
                  <li>
                    <a href={signaler.href}>Signaler une erreur</a>
                  </li>
                )}
              </ul>
            </div>
            <div class="pied-groupe">
              <p class="pied-titre" id="pied-ntanova">
                NTanova
              </p>
              <ul aria-labelledby="pied-ntanova">
                <li>
                  <a href={LIEN_A_PROPOS}>À propos</a>
                </li>
                {ecrire && (
                  <li>
                    <a href={ecrire.href}>
                      {ecrire.parFormulaire ? 'Contact' : 'Écrire à NTanova sur WhatsApp'}
                    </a>
                  </li>
                )}
                <li>
                  <a href={LIEN_CONFIDENTIALITE}>{pageDe(LIEN_CONFIDENTIALITE)}</a>
                </li>
                <li>
                  <a href={LIEN_MENTIONS_LEGALES}>{pageDe(LIEN_MENTIONS_LEGALES)}</a>
                </li>
              </ul>
            </div>
          </nav>
        </div>
        <div class="pied-bas">
          <p>NTanova · Congo-Brazzaville</p>
          <p>Annuaire mis à jour le {misAJourLe}</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  /* L'en-tête vert de toutes les pages publiques (canevas « Points de repère », 23/11) : on navigue. La bulle du pays et le
     menu s'ouvrent dessous et passent au-dessus de la page (la carte, ses commandes). */
  .entete {
    position: relative;
    z-index: 30;
    background: var(--fond-entete);
    color: var(--texte-sur-marque);
  }
  .entete-cadre {
    display: flex;
    align-items: center;
    gap: var(--espace-4);
    min-height: 4rem;
  }
  .lien-marque {
    display: inline-flex;
    align-items: center;
    gap: var(--espace-2);
    min-height: var(--cible-min);
    color: var(--texte-sur-marque);
    font-family: var(--police-titre);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
  }
  .lien-marque:focus-visible,
  .entrees a:focus-visible,
  .menu-bouton:focus-visible,
  .menu-entrees a:focus-visible,
  .pays > summary:focus-visible {
    outline: var(--epaisseur-focus) solid var(--focus);
    outline-offset: 2px;
    border-radius: var(--rayon-xs);
  }

  /* Les trois entrées, à partir de la tablette ; l'entrée courante soulignée de jaune. */
  .entrees {
    display: none;
  }
  .entrees a {
    display: flex;
    align-items: center;
    min-height: var(--cible-min);
    color: var(--texte-sur-marque);
    font-family: var(--police-interface);
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .entrees a[aria-current='page'] {
    box-shadow: inset 0 -3px 0 var(--accent);
  }
  @media (hover: hover) {
    .entrees a:hover {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }

  /* Le pays n'est pas une porte : du texte posé, sans trait ni fond. */
  .pays {
    display: none;
    position: relative;
    margin-left: auto;
  }
  .ville {
    color: var(--texte-sur-marque);
    font-family: var(--police-interface);
    font-size: var(--taille-secondaire);
    font-weight: 700;
  }
  .pays > summary {
    position: relative;
    display: flex;
    white-space: nowrap;
    align-items: center;
    gap: var(--espace-1);
    min-height: var(--cible-min);
    list-style: none;
    cursor: pointer;
  }
  .pays > summary::-webkit-details-marker,
  .menu > summary::-webkit-details-marker {
    display: none;
  }
  .pays > summary :global(svg),
  .menu-bouton :global(svg),
  .menu-entrees :global(svg) {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pays[open] > summary :global(svg:last-child) {
    transform: rotate(180deg);
  }
  .pays-bulle {
    position: absolute;
    top: 100%;
    right: 0;
    z-index: 1;
    display: grid;
    gap: var(--espace-2);
    width: 20rem;
    padding: var(--espace-4);
    border-radius: var(--rayon-m);
    background: var(--fond-releve);
    box-shadow: var(--ombre-flottante);
    color: var(--texte);
    font-size: var(--taille-secondaire);
  }
  .pays-bulle p {
    margin: 0;
  }
  .pays-titre {
    color: var(--texte-doux);
    font-family: var(--police-interface);
    font-size: var(--taille-mention);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pays-choisi {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--espace-2);
    min-height: var(--cible-min);
    padding: 0 var(--espace-3);
    border: 2px solid var(--marque);
    border-radius: var(--rayon-s);
    background: var(--vert-pale);
    color: var(--marque-appuyee);
    font-family: var(--police-interface);
    font-weight: 700;
  }
  .pays-choisi :global(svg) {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Le menu du téléphone : un bouton en contour, puis un panneau vert sous l'en-tête, une ligne de 52 px par entrée. */
  .menu {
    margin-left: auto;
  }
  .menu-bouton {
    display: flex;
    align-items: center;
    min-height: var(--cible-min);
    padding: 0 var(--espace-3);
    border: 2px solid var(--texte-sur-marque);
    border-radius: var(--rayon-s);
    font-family: var(--police-interface);
    font-weight: 700;
    list-style: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  /* L'appui (lot A, 26/11) : le bouton s'éclaircit d'un vert, la crème reste lisible (7,2:1). */
  .menu-bouton:active {
    background: var(--marque);
  }
  .menu-ouvrir,
  .menu-fermer {
    display: inline-flex;
    align-items: center;
    gap: var(--espace-2);
  }
  .menu-fermer,
  .menu[open] .menu-ouvrir {
    display: none;
  }
  .menu[open] .menu-fermer {
    display: inline-flex;
  }
  .menu-panneau {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: grid;
    gap: var(--espace-4);
    padding: var(--espace-2) var(--espace-4) var(--espace-5);
    border-top: 1px solid var(--vert);
    background: var(--marque-appuyee);
    box-shadow: var(--ombre-flottante);
  }
  .menu-entrees {
    display: grid;
  }
  .menu-entrees a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.25rem;
    border-bottom: 1px solid var(--vert);
    color: var(--texte-sur-marque);
    font-family: var(--police-interface);
    font-size: 1.125rem;
    font-weight: 700;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }
  .menu-entrees a[aria-current='page'] {
    color: var(--accent);
  }
  .menu-entrees a:active {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .menu-pays {
    margin: 0;
    color: var(--vert-pale);
    font-size: var(--taille-secondaire);
  }

  @media (min-width: 48rem) {
    .entete-cadre {
      gap: 28px;
      min-height: 4.5rem;
    }
    .lien-marque {
      gap: 10px;
      font-size: 1.375rem;
    }
    .lien-marque :global(.marque) {
      width: 32px;
      height: 24px;
    }
    .entrees {
      display: flex;
      gap: var(--espace-4);
    }
    .entrees a {
      font-size: 0.9375rem;
    }
    .pays {
      display: block;
    }
    .menu {
      display: none;
    }
  }
  @media (min-width: 64rem) {
    .entrees {
      gap: 28px;
    }
    .entrees a {
      font-size: 1rem;
    }
  }

  /* Le pied de page : fond clair, la marque, quatre groupes de liens, la date de l'annuaire. */
  .pied {
    border-top: 1px solid var(--trait);
    background: var(--fond-releve);
    font-size: 0.9375rem;
  }
  .pied p {
    margin: 0;
  }
  .pied-cadre {
    display: grid;
    gap: 20px;
    padding-top: var(--espace-5);
    padding-bottom: var(--espace-5);
  }
  .pied-grille {
    display: grid;
    gap: var(--espace-5);
  }
  .pied-marque {
    display: grid;
    gap: var(--espace-2);
    max-width: 300px;
  }
  /* Deux groupes par ligne au téléphone ; quatre colonnes sur ordinateur. */
  .pied-liens {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--espace-5) var(--espace-4);
  }
  .pied-nom {
    display: flex;
    align-items: center;
    gap: var(--espace-2);
    font-family: var(--police-titre);
    font-size: var(--taille-intertitre);
    font-weight: 700;
  }
  .pied-phrase {
    color: var(--texte-doux);
    font-size: var(--taille-secondaire);
  }
  .pied-groupe {
    display: grid;
    align-content: start;
    gap: 6px;
    min-width: 0;
  }
  .pied-titre {
    color: var(--texte-doux);
    font-family: var(--police-interface);
    font-size: var(--taille-mention);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pied-groupe ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Chaque lien possède ses 44 px, à la souris comme au doigt : aucune cible ne couvre celle du lien suivant. */
  .pied-groupe a {
    display: flex;
    align-items: center;
    min-height: var(--cible-min);
    width: fit-content;
    max-width: 100%;
    color: var(--marque);
    font-weight: 700;
  }
  .pied-bas {
    display: grid;
    gap: 2px;
    padding-top: 14px;
    border-top: 1px solid var(--trait);
    color: var(--texte-doux);
    font-size: 0.8125rem;
  }
  @media (min-width: 48rem) {
    .pied-cadre {
      gap: 28px;
      padding-top: var(--espace-6);
    }
    .pied-bas {
      display: flex;
      justify-content: space-between;
