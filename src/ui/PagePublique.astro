---
// Le gabarit des pages publiques : aucun JavaScript, du HTML et du CSS.
import './jetons.css';
import './base.css';
import './composants.css';
import './public.css';
import Marque from './Marque.astro';
import { HAUTEUR_PARTAGE, IMAGE_PARTAGE_SITE, LARGEUR_PARTAGE } from '../modele/partage';

interface Props {
  titre: string;
  description: string;
  /** Le lien WhatsApp de NTanova, s'il est configuré (voir src/modele/whatsapp.ts). */
  whatsapp?: string | null;
  /** Une page de renvoi (fiche fusionnée) : l'adresse où aller, sans JavaScript. */
  renvoi?: string;
  /** L'image que WhatsApp montre sous un lien partagé (ticket 101) : celle de la fiche, sinon celle du site. */
  image?: { chemin: string; alt: string };
  /** Les données structurées de la page (`schema.org`), écrites en JSON-LD : jamais exécutées. */
  donnees?: Record<string, unknown>;
}
const {
  titre,
  description,
  whatsapp = null,
  renvoi,
  image = { chemin: IMAGE_PARTAGE_SITE, alt: 'NTanova : les écoles près de chez vous' },
  donnees,
} = Astro.props;
// Les adresses absolues que demandent les aperçus de lien : celles de ntanova.com (`site` d'astro.config.mjs).
const absolue = (chemin: string) => new URL(chemin, Astro.site ?? Astro.url).href;
const canonique = absolue(Astro.url.pathname);
const chemin = Astro.url.pathname;
const surPourLesEcoles = chemin.startsWith('/pour-les-ecoles');
const surEcoles =
  chemin.startsWith('/ecoles') || chemin.startsWith('/cartes') || chemin.startsWith('/formations');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    {renvoi && (
      <>
        <meta http-equiv="refresh" content={`0; url=${renvoi}`} />
        <link rel="canonical" href={renvoi} />
        <meta name="robots" content="noindex" />
      </>
    )}
    {!renvoi && <link rel="canonical" href={canonique} />}
    <meta property="og:site_name" content="NTanova" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content={donnees ? 'article' : 'website'} />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={absolue(image.chemin)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(LARGEUR_PARTAGE)} />
    <meta property="og:image:height" content={String(HAUTEUR_PARTAGE)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    {donnees && <script type="application/ld+json" set:html={JSON.stringify(donnees)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/polices/nunito-sans-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <header class="entete">
      <div class="cadre entete-cadre">
        <a class="lien-marque" href="/">
          <Marque taille={28} />
          <span>NTanova</span>
        </a>
        <div class="entete-droite">
          {/* La navigation du haut n'existe qu'à partir de 48 rem : sur téléphone, le pied la porte. */}
          <nav aria-label="Navigation principale" class="nav-haut">
            <a href="/carte/" aria-current={chemin.startsWith('/carte/') ? 'page' : undefined}>
              Carte
            </a>
            <a href="/ecoles/" aria-current={surEcoles ? 'page' : undefined}>
              Les écoles
            </a>
            <a
              href="/recherche/"
              aria-current={chemin.startsWith('/recherche') ? 'page' : undefined}
            >
              Rechercher
            </a>
            <a
              href="/autour-de-moi/"
              aria-current={chemin.startsWith('/autour-de-moi') ? 'page' : undefined}
            >
              Autour de moi
            </a>
            <a href="/pour-les-ecoles/" aria-current={surPourLesEcoles ? 'page' : undefined}>
              Pour les écoles
            </a>
          </nav>
          <span class="ville">Congo-Brazzaville</span>
        </div>
      </div>
    </header>
    <main class="contenu">
      <slot />
    </main>
    <footer class="pied">
      <div class="cadre pied-cadre">
        <nav aria-label="NTanova" class="pied-liens">
          <div class="pied-groupe">
            <p class="pied-titre" id="pied-trouver">
              Trouver une école
            </p>
            <ul aria-labelledby="pied-trouver">
              <li>
                <a href="/carte/">Carte</a>
              </li>
              <li>
                <a href="/ecoles/">Les écoles</a>
              </li>
              <li>
                <a href="/recherche/">Rechercher une école</a>
              </li>
              <li>
                <a href="/autour-de-moi/">Autour de moi</a>
              </li>
            </ul>
          </div>
          <div class="pied-groupe">
            <p class="pied-titre" id="pied-ntanova">
              NTanova
            </p>
            <ul aria-labelledby="pied-ntanova">
              <li>
                <a href="/pour-les-ecoles/">Pour les écoles</a>
              </li>
              <li>
                <a href="/a-propos/">À propos et données personnelles</a>
              </li>
              {whatsapp && (
                <li>
                  <a href={whatsapp}>Écrire à NTanova sur WhatsApp</a>
                </li>
              )}
            </ul>
          </div>
        </nav>
        <p>NTanova · République du Congo</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .entete-cadre {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--espace-3);
    padding-block: var(--espace-4);
  }
  .entete-droite {
    display: flex;
    align-items: center;
    gap: var(--espace-5);
  }
  .nav-haut {
    display: none;
  }
  .ville {
    padding: var(--espace-1) var(--espace-3);
    border: 1px solid var(--trait);
    border-radius: var(--rayon-pilule);
    background: var(--fond-releve);
    font-family: var(--police-titre);
    font-size: var(--taille-mention);
    font-weight: 700;
  }
  .lien-marque {
    display: inline-flex;
    align-items: center;
    gap: var(--espace-2);
    min-height: var(--cible-min);
    color: var(--texte);
    font-family: var(--police-titre);
    font-size: var(--taille-intertitre);
    font-weight: 700;
    text-decoration: none;
  }
  .pied {
    border-top: 1px solid var(--trait);
    color: var(--texte-doux);
    font-size: var(--taille-secondaire);
  }
  .pied-cadre {
    display: grid;
    gap: var(--espace-3);
    padding-block: var(--espace-6);
  }
  .pied p {
    margin: 0;
  }
  /* Deux groupes côte à côte sur téléphone (≈ 180 px de haut au lieu de ≈ 310 px), l'un sous l'autre sous 22 rem. */
  .pied-liens {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--espace-3) var(--espace-4);
  }
  @media (max-width: 21.99rem) {
    .pied-liens {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .pied-groupe {
    display: grid;
    align-content: start;
  }
  .pied-titre {
    color: var(--texte-doux);
    font-family: var(--police-titre);
    font-size: var(--taille-mention);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pied ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pied-liens a {
    display: flex;
    align-items: center;
    min-height: var(--cible-min);
    color: var(--marque);
    font-weight: 700;
  }

  /* Sur tablette, la navigation a sa ligne : une police de repli plus large ne pousse pas le pays hors du cadre. */
  @media (min-width: 48rem) {
    .entete {
      border-bottom: 1px solid var(--trait);
    }
    .entete-cadre {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--espace-2) var(--espace-3);
      min-height: 4.75rem;
      padding-block: var(--espace-3);
    }
    .entete-droite {
      display: contents;
    }
    .lien-marque {
      grid-column: 1;
      grid-row: 1;
      justify-self: start;
      gap: var(--espace-3);
      font-size: var(--taille-titre-fiche);
    }
    .lien-marque :global(.marque) {
      width: auto;
      height: 2.25rem;
    }
    .nav-haut {
      grid-column: 1 / -1;
      grid-row: 2;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--espace-4);
    }
    .nav-haut a {
      display: inline-flex;
      align-items: center;
      min-height: var(--cible-min);
      padding-inline: var(--espace-2);
      color: var(--texte);
      font-family: var(--police-titre);
      font-weight: 700;
      text-decoration: none;
    }
    .nav-haut a:hover {
      color: var(--marque);
      text-decoration: underline;
      text-underline-offset: 0.35em;
    }
    .nav-haut a[aria-current='page'] {
      text-decoration: underline;
      text-decoration-thickness: 3px;
      text-underline-offset: 0.35em;
    }
    .ville {
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
      padding: var(--espace-2) var(--espace-4);
      font-size: var(--taille-secondaire);
    }
    /* Les deux groupes l'un sous l'autre, titres et liens alignés à gauche, le bloc à droite de la phrase. */
    .pied-liens {
      display: grid;
      grid-template-columns: minmax(0, auto);
      justify-items: start;
      justify-self: end;
      gap: var(--espace-3);
    }
    .pied ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0 var(--espace-5);
    }
  }

  /* À partir de 64 rem : la phrase à gauche, les liens à droite. */
  @media (min-width: 64rem) {
    .entete-cadre {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }
    .nav-haut {
      grid-column: 2;
      grid-row: 1;
      justify-content: flex-end;
    }
    .ville {
      grid-column: 3;
    }
    /* La phrase garde sa place et ne se casse pas en trois lignes : ce sont les liens qui se partagent le reste. */
    .pied-cadre {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas: 'phrase liens';
      align-items: center;
      gap: var(--espace-5);
    }
    .pied-cadre > p {
      grid-area: phrase;
      white-space: nowrap;
    }
    .pied-liens {
      grid-area: liens;
      justify-content: flex-end;
    }
  }
</style>
