---
// Le gabarit des pages publiques : aucun JavaScript, du HTML et du CSS. Seul le pays de l'en-tête s'ouvre, en `<details>`.
//
// Lot 3 du site à trois piliers (planches « Accueil » de la version 44 du canevas, validées le 15/11/2026, décision 1A) :
// - l'en-tête porte les trois piliers en texte, Trouver une école · S'orienter · Espace écoles, visibles sur téléphone (plus de
//   bouton Menu) ; Carte, Méthode, Données et À propos passent au pied de page. L'icône Comparer viendra avec « Garder » : elle
//   ne paraît qu'avec une école gardée (version 44), et rien ne se garde encore ;
// - le pied de page : « Une école manque ? La signaler », la phrase de la marque, les trois groupes de liens (les villes y
//   sont, utiles aux moteurs de recherche), la date de mise à jour de l'annuaire.
// Le logo reste celui de la charte (les trois barres et leur contour, 30/10) : les planches dessinent la première barre en vert,
// sans contour, ce qu'aucun fichier de la marque ne fait.
import { PUBLIC_WHATSAPP } from 'astro:env/client';
import './jetons.css';
import './base.css';
import './composants.css';
import './public.css';
import Icone from './Icone.astro';
import Marque from './Marque.astro';
import { ICONES_SITE } from '../modele/icones';
import { HAUTEUR_PARTAGE, IMAGE_PARTAGE_SITE, LARGEUR_PARTAGE } from '../modele/partage';
import { LIEN_A_PROPOS, PAGES_DE_TRANSPARENCE } from '../modele/pages-de-confiance';
import { jourDuCongo } from '../modele/date-declaration';
import { dateCourte } from '../modele/pointe-noire';
import { avecMessage, lienWhatsApp } from '../modele/whatsapp';

interface Props {
  titre: string;
  description: string;
  /** Le lien WhatsApp de NTanova, s'il est configuré (voir src/modele/whatsapp.ts) ; sinon celui de la configuration. */
  whatsapp?: string | null;
  /** Une page de renvoi (fiche fusionnée, ancien plan) : l'adresse où aller, sans JavaScript. */
  renvoi?: string;
  /** Une page qu'un moteur de recherche ne garde pas : la page d'un lieu sans école publiée (ticket 146). */
  nonIndexee?: boolean;
  /** L'image que WhatsApp montre sous un lien partagé (ticket 101) : celle de la fiche, sinon celle du site. */
  image?: { chemin: string; alt: string };
  /** Les données structurées de la page (`schema.org`), écrites en JSON-LD : jamais exécutées. */
  donnees?: Record<string, unknown>;
}
const {
  titre,
  description,
  whatsapp = lienWhatsApp(PUBLIC_WHATSAPP, 'Bonjour NTanova, '),
  renvoi,
  nonIndexee = false,
  image = { chemin: IMAGE_PARTAGE_SITE, alt: 'NTanova : les écoles près de chez vous' },
  donnees,
} = Astro.props;
// Les adresses absolues que demandent les aperçus de lien : celles de ntanova.com (`site` d'astro.config.mjs).
const absolue = (chemin: string) => new URL(chemin, Astro.site ?? Astro.url).href;
const canonique = absolue(Astro.url.pathname);
const chemin = Astro.url.pathname;
const surCarte = chemin.startsWith('/carte/');
// Les trois piliers (décision 1A du 15/11/2026, version 44) : des choses que cherche le visiteur, pas des outils. « Trouver une
// école », c'est l'accueil, la liste, les lieux, les fiches et la carte. Il mène à la liste, `/ecoles/` (fondateur, 16/11 ; la
// planche le menait à l'accueil), et reste allumé sur l'accueil.
const piliers = [
  {
    href: '/ecoles/',
    texte: 'Trouver une école',
    courant: chemin === '/' || chemin.startsWith('/ecoles') || surCarte,
  },
  { href: '/orienter/', texte: 'S’orienter', courant: chemin.startsWith('/orienter') },
  {
    href: '/pour-les-ecoles/',
    texte: 'Espace écoles',
    courant: chemin.startsWith('/pour-les-ecoles'),
  },
];
// Le pied : les villes de l'accueil (celles qui ont des fiches, posées par src/middleware.ts), la date du jour où l'annuaire a
// été construit.
const villes = Astro.locals.villesDuPied ?? [];
const misAJourLe = dateCourte(jourDuCongo());
const manque = avecMessage(whatsapp, 'Bonjour NTanova, une école manque : ');
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    {renvoi && (
      <>
        <meta http-equiv="refresh" content={`0; url=${renvoi}`} />
        <link rel="canonical" href={renvoi} />
      </>
    )}
    {(renvoi || nonIndexee) && <meta name="robots" content="noindex" />}
    {!renvoi && <link rel="canonical" href={canonique} />}
    <meta property="og:site_name" content="NTanova" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:type" content={donnees ? 'article' : 'website'} />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={absolue(image.chemin)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(LARGEUR_PARTAGE)} />
    <meta property="og:image:height" content={String(HAUTEUR_PARTAGE)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    {donnees && <script type="application/ld+json" set:html={JSON.stringify(donnees)} />}
    {ICONES_SITE.map((icone) => (
      <link {...icone} />
    ))}
    <link
      rel="preload"
      href="/polices/nunito-sans-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body data-page={surCarte ? 'carte' : undefined}>
    <header class="entete">
      <div class="cadre entete-cadre">
        <div class="identite">
          <a class="lien-marque" href="/">
            <Marque taille={21} />
            <span>NTanova</span>
          </a>
          {/* Le pays s'ouvre et dit que NTanova recense pour le moment le seul Congo-Brazzaville, sans rien promettre d'autre
              (décision du fondateur du 08/11/2026, ticket 146). Un `<details>` : aucun JavaScript. */}
          <details class="pays">
            <summary class="ville">
              <Icone nom="globe" />
              Congo-Brazzaville
              <Icone nom="bas" />
            </summary>
            <div class="pays-bulle">
              <p class="pays-titre">Pays</p>
              <p class="pays-choisi">
                Congo-Brazzaville
                <Icone nom="coche" />
              </p>
              <p>
                Pour le moment, NTanova recense les écoles du Congo-Brazzaville, ville après ville.
              </p>
            </div>
          </details>
        </div>
        <nav aria-label="Navigation principale" class="piliers">
          {piliers.map((p) => (
            <a href={p.href} aria-current={p.courant ? 'page' : undefined}>
              {p.texte}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main class="contenu">
      <slot />
    </main>
    <footer class="pied">
      <div class="cadre pied-cadre">
        {manque && (
          <div class="pied-manque">
            <p>
              <b>Une école manque&nbsp;?</b>
              <span>Dites-nous son nom et son quartier.</span>
            </p>
            <a class="bouton pied-signaler" href={manque}>
              <Icone nom="bulle" />
              La signaler
            </a>
          </div>
        )}
        <div class="pied-grille">
          <div class="pied-marque">
            <p class="pied-nom">
              <Marque taille={20} />
              NTanova
            </p>
            <p class="pied-phrase">
              Les écoles du Congo-Brazzaville. Chaque information dit sa source et sa date.
            </p>
          </div>
          {/* Une seule navigation, comme avant le lot 3 : chaque liste porte le nom de son groupe. */}
          <nav aria-label="NTanova" class="pied-liens">
            <div class="pied-groupe">
              <p class="pied-titre" id="pied-trouver">
                Trouver une école
              </p>
              <ul aria-labelledby="pied-trouver">
                <li>
                  <a href="/ecoles/">Les écoles</a>
                </li>
                <li>
                  <a href="/carte/">Carte</a>
                </li>
                {villes.map((v) => (
                  <li>
                    <a href={v.lien}>{v.nom}</a>
                  </li>
                ))}
              </ul>
            </div>
            <div class="pied-groupe">
              <p class="pied-titre" id="pied-ntanova">
                NTanova
              </p>
              <ul aria-labelledby="pied-ntanova">
                <li>
                  {/* Le nom du pilier ; l'adresse change au lot 6 (l'ancienne renverra en 301). */}
                  <a href="/pour-les-ecoles/">Espace écoles</a>
                </li>
                <li>
                  <a href={LIEN_A_PROPOS}>À propos</a>
                </li>
                {whatsapp && (
                  <li>
                    <a href={whatsapp}>Écrire à NTanova sur WhatsApp</a>
                  </li>
                )}
              </ul>
            </div>
            {/* Les pages qu'une administration, une direction ou une famille lit pour savoir à qui elle a affaire (ticket 149). */}
            <div class="pied-groupe">
              <p class="pied-titre" id="pied-transparence">
                Transparence
              </p>
              <ul aria-labelledby="pied-transparence">
                {PAGES_DE_TRANSPARENCE.map((p) => (
                  <li>
                    <a href={p.href}>{p.texte}</a>
                  </li>
                ))}
              </ul>
            </div>
          </nav>
        </div>
        <div class="pied-bas">
          <p>NTanova · Congo-Brazzaville</p>
          <p>Annuaire mis à jour le {misAJourLe}</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  /* La bulle du pays s'ouvre sous l'en-tête et passe au-dessus de la page (la carte, ses commandes). */
  .entete {
    position: relative;
    z-index: 30;
    border-bottom: 1px solid var(--trait);
    background: var(--fond);
  }
  /* Sur téléphone (planche « Accueil · téléphone ») : la marque, le pays dessous, puis la rangée des trois piliers. */
  .entete-cadre {
    display: grid;
    gap: 2px;
    padding-top: 10px;
  }
  .identite {
    display: grid;
    justify-items: start;
    gap: 2px;
    min-width: 0;
  }
  .lien-marque {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--espace-2);
    color: var(--texte);
    font-family: var(--police-titre);
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.45;
    text-decoration: none;
    /* La cible de 44 px de la charte (27,5 px de ligne + 2 × 9), sans grandir l'en-tête dessiné : la marge négative rend ce que
       le rembourrage prend. */
    padding-block: 9px;
    margin-block: -9px;
  }
  /* Le pays n'est pas une porte : du texte posé, sans trait ni fond, qui ne ressemble pas à un bouton. */
  .ville {
    color: var(--texte-doux);
    font-family: var(--police-interface);
    font-size: var(--taille-mention);
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.35;
    text-transform: uppercase;
  }
  /* En `flex` et à la largeur de son texte : en ligne, il prenait la hauteur d'une ligne de 16 px (24 px au lieu de 16). */
  .pays > summary {
    position: relative;
    display: flex;
    width: max-content;
    align-items: center;
    gap: var(--espace-1);
    list-style: none;
    cursor: pointer;
  }
  .pays > summary::after {
    content: '';
    position: absolute;
    inset: -2px -8px -2px;
  }
  .pays > summary::-webkit-details-marker {
    display: none;
  }
  .pays > summary :global(svg) {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pays[open] > summary :global(svg:last-child) {
    transform: rotate(180deg);
  }
  .pays > summary:focus-visible {
    outline: var(--epaisseur-focus) solid var(--focus);
    outline-offset: 2px;
    border-radius: var(--rayon-xs);
  }
  .pays-bulle {
    position: absolute;
    top: 100%;
    left: var(--espace-4);
    right: var(--espace-4);
    z-index: 1;
    display: grid;
    gap: var(--espace-2);
    max-width: 20rem;
    padding: var(--espace-4);
    border-radius: var(--rayon-m);
    background: var(--fond-releve);
    box-shadow: var(--ombre-flottante);
    color: var(--texte);
    font-size: var(--taille-secondaire);
  }
  .pays-bulle p {
    margin: 0;
  }
  .pays-titre {
    color: var(--texte-doux);
    font-family: var(--police-interface);
    font-size: var(--taille-mention);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pays-choisi {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--espace-2);
    min-height: var(--cible-min);
    padding: 0 var(--espace-3);
    border: 2px solid var(--marque);
    border-radius: var(--rayon-s);
    background: var(--vert-pale);
    color: var(--marque-appuyee);
    font-family: var(--police-interface);
    font-weight: 700;
  }
  .pays-choisi :global(svg) {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Les trois piliers, toujours visibles : sur téléphone, répartis sur la largeur, le pilier courant souligné de vert. */
  .piliers {
    display: flex;
    justify-content: space-between;
    gap: var(--espace-2);
  }
  .piliers a {
    display: flex;
    align-items: center;
    min-height: var(--cible-min);
    color: var(--texte-doux);
    font-family: var(--police-interface);
    font-size: 0.84375rem;
    font-weight: 700;
    line-height: 1.45;
    text-decoration: none;
    white-space: nowrap;
  }
  .piliers a[aria-current='page'] {
    color: var(--texte);
    box-shadow: inset 0 -3px 0 var(--marque);
  }
  @media (hover: hover) {
    .piliers a:hover {
      color: var(--marque);
    }
  }
  /* Un téléphone de 320 px : les trois piliers tiennent encore sur une ligne. */
  @media (max-width: 22.49rem) {
    .piliers a {
      font-size: var(--taille-mention);
    }
  }
  /* Sur la carte, au téléphone : l'en-tête se réduit et le pays se cache, pour laisser la place à la carte entre les filtres
     et le tiroir (arbitrage du fondateur du 08/11/2026, ticket 146). Les piliers restent. */
  @media (max-width: 47.99rem) {
    [data-page='carte'] .pays {
      display: none;
    }
    [data-page='carte'] .entete-cadre {
      gap: 0;
      padding-top: var(--espace-2);
    }
  }

  /* Le pied de page (planches de la version 44) : fond clair, la porte « Une école manque ? », la marque, trois groupes de
     liens, la date de l'annuaire. */
  .pied {
    border-top: 1px solid var(--trait);
    background: var(--fond-releve);
    font-size: 0.9375rem;
  }
  .pied p {
    margin: 0;
  }
  .pied-cadre {
    display: grid;
    gap: 20px;
    padding-top: 20px;
    padding-bottom: var(--espace-5);
  }
  .pied-manque {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--espace-3);
    padding: var(--espace-4);
    border-radius: var(--rayon-m);
    background: var(--vert-pale);
  }
  .pied-manque p {
    display: grid;
  }
  .pied-manque b {
    font-size: var(--taille-courante);
  }
  .pied-manque span {
    color: var(--marque-appuyee);
    font-size: var(--taille-secondaire);
  }
  .pied-signaler {
    min-height: var(--cible-min);
    padding: 0 var(--espace-4);
    gap: 6px;
    font-size: inherit;
  }
  .pied-signaler :global(svg) {
    width: 18px;
    height: 18px;
  }
  .pied-grille {
    display: grid;
    gap: 20px;
  }
  .pied-marque {
    display: grid;
    gap: var(--espace-2);
    max-width: 300px;
  }
  /* Deux groupes par ligne au téléphone ; sur tablette et ordinateur, les trois colonnes de droite de la grille. */
  .pied-liens {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px var(--espace-4);
  }
  .pied-nom {
    display: flex;
    align-items: center;
    gap: var(--espace-2);
    font-family: var(--police-titre);
    font-size: var(--taille-intertitre);
    font-weight: 700;
  }
  .pied-phrase {
    color: var(--texte-doux);
    font-size: var(--taille-secondaire);
  }
  .pied-groupe {
    display: grid;
    align-content: start;
    gap: 6px;
    min-width: 0;
  }
  .pied-titre {
    color: var(--texte-doux);
    font-family: var(--police-interface);
    font-size: var(--taille-mention);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .pied-groupe ul {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* À la souris, les liens serrés de la planche : chaque cible descend de 22 px sous son mot (44 px en tout) sans pousser la
     ligne suivante, qui passe dessus ; le mot reste à lui seul. Au doigt, une ligne de 44 px chacun (les cibles de la charte). */
  .pied-groupe a {
    display: inline-block;
    padding-bottom: 22px;
    margin-bottom: -22px;
    color: var(--marque);
    font-weight: 700;
  }
  @media (pointer: coarse) {
    .pied-groupe ul {
      gap: 0;
    }
    .pied-groupe a {
      display: flex;
      align-items: center;
      min-height: var(--cible-min);
      padding-bottom: 0;
      margin-bottom: 0;
    }
  }
  .pied-bas {
    display: grid;
    gap: 2px;
    padding-top: 14px;
    border-top: 1px solid var(--trait);
    color: var(--texte-doux);
    font-size: 0.8125rem;
  }

  /* Tablette : la marque et le pays sur une ligne, les piliers dessous, à gauche. */
  @media (min-width: 48rem) {
    .entete-cadre {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--espace-2) var(--espace-5);
      padding-block: var(--espace-3) 0;
    }
    .identite {
      display: contents;
    }
    .lien-marque {
      gap: 10px;
      font-size: 1.3125rem;
    }
    .lien-marque :global(.marque) {
      width: 32px;
      height: 24px;
    }
    .pays {
      position: relative;
      grid-column: 2;
      grid-row: 1;
    }
    .piliers {
      grid-column: 1 / -1;
      justify-content: flex-start;
      gap: 28px;
    }
    .piliers a {
      color: var(--texte);
      font-size: 0.9375rem;
    }
    .piliers a[aria-current='page'] {
      box-shadow: inset 0 -2px 0 var(--marque);
    }
    .pays-bulle {
      top: calc(100% + var(--espace-3));
      left: auto;
      right: 0;
      width: 20rem;
    }

    .pied-cadre {
      gap: 28px;
      padding-top: 28px;
    }
    /* La grille de la planche, 1,4 · 1 · 1 · 1 : la navigation prend les trois colonnes de droite, au même écart. */
    .pied-grille {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      gap: var(--espace-6);
    }
    .pied-marque {
      align-content: start;
    }
    .pied-liens {
      grid-column: 2 / -1;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--espace-6);
    }
    .pied-bas {
      display: flex;
      justify-content: space-between;
      gap: var(--espace-4);
      padding-top: var(--espace-4);
    }
  }

  /* Ordinateur (planche « Accueil · ordinateur ») : une seule ligne, la marque, les piliers à droite, puis le pays. */
  @media (min-width: 64rem) {
    /* La hauteur de la planche, celle qu'aura la ligne avec la pilule Comparer (40 px) : l'en-tête ne sautera pas quand
       elle paraîtra. */
    .entete-cadre {
      display: flex;
      align-items: center;
      gap: 28px;
      min-height: 4.25rem;
      padding-block: 14px;
    }
    .piliers {
      order: 1;
      margin-left: auto;
    }
    /* Le trait vert à 3 px sous le mot, comme sur la planche ; la cible garde 44 px, le rembourrage du haut étant rendu par
       une marge négative. */
    .piliers a {
      min-height: 0;
      padding-top: 20px;
      padding-bottom: 3px;
      margin-top: -20px;
    }
    .pays {
      order: 2;
    }
  }
</style>
