---
// La légende de la carte détourée : les deux drapeaux (la carte ne montre que les écoles vues sur place), et la pastille quand il y a des groupes.
interface Props {
  groupes?: boolean;
}
const { groupes = false } = Astro.props;
---

<ul class="legende" aria-label="Légende de la carte">
  <li>
    <svg viewBox="0 0 12 12" aria-hidden="true">
      <path class="mat" d="M2.5 11V1.5" />
      <path class="drapeau verifiee" d="M2.5 1.5L10 3.5L2.5 5.5Z" />
    </svg>
    Confirmée par l’école
  </li>
  <li>
    <svg viewBox="0 0 12 12" aria-hidden="true">
      <path class="mat" d="M2.5 11V1.5" />
      <path class="drapeau relevee" d="M2.5 1.5L10 3.5L2.5 5.5Z" />
    </svg>
    Relevé terrain
  </li>
  {groupes && (
    <li>
      <svg class="large" viewBox="0 0 30 16" aria-hidden="true">
        <rect class="pastille" x="1" y="1" width="28" height="14" rx="7" />
        <path class="toit" d="M5 8.5L9.5 4.5L14 8.5Z" />
        <rect class="mur" x="6.5" y="8.5" width="6" height="3.5" />
        <text x="21" y="11.6">
          3
        </text>
      </svg>
      Un groupe d’écoles proches
    </li>
  )}
</ul>

<style>
  .legende {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espace-2) var(--espace-4);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--taille-mention);
    font-weight: 700;
  }
  .legende li {
    display: inline-flex;
    align-items: center;
    gap: var(--espace-1);
  }
  svg {
    width: 14px;
    height: 14px;
    stroke: var(--carte-trait);
    stroke-linejoin: round;
  }
  svg.large {
    width: 30px;
    height: 16px;
  }
  .mat {
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .drapeau {
    stroke-width: 1.2;
  }
  .drapeau.verifiee,
  .toit {
    fill: var(--carte-drapeau-verifiee);
  }
  .drapeau.relevee,
  .mur,
  .pastille {
    fill: var(--carte-drapeau-relevee);
  }
  .pastille {
    stroke-width: 1.5;
  }
  .toit,
  .mur {
    stroke-width: 1;
  }
  text {
    fill: var(--carte-nom);
    stroke: none;
    font-family: var(--police-titre);
    font-size: 9px;
    font-weight: 700;
    text-anchor: middle;
  }
</style>
