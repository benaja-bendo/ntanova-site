---
// La carte « Contact » de la fiche (lot 3, planche « Fiche publique ») : une ligne par propriété, le libellé à gauche, la
// valeur à droite. D'où vient le numéro se dit en note, comme les frais : « Chaque information dit sa source et sa date ».
import type { EcolePubliee } from '../modele/ports';
import { libelleProgramme } from '../modele/presentation-fiche';
import { libelleLangue } from '../modele/libelles';
import { dateLongue } from '../modele/pointe-noire';
import { siteWebLisible } from '../modele/vitrine';
import ContactEcole from './ContactEcole.astro';
interface Props {
  e: EcolePubliee;
  diplomes: string | null;
}
const { e, diplomes } = Astro.props;
const contact = e.contactPublic ?? null;
const source = contact
  ? `Numéro communiqué par l’école, publication autorisée le ${dateLongue(contact.accordLe)}.${
      e.numeroEnseigne === contact.numero ? ' Également lu sur l’enseigne.' : ''
    }`
  : e.numeroEnseigne
    ? 'Numéro relevé sur l’enseigne.'
    : null;
---

<ul class="lignes-fiche proprietes">
  <ContactEcole contact={contact} enseigne={e.numeroEnseigne} />
  {(e.langues ?? []).length > 0 && (
    <li>
      <span class="libelle">{(e.langues ?? []).length > 1 ? 'Langues' : 'Langue'}</span>
      <b>{(e.langues ?? []).map((l) => libelleLangue[l]).join(', ')}</b>
    </li>
  )}
  {e.siteWeb && (
    <li>
      <span class="libelle">Site web</span>
      <a class="lien-cible" href={e.siteWeb} rel="nofollow noopener">
        {siteWebLisible(e.siteWeb)}
      </a>
    </li>
  )}
  {e.programme && (
    <li>
      <span class="libelle">{libelleProgramme(e.programme)}</span>
      <b>{e.programme}</b>
    </li>
  )}
  {diplomes && (
    <li>
      <span class="libelle">Diplômes</span>
      <b>{diplomes}</b>
    </li>
  )}
  <slot />
</ul>
{source && <p class="source-contact">{source}</p>}

<style>
  .proprietes :global(li) {
    flex-wrap: nowrap;
    align-items: center;
  }
  .proprietes :global(.libelle) {
    flex: none;
    color: var(--texte-doux);
  }
  .proprietes :global(b),
  .proprietes :global(a) {
    min-width: 0;
    font-weight: 700;
    text-align: end;
    overflow-wrap: anywhere;
  }
  .lien-cible {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
    color: var(--marque);
  }
  .source-contact {
    margin: 0;
    color: var(--texte-doux);
    font-size: var(--taille-secondaire);
  }
</style>
