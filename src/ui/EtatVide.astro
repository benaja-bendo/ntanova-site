---
import './carte-pieces.css';
// L'état vide, le même partout (audit du 05/11/2026, D5, D10, D12) : un état clair, de quoi continuer, et la porte « Une école
// manque ? » vers WhatsApp. Son jumeau écrit dans le navigateur, `creerEtatVide` de `dom-pieces.ts`, donne le même balisage.
interface Props {
  /** Ce qui se passe, en une phrase claire. */
  titre: string;
  detail?: string;
  /** L'état public de la zone, quand c'est celui d'une zone : l'étiquette de la carte. */
  etat?: { genre: 'actif' | 'programme'; libelle: string } | null;
  /** Ce qu'on peut faire d'autre. */
  actions?: { texte: string; url: string }[];
  /** « Une école manque ? » : la porte WhatsApp, quand elle est configurée. */
  manque?: { texte: string; url: string } | null;
  /** Une étiquette pour les lecteurs d'écran (une zone vide est une région de la page). */
  etiquette?: string;
}
const { titre, detail, etat = null, actions = [], manque = null, etiquette } = Astro.props;
---

<div class="etat-vide" role={etiquette ? 'group' : undefined} aria-label={etiquette}>
  {etat && (
    <p class="etat-vide-etat">
      <span class={`etiquette-zone etiquette-zone-${etat.genre}`}>{etat.libelle}</span>
    </p>
  )}
  <p class="etat-vide-titre">{titre}</p>
  {detail && <p class="etat-vide-detail">{detail}</p>}
  {actions.length > 0 && (
    <div class="etat-vide-actions">
      {actions.map((a) => (
        <a class="bouton bouton-secondaire" href={a.url}>
          {a.texte}
        </a>
      ))}
    </div>
  )}
  {manque && (
    <p class="etat-vide-manque">
      <a href={manque.url}>{manque.texte}</a>
    </p>
  )}
</div>
