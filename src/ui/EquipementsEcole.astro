---
import {
  etatPublicEquipement,
  groupesEquipementsPublics,
  nomEquipement,
  type Equipement,
} from '../modele/equipements-ecole';
import { dateLongue } from '../modele/pointe-noire';
import Icone from './Icone.astro';
interface Props {
  equipements: Equipement[];
}
const { equipements } = Astro.props;
// Une pastille par équipement, rangées par état, source et date : ce qui est absent ou non précisé ne se lit jamais comme présent.
const groupes = groupesEquipementsPublics(equipements);
const provenance = (source: string) =>
  source === 'terrain' ? 'Observation' : source === 'ecole' ? 'Déclaration' : 'Information';
---

{equipements.length > 0 && (
  <section class="equipements-ecole" aria-label="Équipements et infrastructures">
    <h2>Équipements</h2>
    {groupes.map((g) => (
      <div class="groupe">
        <ul>
          {g.liste.map((e) => (
            <li class="etiquette-type">
              {g.etat === 'present' && <Icone nom="coche" />}
              {g.etat === 'absent' && <Icone nom="croix" />}
              {nomEquipement(e)}
            </li>
          ))}
        </ul>
        <p class="source">
          {etatPublicEquipement(g)} · {provenance(g.source)} du {dateLongue(g.constateLe)}.
        </p>
        {g.liste.map(
          (e) =>
            e.note && (
              <p>
                {nomEquipement(e)}&nbsp;: {e.note}
              </p>
            ),
        )}
      </div>
    ))}
  </section>
)}
<style>
  .equipements-ecole,
  .groupe {
    display: grid;
    gap: var(--espace-2);
  }
  .equipements-ecole {
    gap: var(--espace-3);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espace-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .etiquette-type :global(.ico) {
    color: var(--marque);
  }
  p {
    margin: 0;
  }
  .source {
    color: var(--preuve-ecole);
    font-size: var(--taille-secondaire);
  }
</style>
