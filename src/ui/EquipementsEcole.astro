---
// « Sur place » (v2 du 13/11, canevas « Fiche d'école ») : une ligne par équipement, et à droite qui l'affirme et quand. Ce
// qui est absent ou non précisé selon l'école reste distinct de ce qui a été vu : rien ne se lit comme présent par défaut.
import { nomEquipement, type Equipement } from '../modele/equipements-ecole';
import { dateCourte } from '../modele/pointe-noire';
interface Props {
  equipements: Equipement[];
  /** L'ancre de la rubrique « L'école », quand ce bloc est le premier de la rubrique. */
  id?: string | undefined;
}
const { equipements, id } = Astro.props;
// Ce qui a été vu d'abord, puis ce que l'école dit avoir, puis le reste : les exceptions se lisent en dernier, chacune nommée.
const rang = (e: Equipement) =>
  e.etat === 'present' ? (e.source === 'terrain' ? 0 : 1) : e.etat === 'absent' ? 2 : 3;
const lignes = [...equipements].sort(
  (a, b) => rang(a) - rang(b) || nomEquipement(a).localeCompare(nomEquipement(b), 'fr'),
);
const source = (e: Equipement): string => {
  if (e.source === 'terrain') return `vu sur place le ${dateCourte(e.constateLe)}`;
  if (e.etat === 'present') return `dit par l’école le ${dateCourte(e.constateLe)}`;
  if (e.etat === 'absent') return `absent, d’après l’école (${dateCourte(e.constateLe)})`;
  return `non précisé par l’école (${dateCourte(e.constateLe)})`;
};
---

{lignes.length > 0 && (
  <section class="equipements-ecole" aria-label="Équipements et infrastructures" id={id}>
    <h2>Sur place</h2>
    <ul class="lignes-fiche">
      {lignes.map((e) => (
        <li class:list={[{ absent: e.etat !== 'present' }]}>
          <span class="nom">
            <b>{nomEquipement(e)}</b>
            {e.note && <span class="note">{e.note}</span>}
          </span>
          <span class="source">{source(e)}</span>
        </li>
      ))}
    </ul>
  </section>
)}
<style>
  .equipements-ecole {
    display: grid;
    gap: var(--espace-2);
  }
  .nom {
    display: grid;
  }
  .note,
  .source {
    color: var(--texte-doux);
    font-size: var(--taille-secondaire);
  }
  .source {
    text-align: end;
  }
  .absent b {
    font-weight: 400;
  }
</style>
