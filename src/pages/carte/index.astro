---
// La carte interactive (ticket 103, étape C) : MapLibre et le fond de carte, chargés APRÈS la page, d'office ici (décision
// D7 : sur /carte/ la personne a choisi d'ouvrir la carte). La page se suffit sans eux : le dessin de l'accueil, la liste
// des zones et des écoles de la carte, et un petit chargeur (quelques centaines d'octets) qui décide du reste.
// Sans WebGL2, sans réseau ou sans tuiles, la liste reste complète.
import { PUBLIC_WHATSAPP } from 'astro:env/client';
import { obtenirSite } from '../../infra/index';
import { donneesDeLaCarte, arrondissementDuRepli } from '../../modele/carte/instantane';
import { lienCarte } from '../../modele/geo-divisions';
import { lienWhatsApp } from '../../modele/whatsapp';
import ApercuCarte from '../../ui/ApercuCarte.astro';
import PagePublique from '../../ui/PagePublique.astro';

const site = await obtenirSite();
const whatsapp = lienWhatsApp(PUBLIC_WHATSAPP, 'Bonjour NTanova, ');
const { zones, ecoles, cadre } = donneesDeLaCarte(site);
const repli = arrondissementDuRepli(site);
const zonesDessinees = zones.features.filter((z) => z.properties.genre === 'zone');
const pluriel = (n: number, un: string, plusieurs: string) => `${n} ${n > 1 ? plusieurs : un}`;
---

<PagePublique
  titre="La carte des écoles · NTanova"
  description="Les écoles du Congo-Brazzaville que des relais ont vues sur place, et les zones où le relevé est en cours ou programmé."
  whatsapp={whatsapp}
>
  <div class="cadre page-carte">
    <h1>La carte des écoles</h1>
    <p class="chapeau">
      Les écoles qu’un relais a vues sur place, et les zones où le relevé est en cours ou programmé.
      La liste plus bas donne les mêmes écoles.
    </p>

    <div
      id="carte"
      class="carte-interactive"
      data-etat="repli"
      data-boite={JSON.stringify(cadre.boite)}
      role="region"
      aria-label="Carte interactive des écoles"
    >
      <div class="carte-repli">
        {repli.tete ? (
          <ApercuCarte
            arrondissement={repli.tete}
            ecoles={repli.ecoles}
            lienCarte={lienCarte(['congo', 'pointe-noire', repli.tete.slug])}
          />
        ) : (
          <p class="carte-repli-texte">La carte s’affiche ici quand elle est chargée.</p>
        )}
      </div>
      <div id="carte-toile" class="carte-toile"></div>
    </div>
    <p id="carte-note" class="carte-note" role="status"></p>

    <section aria-labelledby="titre-zones" class="carte-liste">
      <h2 id="titre-zones">Les zones</h2>
      {zonesDessinees.length === 0 ? (
        <p>Aucune zone n’est encore ouverte au relevé.</p>
      ) : (
        <ul>
          {zonesDessinees.map((z) => (
            <li>
              <a href={z.properties.lien}>{z.properties.nom}</a>
              <span>
                {z.properties.libelle} ·{' '}
                {pluriel(z.properties.vues, 'école vue sur place', 'écoles vues sur place')}
              </span>
            </li>
          ))}
        </ul>
      )}
    </section>

    <section aria-labelledby="titre-ecoles" class="carte-liste">
      <h2 id="titre-ecoles">Les écoles sur la carte ({ecoles.features.length})</h2>
      {ecoles.features.length === 0 ? (
        <p>Aucune école n’a encore été vue sur place.</p>
      ) : (
        <ul>
          {ecoles.features.map((e) => (
            <li>
              <a href={e.properties.lien}>{e.properties.nom}</a>
              <span>
                {[e.properties.lieu, e.properties.preuveTexte].filter(Boolean).join(' · ')}
              </span>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</PagePublique>

<script>
  // Le chargeur : il décide, puis charge l'îlot. Rien de MapLibre n'est dans ce fichier ni dans la page.
  import { modeDeChargement, type Connexion } from '../../modele/carte/chargement';
  import { ADRESSE_DES_TUILES, type Fenetre } from '../../modele/carte/fond';

  const conteneur = document.getElementById('carte');
  const toile = document.getElementById('carte-toile');
  const note = document.getElementById('carte-note');

  const dire = (texte: string) => {
    if (note) note.textContent = texte;
  };
  const etat = (valeur: string) => {
    if (conteneur) conteneur.dataset.etat = valeur;
  };

  // MapLibre 6 exige WebGL2. On le teste AVANT de télécharger quoi que ce soit : un téléphone qui ne sait pas le faire ne
  // paie pas 0,4 Mo pour rien, et garde le dessin et la liste, sans message d'erreur effrayant.
  function aWebGL2(): boolean {
    try {
      const canvas = document.createElement('canvas');
      const contexte = canvas.getContext('webgl2');
      contexte?.getExtension('WEBGL_lose_context')?.loseContext();
      return contexte !== null;
    } catch {
      return false;
    }
  }

  async function lancer(): Promise<void> {
    if (!conteneur || !toile) return;
    if (!aWebGL2()) {
      etat('repli-sans-webgl2');
      dire(
        'La carte interactive n’est pas disponible sur cet appareil. La liste ci-dessous donne les mêmes écoles.',
      );
      return;
    }
    // La connexion au serveur de tuiles se prépare au moment où l'on décide de charger, jamais dans le HTML : qui ne charge
    // pas la carte ne paie rien.
    const lien = document.createElement('link');
    lien.rel = 'preconnect';
    lien.href = new URL(ADRESSE_DES_TUILES).origin;
    lien.crossOrigin = '';
    document.head.append(lien);

    etat('chargement');
    try {
      const { demarrerLaCarte } = await import('../../app/carte/ilot');
      await demarrerLaCarte({
        toile,
        boite: JSON.parse(conteneur.dataset.boite ?? '[]') as unknown as Fenetre,
        surPrete: () => etat('prete'),
        surFondAbsent: () => {
          conteneur.dataset.fond = 'absent';
          dire(
            'Le fond de carte ne se charge pas pour le moment. Les écoles restent dans la liste ci-dessous.',
          );
        },
      });
    } catch (erreur) {
      console.error('carte :', erreur);
      etat('echec');
      dire('La carte ne s’est pas chargée. La liste ci-dessous donne les mêmes écoles.');
    }
  }

  const connexion = (navigator as Navigator & { connection?: Connexion }).connection;
  if (modeDeChargement('carte', connexion) === 'd-office') {
    // Après le chargement de la page, sans rien bloquer.
    if (document.readyState === 'complete') void lancer();
    else window.addEventListener('load', () => void lancer(), { once: true });
  }
</script>

<style>
  .page-carte {
    display: grid;
    gap: var(--espace-4);
    padding-block: var(--espace-5);
  }
  .carte-interactive {
    position: relative;
    height: min(72dvh, 42rem);
    min-height: 22rem;
    overflow: hidden;
    background: var(--carte-fond);
    border: 1px solid var(--trait);
    border-radius: var(--rayon-s);
  }
  /* Le dessin et le texte d'attente, sous la carte, jusqu'à son premier affichage complet (aucun écran blanc). */
  .carte-repli {
    position: absolute;
    inset: 0;
    overflow: auto;
    padding: var(--espace-3);
  }
  .carte-toile {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  [data-etat='prete'] .carte-toile {
    opacity: 1;
  }
  [data-etat='prete'] .carte-repli {
    display: none;
  }
  .carte-repli-texte,
  .carte-note {
    margin: 0;
    color: var(--texte-doux);
    font-size: var(--taille-secondaire);
  }
  .carte-liste ul {
    display: grid;
    gap: var(--espace-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .carte-liste li {
    display: grid;
    gap: 2px;
  }
  .carte-liste li a {
    font-weight: 700;
  }
  .carte-liste li span {
    color: var(--texte-doux);
    font-size: var(--taille-secondaire);
  }
  @media (min-width: 64rem) {
    .carte-interactive {
      height: min(75dvh, 48rem);
    }
  }
</style>

<style is:global>
  /* L'aperçu d'une école, posé par l'îlot dans une fenêtre de MapLibre (le tiroir arrive à l'étape D). */
  .carte-apercu {
    display: grid;
    gap: 4px;
    color: var(--texte);
    font-family: var(--police-texte);
    font-size: var(--taille-secondaire);
  }
  .carte-apercu p {
    margin: 0;
  }
  .carte-apercu-nom {
    font-weight: 700;
    font-size: var(--taille-courante);
  }
  .carte-apercu-preuve,
  .carte-apercu-niveaux,
  .carte-apercu-lieu {
    color: var(--texte-doux);
  }
  /* La croix de fermeture de MapLibre fait 24 px : une cible de doigt en fait 44 (système de design). */
  .maplibregl-popup-close-button {
    min-width: 44px;
    min-height: 44px;
    font-size: 1.5rem;
    color: var(--texte);
  }
  .carte-apercu-lien {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
  }
</style>
