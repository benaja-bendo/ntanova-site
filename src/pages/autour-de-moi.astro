---
// « Autour de moi » : les écoles les plus proches, classées par distance. La position est demandée à l'appui du
// bouton, sert à classer des écoles déjà dans la page, et n'est envoyée à personne. Avec « Rechercher », la
// seule page publique qui exécute du JavaScript.
import { PUBLIC_WHATSAPP } from 'astro:env/client';
import { avecMessage, lienWhatsApp } from '../modele/whatsapp';
import '../ui/carte-pieces.css';
import PagePublique from '../ui/PagePublique.astro';

const whatsapp = lienWhatsApp(PUBLIC_WHATSAPP, 'Bonjour NTanova, ');
const manque = avecMessage(whatsapp, 'Bonjour NTanova, une école manque : ');
// Le rayon se choisit AVANT d'appuyer : le bouton est le dernier geste, pas le premier (audit du 05/11/2026, D12).
const rayons = [
  [1000, '1 km'],
  [3000, '3 km'],
  [10000, '10 km'],
  [30000, '30 km'],
] as const;
---

<PagePublique
  titre="Les écoles autour de moi · NTanova"
  description="Les écoles les plus proches de vous, classées par distance. Votre position reste sur votre téléphone."
  whatsapp={whatsapp}
>
  <section class="cadre page autour" data-autour data-manque={manque ?? undefined}>
    <a class="retour" href="/ecoles/">
      ← Les écoles
    </a>
    <div>
      <h1>Autour de moi</h1>
      <p class="texte-doux">
        Appuyez sur le bouton : votre téléphone donne sa position, et les écoles les plus proches
        s’affichent. Votre position reste sur votre téléphone, elle n’est envoyée à personne.
      </p>
    </div>

    <noscript>
      <p class="carte">
        Cette page a besoin de JavaScript. Sans lui, <a href="/ecoles/">choisissez votre ville</a>.
      </p>
    </noscript>

    <div class="champ-groupe" role="group" aria-labelledby="titre-rayon">
      <span id="titre-rayon" class="titre-champ">
        Jusqu’à
      </span>
      <div class="groupe-puces" data-rayons>
        {rayons.map(([metres, mot]) => (
          <button
            type="button"
            class="pastille-choix"
            data-rayon={metres}
            aria-pressed={metres === 3000 ? 'true' : 'false'}
          >
            {mot}
          </button>
        ))}
      </div>
    </div>
    <div class="actions">
      <button type="button" class="bouton" data-position>
        Trouver les écoles près de moi
      </button>
    </div>
    <p class="texte-doux" role="status" data-message></p>

    <section data-resultats aria-live="polite" class="resultats" hidden>
      <p class="compte" data-compte></p>
      <ul class="liste-lignes"></ul>
      <div data-vide></div>
    </section>

    <p class="autres-chemins">
      <a class="chercher" href="/ecoles/">
        Ou parcourez les villes
      </a>
      <a class="chercher" href="/recherche/">
        Ou cherchez par nom
      </a>
    </p>
  </section>
</PagePublique>

<script>
  import { demarrerAutourDeMoi } from '../ui/recherche-client';
  const racine = document.querySelector<HTMLElement>('[data-autour]');
  if (racine) demarrerAutourDeMoi(racine);
</script>

<style is:global>
  .autour {
    display: grid;
    gap: var(--espace-4);
  }
  .autour h1 {
    margin: 0;
    color: var(--marque-appuyee);
    font-family: var(--police-titre);
    font-size: var(--taille-titre-page);
    line-height: var(--interligne-titre);
  }
  .autour p {
    margin: 0;
  }
  .autour .titre-champ {
    font-family: var(--police-titre);
    font-size: var(--taille-secondaire);
    font-weight: 700;
  }
  .autour .compte {
    font-family: var(--police-titre);
    font-weight: 700;
  }
  .autour .resultats {
    display: grid;
    gap: var(--espace-3);
  }
  .autour .resultats[hidden] {
    display: none;
  }
  .autour .autres-chemins {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--espace-5);
    margin: 0;
  }
  .autour .chercher {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
    color: var(--marque);
    font-weight: 700;
  }

  @media (min-width: 48rem) {
    .autour {
      gap: var(--espace-5);
      padding-block: var(--espace-7);
    }
    .autour h1 {
      font-size: var(--taille-titre-public);
    }
  }
</style>
