---
// « Rechercher » : par nom, quartier ou repère, et par ce qu'une école enseigne (niveau, série du bac, diplôme,
// domaine, rythme). C'est avec « Autour de moi » la seule page publique qui exécute du JavaScript : un petit
// script filtre `/recherche.json`, construit avec le site. Sans JavaScript, la page renvoie vers les listes.
import { PUBLIC_WHATSAPP } from 'astro:env/client';
import { obtenirSite } from '../infra/index';
import { ecolesSous, lienDivision, type PageDivision } from '../modele/geo-divisions';
import { filtresAvances } from '../modele/recherche';
import { avecMessage, lienWhatsApp } from '../modele/whatsapp';
import '../ui/carte-pieces.css';
import PagePublique from '../ui/PagePublique.astro';

const { facettes, arbre } = await obtenirSite();
const whatsapp = lienWhatsApp(PUBLIC_WHATSAPP, 'Bonjour NTanova, ');
const manque = avecMessage(whatsapp, 'Bonjour NTanova, une école manque : ');
const valeursDe = (facette: string) => facettes.filter((f) => f.facette === facette);
// La valeur est la lettre du cycle (celle de l'épingle), puis le mot de la puce, puis les mots complets en infobulle : les mêmes
// puces que la carte (audit du 05/11/2026, D8).
const cycles = [
  ['M', 'Maternelle', 'Crèche et maternelle'],
  ['P', 'Primaire', 'Primaire'],
  ['C', 'Collège', 'Collège'],
  ['L', 'Lycée', 'Lycée'],
  ['T', 'Technique', 'Technique et professionnel'],
  ['S', 'Supérieur', 'Supérieur et formation'],
] as const;
// Les filtres de formation : seulement ceux qui ont au moins une valeur dans les données construites (`filtresAvances`) ; ils se
// rangent dans un volet replié.
const avances = filtresAvances(facettes);
// Les zones où l'on peut chercher : les pays, départements, villes et arrondissements qui ont des écoles (une zone qui n'a que
// son état public, comme Brazzaville aujourd'hui, a sa page mais rien à chercher).
const zones: PageDivision[] = [];
const parcourir = (p: PageDivision) => {
  if (p.division.niveau <= 3 && ecolesSous(p).length > 0) zones.push(p);
  p.enfants.forEach(parcourir);
};
arbre.racines.forEach(parcourir);
---

<PagePublique
  titre="Rechercher une école · NTanova"
  description="Rechercher une école du Congo-Brazzaville par nom, quartier, repère, niveau, série du bac, diplôme, domaine ou rythme."
  whatsapp={whatsapp}
>
  <section class="cadre page recherche" data-recherche data-manque={manque ?? undefined}>
    <a class="retour" href="/ecoles/">
      ← Les écoles
    </a>
    <div>
      <h1>Rechercher une école</h1>
      <p class="texte-doux">
        Par nom, quartier ou repère, et par ce que l’école enseigne. Chaque critère choisi réduit la
        liste.
      </p>
    </div>

    <noscript>
      <p class="carte">
        La recherche a besoin de JavaScript. Sans lui, parcourez les{' '}
        <a href={lienDivision(['congo'])}>écoles par ville</a> ou{' '}
        <a href="/formations/">par formation</a>.
      </p>
    </noscript>

    <form
      class="criteres carte"
      role="search"
      aria-label="Critères de recherche"
      autocomplete="off"
    >
      <label class="champ-groupe pleine">
        Nom, quartier, repère ou formation
        <input
          class="champ"
          type="search"
          name="q"
          placeholder="Ex. : lycée, Mvoumvou, BTS informatique"
        />
      </label>
      <div class="champ-groupe pleine" role="group" aria-labelledby="titre-niveau">
        <span id="titre-niveau" class="titre-champ">
          Niveau
        </span>
        <div class="groupe-puces groupe-puces-defile" data-niveaux>
          <button type="button" class="pastille-choix" data-cycle="" aria-pressed="true">
            Tous
          </button>
          {cycles.map(([lettre, mot, complet]) => (
            <button
              type="button"
              class="pastille-choix avec-disque"
              data-cycle={lettre}
              aria-pressed="false"
              title={complet}
            >
              <span class={`disque c-${lettre}`} aria-hidden="true">
                {lettre}
              </span>
              {mot}
            </button>
          ))}
        </div>
      </div>
      <label class="champ-groupe">
        Zone
        <select class="champ" name="zone">
          <option value="">Partout</option>
          {zones.map((p) => (
            <option value={p.adresse.join('/')}>{p.noms.join(' › ')}</option>
          ))}
        </select>
      </label>
      {avances.length > 0 && (
        <details class="plus-de-filtres pleine">
          <summary>Plus de filtres</summary>
          <div class="filtres-avances">
            {avances.map(({ facette, titre, tous }) => (
              <label class="champ-groupe">
                {titre}
                <select class="champ" name={facette}>
                  <option value="">{tous}</option>
                  {valeursDe(facette).map((v) => (
                    <option value={v.valeur}>{v.libelle}</option>
                  ))}
                </select>
              </label>
            ))}
          </div>
        </details>
      )}
    </form>

    <section data-resultats aria-live="polite" class="resultats">
      <p class="compte" data-compte>
        Chargement des écoles…
      </p>
      <ul class="liste-lignes"></ul>
      <div data-vide></div>
    </section>
  </section>
</PagePublique>

<script>
  import { demarrerRecherche } from '../ui/recherche-client';
  const racine = document.querySelector<HTMLElement>('[data-recherche]');
  if (racine) demarrerRecherche(racine);
</script>

<style is:global>
  .recherche {
    display: grid;
    gap: var(--espace-4);
  }
  .recherche h1 {
    margin: 0;
    color: var(--marque-appuyee);
    font-family: var(--police-titre);
    font-size: var(--taille-titre-page);
    line-height: var(--interligne-titre);
  }
  .recherche p {
    margin: 0;
  }
  .recherche .criteres {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--espace-3);
    padding: var(--espace-4);
  }
  /* Une rangée de puces qui défile ne doit pas élargir la page : ses parents se rétrécissent jusqu'à la largeur de l'écran. */
  .recherche .criteres > * {
    min-width: 0;
  }
  .recherche .pleine {
    grid-column: 1 / -1;
  }
  .recherche .titre-champ {
    font-family: var(--police-titre);
    font-size: var(--taille-secondaire);
    font-weight: 700;
  }
  .recherche .compte {
    font-family: var(--police-titre);
    font-weight: 700;
  }
  .recherche .resultats {
    display: grid;
    gap: var(--espace-3);
  }
  /* « Plus de filtres » : replié, avec le « + » qui dit qu'on peut l'ouvrir et le « − » qui dit qu'on peut le refermer. */
  .recherche .plus-de-filtres summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--espace-3);
    min-height: var(--cible-min);
    list-style: none;
    color: var(--marque);
    font-family: var(--police-titre);
    font-weight: 700;
    cursor: pointer;
  }
  .recherche .plus-de-filtres summary::-webkit-details-marker {
    display: none;
  }
  .recherche .plus-de-filtres summary::after {
    content: '+';
    font-size: var(--taille-titre-fiche);
    line-height: 1;
  }
  .recherche .plus-de-filtres[open] summary::after {
    content: '−';
  }
  .recherche .filtres-avances {
    display: grid;
    gap: var(--espace-3);
    padding-top: var(--espace-3);
  }

  @media (min-width: 48rem) {
    .recherche {
      gap: var(--espace-5);
      padding-block: var(--espace-7);
    }
    .recherche h1 {
      font-size: var(--taille-titre-public);
    }
    .recherche .criteres {
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    }
    .recherche .filtres-avances {
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    }
  }
</style>
