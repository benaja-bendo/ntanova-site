---
import { PUBLIC_WHATSAPP } from 'astro:env/client';
import { lienWhatsApp } from '../modele/whatsapp';
import PagePublique from '../ui/PagePublique.astro';
const whatsapp = lienWhatsApp(PUBLIC_WHATSAPP, 'Bonjour NTanova, ');
---

<PagePublique
  titre="Page introuvable · NTanova"
  description="Cette page n'existe pas."
  whatsapp={whatsapp}
>
  <section class="cadre page introuvable">
    <h1>Page introuvable</h1>
    <p>
      Cette page n'existe pas, ou la fiche n'est plus publiée. L'adresse est peut-être incomplète.
    </p>
    <p>Cherchez l'école par son nom, ou parcourez les écoles publiées.</p>
    <div class="actions">
      <a class="bouton" href="/ecoles/">
        Chercher une école
      </a>
      <a class="bouton bouton-secondaire" href="/carte/">
        Voir la carte
      </a>
    </div>
    <a class="lien-accueil" href="/">
      Revenir à l'accueil
    </a>
  </section>
</PagePublique>

<style>
  .introuvable {
    display: grid;
    gap: var(--espace-4);
    justify-items: start;
  }
  .introuvable p {
    margin: 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ecart-cibles);
  }
  .lien-accueil {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
    color: var(--marque);
    font-weight: 700;
  }

  @media (min-width: 48rem) {
    .introuvable {
      padding-block: var(--espace-7);
    }
    .introuvable h1 {
      font-size: var(--taille-titre-public);
    }
  }
</style>
