---
// Les anciens plans dessinés des six arrondissements de Pointe-Noire (`/cartes/congo/pointe-noire/<arrondissement>/`). Le
// site n'a plus qu'une carte (décision du fondateur du 08/11/2026, ticket 146) : chaque ancienne adresse renvoie vers elle,
// cadrée sur l'arrondissement. Les « coins » vus de près (`…/coin_3/`) renvoient ici par `public/_redirects`.
import type { GetStaticPaths } from 'astro';
import { obtenirSite } from '../../infra/index';
import { lienCarteDuLieu } from '../../modele/carte/navigation';
import { ecolesSous } from '../../modele/geo-divisions';
import PageRenvoi from '../../ui/PageRenvoi.astro';

export const getStaticPaths = (async () => {
  const { arbre } = await obtenirSite();
  return arbre.tous
    .filter(
      (page) =>
        page.division.niveau === 3 && page.adresse.join('/').startsWith('congo/pointe-noire/'),
    )
    .map((page) => ({
      params: { chemin: page.adresse.join('/') },
      props: {
        vers: lienCarteDuLieu({
          contour: page.division.contour,
          position: page.division.position,
          ecoles: ecolesSous(page),
        }),
      },
    }));
}) satisfies GetStaticPaths;

const { vers } = Astro.props;
---

<PageRenvoi vers={vers} />
