---
// La liste des écoles publiées d'un arrondissement, construite à partir de la base.
import type { GetStaticPaths } from 'astro';
import { PUBLIC_WHATSAPP } from 'astro:env/client';
import { obtenirCatalogue } from '../../../infra/index';
import type { ArrondissementPublic, EcolePubliee } from '../../../modele/ports';
import { numeroArrondissement } from '../../../modele/pointe-noire';
import { lienWhatsApp } from '../../../modele/whatsapp';
import { arrondissementDessine } from '../../../modele/carte/plan';
import BasculeVue from '../../../ui/BasculeVue.astro';
import ListeEcoles from '../../../ui/ListeEcoles.astro';
import PagePublique from '../../../ui/PagePublique.astro';

export const getStaticPaths = (async () => {
  const catalogue = await obtenirCatalogue();
  const [arrondissements, ecoles] = await Promise.all([
    catalogue.arrondissements(),
    catalogue.ecoles(),
  ]);
  return arrondissements.map((a) => ({
    params: { arrondissement: a.slug },
    props: { arrondissement: a, ecoles: ecoles.filter((e) => e.arrondissement === a.slug) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  arrondissement: ArrondissementPublic;
  ecoles: EcolePubliee[];
}
const { arrondissement, ecoles } = Astro.props;
const numero = numeroArrondissement[arrondissement.slug];
const verifiees = ecoles.filter((e) => e.etat === 'verifiee').length;
const whatsapp = lienWhatsApp(PUBLIC_WHATSAPP, 'Bonjour NTanova, ');
const manque = lienWhatsApp(
  PUBLIC_WHATSAPP,
  `Bonjour NTanova, une école manque à ${arrondissement.nom} : `,
);
// La carte de l'arrondissement, quand son contour est dessiné (src/modele/carte/).
const aUneCarte = arrondissementDessine(arrondissement.slug) !== null;
---

<PagePublique
  titre={`Les écoles de ${arrondissement.nom} · NTanova`}
  description={`Les écoles de ${arrondissement.nom}, à Pointe-Noire : de la crèche au supérieur, relevées sur place.`}
  whatsapp={whatsapp}
>
  <section class="cadre page liste">
    <a class="retour" href="/">
      ← Accueil
    </a>
    <div class="titre-vue">
      <div>
        <h1>{arrondissement.nom}</h1>
        <p class="texte-doux">
          {numero ? `Arrondissement ${numero} · ` : ''}
          <span class="insecable">Pointe-Noire</span>
        </p>
      </div>
      {aUneCarte && (
        <BasculeVue
          carte={`/ecoles/${arrondissement.slug}/carte/`}
          liste={`/ecoles/${arrondissement.slug}/`}
          actuelle="liste"
        />
      )}
    </div>

    {ecoles.length === 0 ? (
      <p class="carte">Aucune école publiée pour l'instant&nbsp;: le relevé est en cours.</p>
    ) : (
      <p class="compte">
        {ecoles.length} école{ecoles.length > 1 ? 's' : ''} relevée{ecoles.length > 1 ? 's' : ''}
        {verifiees > 0 && ` · ${verifiees} vérifiée${verifiees > 1 ? 's' : ''}`}
      </p>
    )}

    <ListeEcoles ecoles={ecoles} />

    <div class="encadre-pointille">
      <p>Une partie du quartier n'est pas encore relevée&nbsp;: relevé en cours.</p>
      {manque && <a href={manque}>Une école manque&nbsp;? Dites-le-nous sur WhatsApp</a>}
    </div>
  </section>
</PagePublique>

<style>
  .liste {
    display: grid;
    gap: var(--espace-4);
  }
  .liste h1 {
    margin: 0;
    color: var(--marque-appuyee);
    font-family: var(--police-titre);
    font-size: var(--taille-titre-page);
    line-height: var(--interligne-titre);
  }
  .liste p {
    margin: 0;
  }
  .compte {
    font-family: var(--police-titre);
    font-weight: 700;
  }
  .encadre-pointille a {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
    color: var(--marque);
    font-weight: 700;
  }

  /* À partir de 48 rem : les écoles en grille, les titres plus grands. */
  @media (min-width: 48rem) {
    .liste {
      gap: var(--espace-5);
      padding-block: var(--espace-7);
    }
    .liste h1 {
      font-size: var(--taille-titre-public);
    }
  }
</style>
