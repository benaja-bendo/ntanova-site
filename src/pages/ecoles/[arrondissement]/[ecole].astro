---
// La fiche d'une école publiée : ce qui se voit de la rue, et comment y aller.
// Une page par école, construite à partir de la base ; aucun JavaScript.
import type { GetStaticPaths } from 'astro';
import { PUBLIC_WHATSAPP } from 'astro:env/client';
import { obtenirCatalogue } from '../../../infra/index';
import { libelleNiveau, libelleTypeEcole, typeInformatif } from '../../../modele/libelles';
import type { ArrondissementPublic, EcolePubliee } from '../../../modele/ports';
import { dateLongue } from '../../../modele/pointe-noire';
import { afficherTelephone } from '../../../modele/telephone';
import { lienWhatsApp } from '../../../modele/whatsapp';
import PagePublique from '../../../ui/PagePublique.astro';

export const getStaticPaths = (async () => {
  const catalogue = await obtenirCatalogue();
  const [arrondissements, ecoles, redirections] = await Promise.all([
    catalogue.arrondissements(),
    catalogue.ecoles(),
    catalogue.redirections(),
  ]);
  const fiches = ecoles.flatMap((e) => {
    const arrondissement = arrondissements.find((a) => a.slug === e.arrondissement);
    return arrondissement
      ? [
          {
            params: { arrondissement: e.arrondissement, ecole: e.slug },
            props: { e, arrondissement, renvoi: undefined },
          },
        ]
      : [];
  });
  // L'ancienne adresse d'une fiche fusionnée renvoie vers l'école gardée.
  const renvois = redirections.map((r) => ({
    params: { arrondissement: r.de.arrondissement, ecole: r.de.slug },
    props: {
      e: undefined,
      arrondissement: undefined,
      renvoi: `/ecoles/${r.vers.arrondissement}/${r.vers.slug}/`,
    },
  }));
  return [...fiches, ...renvois];
}) satisfies GetStaticPaths;

type Props =
  | { e: EcolePubliee; arrondissement: ArrondissementPublic; renvoi: undefined }
  | { e: undefined; arrondissement: undefined; renvoi: string };
const { e, arrondissement, renvoi } = Astro.props;
const whatsapp = lienWhatsApp(PUBLIC_WHATSAPP, 'Bonjour NTanova, ');
const erreur = e
  ? lienWhatsApp(PUBLIC_WHATSAPP, `Bonjour NTanova, une erreur sur la fiche de ${e.nom} : `)
  : null;
const itineraire =
  e && e.latitude !== null && e.longitude !== null
    ? `https://www.google.com/maps/dir/?api=1&destination=${e.latitude},${e.longitude}`
    : null;
const lieu =
  e && arrondissement
    ? [e.quartier, arrondissement.nom].filter((x, i, t) => x && t.indexOf(x) === i).join(' · ')
    : '';
// Ce que la fiche écrit, et ce qui manque : un type « Pas indiqué » ou « Autre » et l'absence de
// niveaux ne s'écrivent pas en ligne, ils rejoignent « Pas encore sur la fiche ».
const niveaux = e ? e.niveaux.map((n) => libelleNiveau[n]).join(', ') : '';
const typeSeLit = e ? typeInformatif(e.typeEcole) : false;
const aDesProprietes = Boolean(niveaux || typeSeLit || e?.programme || e?.numeroEnseigne);
---

{renvoi ? (
  <PagePublique
    titre="Fiche déplacée · NTanova"
    description="Cette école a une nouvelle fiche sur NTanova."
    whatsapp={whatsapp}
    renvoi={renvoi}
  >
    <section class="cadre page fiche">
      <h1>Cette école a une nouvelle fiche</h1>
      <a class="bouton" href={renvoi}>
        Voir la fiche
      </a>
    </section>
  </PagePublique>
) : (
  e &&
  arrondissement && (
    <PagePublique
      titre={`${e.nom} · ${arrondissement.nom} · NTanova`}
      description={`${e.nom}, à ${arrondissement.nom} (Pointe-Noire) : niveaux, type, repère et itinéraire.`}
      whatsapp={whatsapp}
    >
      <article class="cadre page fiche">
        <a class="retour" href={`/ecoles/${arrondissement.slug}/`}>
          ← Les écoles de {arrondissement.nom}
        </a>

        <div class="fiche-corps">
          <div class="fiche-principale">
            {e.etat === 'verifiee' ? (
              <p class="carte etat">
                <b>Fiche vérifiée par la direction</b> le {dateLongue(e.misAJourLe)}.
              </p>
            ) : (
              <p class="etat etat-relevee-public">
                <b>Fiche relevée le {dateLongue(e.misAJourLe)}</b> par un jeune du quartier&nbsp;:
                seulement ce qui se voit de la rue.
              </p>
            )}

            <div>
              <h1>{e.nom}</h1>
              <p class="texte-doux">
                {lieu} · <span class="insecable">Pointe-Noire</span>
              </p>
            </div>

            {aDesProprietes && (
              <dl class="carte proprietes">
                {niveaux && (
                  <>
                    <dt>Niveaux</dt>
                    <dd>{niveaux}</dd>
                  </>
                )}
                {typeSeLit && (
                  <>
                    <dt>Type</dt>
                    <dd>{libelleTypeEcole[e.typeEcole]}</dd>
                  </>
                )}
                {e.programme && (
                  <>
                    <dt>Programme et langues</dt>
                    <dd>{e.programme}</dd>
                  </>
                )}
                {e.numeroEnseigne && (
                  <>
                    <dt>Numéro sur l'enseigne</dt>
                    <dd>
                      <a href={`tel:+${e.numeroEnseigne}`}>{afficherTelephone(e.numeroEnseigne)}</a>
                    </dd>
                  </>
                )}
              </dl>
            )}

            <section class="carte ou" aria-label="Où est l'école">
              <p>
                <b>Repère&nbsp;:</b> {e.repere ?? 'pas encore relevé'}
              </p>
              {itineraire && (
                <a class="bouton bouton-secondaire" href={itineraire}>
                  Y aller
                </a>
              )}
            </section>
          </div>

          <div class="fiche-cote">
            <section class="manque">
              <p class="surtitre-doux-public">Pas encore sur la fiche</p>
              <ul class="pastilles-vides">
                {!niveaux && <li>Niveaux</li>}
                {!typeSeLit && <li>Type d'école</li>}
                <li>Frais</li>
                <li>Photos de l'école</li>
                <li>Équipements</li>
                <li>Contact WhatsApp</li>
              </ul>
            </section>

            <aside class="ecoles-appel">
              <p>
                <b>Vous dirigez cette école&nbsp;?</b>
              </p>
              <p>Confirmez sa fiche et ajoutez photos, frais et contact.</p>
              <a class="bouton bouton-accent" href="/pour-les-ecoles/">
                Confirmer la fiche
              </a>
              {erreur && <a href={erreur}>Signaler une erreur</a>}
            </aside>
          </div>
        </div>
      </article>
    </PagePublique>
  )
)}

<style>
  .fiche {
    display: grid;
    gap: var(--espace-4);
  }
  .fiche h1 {
    margin: 0;
    font-family: var(--police-titre);
    font-size: var(--taille-titre-fiche);
    line-height: var(--interligne-titre);
  }
  .fiche p {
    margin: 0;
  }
  .etat {
    font-size: var(--taille-secondaire);
  }
  .etat-relevee-public {
    padding: var(--espace-3) var(--espace-4);
    border: 2px dashed var(--trait-fort);
    border-radius: var(--rayon-m);
    color: var(--texte-doux);
  }
  .etat-relevee-public b {
    color: var(--texte);
  }
  .proprietes {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--espace-3) var(--espace-4);
    margin: 0;
    padding: var(--espace-4);
  }
  .proprietes dt {
    color: var(--texte-doux);
    font-size: var(--taille-secondaire);
  }
  .proprietes dd {
    margin: 0;
    font-weight: 700;
    text-align: right;
  }
  .proprietes a {
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
    color: var(--marque);
  }
  .ou {
    display: grid;
    gap: var(--espace-3);
    padding: var(--espace-4);
  }
  .manque {
    display: grid;
    gap: var(--espace-2);
  }
  .surtitre-doux-public {
    color: var(--texte-doux);
    font-family: var(--police-titre);
    font-size: var(--taille-mention);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  /* Sur téléphone, les blocs se suivent : la fiche, puis ce qui manque, puis l'appel aux directions. */
  .fiche-corps,
  .fiche-principale,
  .fiche-cote {
    display: grid;
    gap: var(--espace-4);
  }

  /* À partir de 48 rem : une colonne plus aérée ; à partir de 64 rem, l'appel aux directions passe à droite. */
  @media (min-width: 48rem) {
    .fiche {
      gap: var(--espace-5);
      padding-block: var(--espace-7);
    }
    .fiche h1 {
      font-size: var(--taille-titre-public);
    }
    /* La colonne de la fiche garde la largeur d'une ligne de texte : cadre pointillé, cartes et texte alignés. */
    .fiche-corps {
      gap: var(--espace-5);
      max-width: var(--largeur-texte);
    }
    .fiche-principale,
    .fiche-cote {
      align-content: start;
      gap: var(--espace-5);
    }
    .proprietes {
      grid-template-columns: minmax(9rem, auto) 1fr;
    }
    .proprietes dt {
      align-self: center;
    }
    .proprietes dd {
      text-align: left;
    }
    .ou .bouton {
      justify-self: start;
    }
  }
  @media (min-width: 64rem) {
    .fiche-corps {
      grid-template-columns: minmax(0, var(--largeur-texte)) 22rem;
      gap: var(--espace-7);
      align-items: start;
      max-width: none;
    }
  }
</style>
