---
// Un coin d'un arrondissement vu de près (planche « Carte du quartier · un groupe vu de près ») :
// les écoles d'une pastille, chacune avec sa maison à drapeau, et leur liste en dessous. Sans
// JavaScript, le zoom est une autre page. Deux écoles qui se touchent encore (la même cour)
// restent une pastille, qui mène à la liste.
import type { GetStaticPaths } from 'astro';
import { PUBLIC_WHATSAPP } from 'astro:env/client';
import { obtenirCatalogue } from '../../../../infra/index';
import { distanceMetres } from '../../../../modele/geo';
import {
  arrondissementDessine,
  arrondissementsDessines,
  cadreCoin,
  coinsDe,
  planer,
  ruesDe,
  surCarte,
  type ArrondissementDessine,
  type MarqueGroupe,
} from '../../../../modele/carte/plan';
import { reperes } from '../../../../modele/carte/reperes';
import type { ArrondissementPublic, EcolePubliee } from '../../../../modele/ports';
import { lienWhatsApp } from '../../../../modele/whatsapp';
import Carte from '../../../../ui/Carte.astro';
import LegendeCarte from '../../../../ui/LegendeCarte.astro';
import ListeEcoles from '../../../../ui/ListeEcoles.astro';
import PagePublique from '../../../../ui/PagePublique.astro';

export const getStaticPaths = (async () => {
  const catalogue = await obtenirCatalogue();
  const [arrondissements, ecoles] = await Promise.all([
    catalogue.arrondissements(),
    catalogue.ecoles(),
  ]);
  return arrondissements.flatMap((a) => {
    const dessin = arrondissementDessine(a.slug);
    if (!dessin) return [];
    const siennes = ecoles.filter((e) => e.arrondissement === a.slug);
    return coinsDe(dessin, surCarte(siennes)).map((groupe) => ({
      params: { arrondissement: a.slug, coin: groupe.id },
      props: { arrondissement: a, dessin, groupe, ecoles: siennes },
    }));
  });
}) satisfies GetStaticPaths;

interface Props {
  arrondissement: ArrondissementPublic;
  dessin: ArrondissementDessine;
  groupe: MarqueGroupe;
  ecoles: EcolePubliee[];
}
const { arrondissement, dessin, groupe, ecoles } = Astro.props;
const { boite, projection } = cadreCoin(groupe.ecoles);
const plan = planer(boite, surCarte(ecoles), projection);
const ids = new Set(groupe.ecoles.map((e) => e.id));
const duCoin = ecoles.filter((e) => ids.has(e.id));

// Le titre : le repère connu le plus proche, à moins de 500 m du milieu du groupe.
const milieu = {
  latitude: groupe.ecoles.reduce((s, e) => s + e.latitude, 0) / groupe.ecoles.length,
  longitude: groupe.ecoles.reduce((s, e) => s + e.longitude, 0) / groupe.ecoles.length,
};
const repere = reperes
  .map((r) => ({ r, d: distanceMetres(milieu, r) }))
  .filter(({ d }) => d <= 500)
  .sort((a, b) => a.d - b.d)[0]?.r;
const titre = repere ? `Près de ${repere.nom}` : `Un coin de ${arrondissement.nom}`;
const carte = `/ecoles/${arrondissement.slug}/carte/`;
const whatsapp = lienWhatsApp(PUBLIC_WHATSAPP, 'Bonjour NTanova, ');
---

<PagePublique
  titre={`${titre} · NTanova`}
  description={`${duCoin.length} écoles proches à ${arrondissement.nom}, Pointe-Noire, vues de près sur la carte.`}
  whatsapp={whatsapp}
>
  <section class="cadre page vue-coin">
    <a class="retour" href={carte}>
      ← Carte de {arrondissement.nom}
    </a>
    <div>
      <h1>{titre}</h1>
      <p class="texte-doux">
        {duCoin.length} écoles proches · {arrondissement.nom} ·{' '}
        <span class="insecable">Pointe-Noire</span>
      </p>
    </div>

    <div class="disposition">
      <div class="colonne-carte">
        <Carte
          id="coin"
          titre={`${titre} : ${duCoin.length} écoles vues de près`}
          projection={projection}
          arrondissements={arrondissementsDessines.map((a) => ({
            arrondissement: a,
            role: a.slug === dessin.slug ? 'focus' : 'voisin',
          }))}
          rues={ruesDe(dessin.slug)}
          marques={plan.marques}
          lienGroupe={() => '#ecoles-du-coin'}
          reperes={reperes}
          nomsEcoles
        />
        <LegendeCarte groupes={plan.marques.some((m) => m.genre === 'groupe')} />
      </div>

      <div class="colonne-liste">
        <h2>Les écoles de ce coin</h2>
        <ListeEcoles ecoles={duCoin} id="ecoles-du-coin" />
      </div>
    </div>
  </section>
</PagePublique>

<style>
  .vue-coin {
    display: grid;
    gap: var(--espace-4);
  }
  .vue-coin h1 {
    margin: 0;
    color: var(--marque-appuyee);
    font-family: var(--police-titre);
    font-size: var(--taille-titre-page);
    line-height: var(--interligne-titre);
  }
  .vue-coin h2 {
    margin: 0;
    font-family: var(--police-titre);
    font-size: var(--taille-intertitre);
  }
  .vue-coin p {
    margin: 0;
  }
  .disposition,
  .colonne-carte,
  .colonne-liste {
    display: grid;
    align-content: start;
    gap: var(--espace-3);
  }
  .disposition {
    gap: var(--espace-5);
  }

  @media (min-width: 48rem) {
    .vue-coin {
      gap: var(--espace-5);
      padding-block: var(--espace-7);
    }
    .vue-coin h1 {
      font-size: var(--taille-titre-public);
    }
  }

  @media (min-width: 64rem) {
    .disposition {
      grid-template-columns: minmax(0, 3fr) minmax(16rem, 2fr);
      gap: var(--espace-6);
    }
    .colonne-liste :global(.ecoles) {
      grid-template-columns: 1fr;
    }
  }
</style>
