---
// Toutes les pages sous /ecoles/ : les lieux (ville, arrondissement, quartier ; un département qui n'est pas une ville),
// la fiche de chaque campus publié, et les renvois. Une seule route, construite à partir de la base ; aucun JavaScript.
// Les adresses (ticket 147, décision du fondateur du 08/11/2026) n'ont ni le pays ni le département :
//
//   /ecoles/pointe-noire/                 la ville (le département de même nom n'a pas sa propre page)
//   /ecoles/pointe-noire/tie-tie/         l'arrondissement
//   /ecoles/<nom>-<identifiant>/          la fiche d'un campus (`/ecoles/complexe-exemple-482913/`)
//   /ecoles/<identifiant>/                le lien court, qui y renvoie
//
// Le pays n'a plus de page : `/ecoles/` le porte (la liste, puis « Ville par ville »). Toute adresse d'avant
// (`/ecoles/congo/…`, `/ecoles/tie-tie/…`, l'ancien nom d'une fiche renommée, un doublon fusionné) renvoie en un saut.
import type { GetStaticPaths } from 'astro';
import { PUBLIC_WHATSAPP } from 'astro:env/client';
import { obtenirSite } from '../../infra/index';
import { lienCarteDuLieu } from '../../modele/carte/navigation';
import {
  deLieu,
  ecolesSous,
  lienDivision,
  lienEcole,
  lieuAvecPreposition,
  lieuEnPhrase,
} from '../../modele/geo-divisions';
import { cheminImagePartage, donneesEcole, preuveDePartage } from '../../modele/partage';
import { lienWhatsApp } from '../../modele/whatsapp';
import FicheEcole from '../../ui/FicheEcole.astro';
import PhotosEcole from '../../ui/fiche/PhotosEcole.astro';
import { VIGNETTES_SUR_LA_FICHE } from '../../modele/vitrine';
import HubDivision from '../../ui/HubDivision.astro';
import PagePublique from '../../ui/PagePublique.astro';

type Cas =
  | { genre: 'zone'; cle: string }
  | { genre: 'ecole'; cle: string }
  | { genre: 'photos'; cle: string }
  | { genre: 'renvoi'; vers: string };

export const getStaticPaths = (async () => {
  const { arbre, ecoles, redirections, anciennesAdresses } = await obtenirSite();
  const chemins = new Map<string, Cas>();
  // Une vraie page n'a qu'une adresse, et deux pages ne la partagent jamais : la construction s'arrête plutôt que d'en
  // cacher une (deux villes de même nom dans deux départements, par exemple).
  const poserPage = (chemin: string, cas: Cas) => {
    const deja = chemins.get(chemin);
    if (deja)
      throw new Error(`Deux pages pour /ecoles/${chemin}/ : ${JSON.stringify([deja, cas])}`);
    chemins.set(chemin, cas);
  };
  // Un renvoi ne remplace jamais une vraie page, ni un renvoi déjà posé.
  const poser = (chemin: string, cas: Cas) => {
    if (chemin !== '' && !chemins.has(chemin)) chemins.set(chemin, cas);
  };
  const sousEcoles = (lien: string) => lien.replace(/^\/ecoles\//, '').replace(/\/$/, '');

  // Les pages (ticket 147) : les lieux sans le pays ni le département, les fiches par leur nom et leur identifiant.
  for (const p of arbre.tous) {
    if (p.chemin.length > 0)
      poserPage(p.chemin.join('/'), { genre: 'zone', cle: p.adresse.join('/') });
  }
  for (const e of ecoles) poserPage(sousEcoles(lienEcole(e)), { genre: 'ecole', cle: e.id });
  // v2 (13/11) : toutes les photos d'une école, quand la fiche n'en montre qu'une partie (« Voir les N »).
  for (const e of ecoles)
    if ((e.medias?.galerie.length ?? 0) > VIGNETTES_SUR_LA_FICHE)
      poserPage(`${sousEcoles(lienEcole(e))}/photos`, { genre: 'photos', cle: e.id });

  // Les renvois, chacun en un seul saut vers l'adresse d'aujourd'hui.
  const parNumero = new Map(ecoles.map((e) => [e.numero, e]));
  const versLaFiche = (numero: string): Cas | null => {
    const e = parNumero.get(numero);
    return e ? { genre: 'renvoi', vers: lienEcole(e) } : null;
  };
  for (const e of ecoles) {
    const vers: Cas = { genre: 'renvoi', vers: lienEcole(e) };
    poser(e.numero, vers); // le lien court
    poser([...e.adresse, e.slug].join('/'), vers); // l'adresse d'avant : `/ecoles/congo/pointe-noire/tie-tie/<nom>/`
  }
  // Les lieux d'avant : `/ecoles/congo/pointe-noire/tie-tie/` ; le pays (`/ecoles/congo/`) mène à la liste.
  for (const p of arbre.tous)
    poser(p.adresse.join('/'), { genre: 'renvoi', vers: lienDivision(p.chemin) });
  // Une fiche renommée ou déplacée : ses anciennes adresses, des deux formes.
  for (const a of anciennesAdresses) {
    const vers = versLaFiche(a.numero);
    if (!vers) continue;
    poser(`${a.slug}-${a.numero}`, vers);
    poser([...a.chemin, a.slug].join('/'), vers);
  }
  // Un doublon fusionné : son lien court, son adresse et son adresse d'avant mènent à l'école gardée.
  for (const r of redirections) {
    const vers = versLaFiche(r.versNumero);
    if (!vers) continue;
    poser(r.de.numero, vers);
    poser(`${r.de.slug}-${r.de.numero}`, vers);
    poser([...r.de.chemin, r.de.slug].join('/'), vers);
  }
  // Les adresses d'avant les villes (`/ecoles/tie-tie/…`) : le relevé n'avait commencé qu'à Tié-Tié et à Ngoyo.
  for (const arrondissement of ['tie-tie', 'ngoyo']) {
    const page = arbre.parAdresse.get(`congo/pointe-noire/${arrondissement}`);
    if (!page) continue;
    poser(arrondissement, { genre: 'renvoi', vers: lienDivision(page.chemin) });
    for (const e of ecolesSous(page)) {
      poser(`${arrondissement}/${e.slug}`, { genre: 'renvoi', vers: lienEcole(e) });
    }
    // Son ancien plan dessiné mène à la carte du site, cadrée sur lui (ticket 146) ; les « coins » de ce plan renvoient
    // ici par `public/_redirects`.
    poser(`${arrondissement}/carte`, {
      genre: 'renvoi',
      vers: lienCarteDuLieu({
        contour: page.division.contour,
        position: page.division.position,
        ecoles: ecolesSous(page),
      }),
    });
  }
  return [...chemins].map(([chemin, cas]) => ({ params: { chemin }, props: cas }));
}) satisfies GetStaticPaths;

const cas = Astro.props as Cas;
const site = await obtenirSite();
const whatsapp = lienWhatsApp(PUBLIC_WHATSAPP, 'Bonjour NTanova, ');

const page = cas.genre === 'zone' ? site.arbre.parAdresse.get(cas.cle) : undefined;
const e = cas.genre === 'ecole' ? site.ecoles.find((x) => x.id === cas.cle) : undefined;
const ecoleDesPhotos =
  cas.genre === 'photos' ? site.ecoles.find((x) => x.id === cas.cle) : undefined;
const zone = e ? site.arbre.parId.get(e.divisionId) : undefined;
// Le lieu de la fiche dans ses phrases (description, message « Confirmer cette fiche ») : « Loandjili, Pointe-Noire ». Une fiche
// rattachée au pays lui-même n'a pas de lieu plus fin : le nom du pays, plutôt qu'une phrase vide.
const lieuDeLaFiche = e && zone ? lieuEnPhrase(e.quartier, zone.noms) || (zone.noms[0] ?? '') : '';
const autres = e
  ? site.ecoles.filter((x) => x.institutionId === e.institutionId && x.id !== e.id)
  : [];
// Ce qui contient le lieu, pour la description : « (Pointe-Noire) » sous Ngoyo ; ni le pays ni le lieu lui-même.
const dansLieu = page ? [...new Set(page.noms.slice(1, -1))].reverse().join(', ') : '';
// « Une école manque ? » : le message dit où, et, dans une zone sans école, que la personne la connaît ou la dirige.
const lieuDeLaPage = page ? lieuAvecPreposition(page.division.nom, page.division.niveau) : '';
const manque = page
  ? lienWhatsApp(
      PUBLIC_WHATSAPP,
      ecolesSous(page).length === 0
        ? `Bonjour NTanova, je connais ou je dirige une école ${lieuDeLaPage} : `
        : `Bonjour NTanova, une école manque ${lieuDeLaPage} : `,
    )
  : null;
const erreur = e
  ? lienWhatsApp(PUBLIC_WHATSAPP, `Bonjour NTanova, une erreur sur la fiche de ${e.nom} : `)
  : null;
// « Confirmer cette fiche » : le message part déjà avec le nom de l'école, son lieu et l'adresse de sa fiche, pour que NTanova
// sache de quelle fiche il s'agit sans rien redemander.
const confirmer =
  e && zone
    ? lienWhatsApp(
        PUBLIC_WHATSAPP,
        `Bonjour NTanova, je dirige ${e.nom}${e.etiquette ? ` (${e.etiquette})` : ''}, à ${lieuDeLaFiche}, et je souhaite ${e.etat === 'verifiee' ? 'mettre à jour' : 'confirmer'} sa fiche : ${new URL(lienEcole(e), Astro.site ?? Astro.url).href}`,
      )
    : null;
---

{cas.genre === 'renvoi' ? (
  <PagePublique
    titre="Fiche déplacée · NTanova"
    description="Cette page a une nouvelle adresse sur NTanova."
    whatsapp={whatsapp}
    renvoi={cas.vers}
  >
    <section class="cadre page">
      <h1>Cette page a une nouvelle adresse</h1>
      <a class="bouton" href={cas.vers}>
        Voir la page
      </a>
    </section>
  </PagePublique>
) : page ? (
  <PagePublique
    titre={`Les écoles ${deLieu(page.division.nom, page.division.niveau)}${page.division.niveau === 0 ? ', ville par ville' : ''} · NTanova`}
    description={`Les écoles ${deLieu(page.division.nom, page.division.niveau)}${dansLieu ? ` (${dansLieu})` : ''}, de la crèche au supérieur.`}
    whatsapp={whatsapp}
    nonIndexee={ecolesSous(page).length === 0}
  >
    <HubDivision page={page} manque={manque} />
  </PagePublique>
) : ecoleDesPhotos ? (
  <PagePublique
    titre={`Photos · ${ecoleDesPhotos.nom} · NTanova`}
    description={`Les photos de ${ecoleDesPhotos.nom}, contrôlées par NTanova.`}
    whatsapp={whatsapp}
  >
    <PhotosEcole e={ecoleDesPhotos} />
  </PagePublique>
) : e && zone ? (
  <PagePublique
    titre={`${e.nom}${e.etiquette ? ` (${e.etiquette})` : ''} · ${zone.division.nom} · NTanova`}
    description={`${e.nom}, à ${lieuDeLaFiche} : niveaux, formations, type, repère et itinéraire. ${preuveDePartage(e).texte}.`}
    whatsapp={whatsapp}
    image={{ chemin: cheminImagePartage(e), alt: `${e.nom} : ${preuveDePartage(e).texte}` }}
    donnees={donneesEcole(e, new URL(lienEcole(e), Astro.site ?? Astro.url).href)}
  >
    <FicheEcole e={e} zone={zone} autres={autres} erreur={erreur} confirmer={confirmer} />
  </PagePublique>
) : null}
