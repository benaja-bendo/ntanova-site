---
// « Les écoles » : une page, deux vues (lot 4 bis ; planches « Les écoles » de la version 46, feu vert du fondateur le
// 16/11/2026). Liste par défaut ; « Carte » ajoute `?vue=carte`. Recherche, filtres, tri et adresse sont les mêmes dans les deux
// vues : le lien partagé rouvre exactement ce qu'on voyait. `/carte/`, `/recherche/` et `/formations/` renvoient ici (301).
//
// La page construite montre déjà les 20 premières écoles (les vues sur place d'abord, les plus récentes en tête) et les filtres
// sans choix, avec leurs compteurs : la première école paraît au premier écran du téléphone, sans JavaScript. Le script de la
// page (`app/carte/liste-ecoles.ts`) lit `/recherche.json` au premier geste ; MapLibre ne vient qu'au toucher de « Carte ».
// La position n'est demandée qu'à l'appui d'« Autour de moi » ou de « Près de moi », et n'est envoyée à personne.
import { PUBLIC_WHATSAPP } from 'astro:env/client';
import { obtenirSite } from '../../infra/index';
import { donneesDeLaCarte } from '../../modele/carte/instantane';
import { htmlCarteEcole } from '../../modele/carte-ecole';
import { htmlFiltres } from '../../modele/filtres-html';
import { villesDeLAccueil } from '../../modele/accueil';
import { compterEcoles } from '../../modele/geo-divisions';
import {
  compterLesEcoles,
  etatVide,
  filtrer,
  groupesAffiches,
  LIBELLES_DES_CYCLES,
} from '../../modele/liste-ecoles';
import { avecMessage, lienWhatsApp } from '../../modele/whatsapp';
import Icone from '../../ui/Icone.astro';
import Marque from '../../ui/Marque.astro';
import PagePublique from '../../ui/PagePublique.astro';
import '../../ui/carte-pieces.css';
import '../../ui/carte-ecole.css';
import '../../ui/liste-ecoles.css';
import { PAR_PAGE } from '../../app/carte/liste-ecoles';

const site = await obtenirSite();
const whatsapp = lienWhatsApp(PUBLIC_WHATSAPP, 'Bonjour NTanova, ');
const manque = avecMessage(whatsapp, 'Bonjour NTanova, une école manque : ');
const lignes = site.recherche;
const domaines = new Map(site.domaines.map((d) => [d.slug, d.nom]));
const etat = etatVide();
const trouvees = filtrer(lignes, etat);
const groupes = groupesAffiches(lignes, etat, null, domaines);
const premieres = trouvees.slice(0, PAR_PAGE);
const confirmees = trouvees.filter((t) => t.ligne.v).length;
const villes = groupes.find((g) => g.groupe === 'ville')?.options ?? [];
const niveaux = groupes.find((g) => g.groupe === 'niveau')?.options ?? [];
const boite = donneesDeLaCarte(site).cadre.boite;
// Sans JavaScript, « Afficher plus » ne peut rien : les pages des villes gardent toutes leurs écoles.
const villesDuPied = villesDeLAccueil(site.arbre);
---

<PagePublique
  titre="Les écoles du Congo-Brazzaville · NTanova"
  description="Les écoles du Congo-Brazzaville, de la crèche au supérieur : par nom, quartier, repère, niveau, formation ou type, près de vous, en liste ou sur la carte."
  whatsapp={whatsapp}
>
  <section
    class="cadre liste-ecoles"
    data-liste
    data-vue-actuelle="liste"
    data-domaines={JSON.stringify([...domaines])}
  >
    <div class="liste-tete">
      <h1 data-titre>Les écoles</h1>
      <p class="texte-doux" data-sous-titre>
        {compterLesEcoles(trouvees.length)}
        {confirmees > 0 &&
          ` · ${confirmees} confirmée${confirmees > 1 ? 's' : ''} par leur direction`}
      </p>
    </div>

    <div class="liste-outils">
      <form class="liste-recherche" data-recherche action="/ecoles/" method="get" role="search">
        <label class="visuellement-cache" for="liste-q">
          Chercher une école
        </label>
        <Icone nom="loupe" petite={false} />
        <input
          id="liste-q"
          class="champ"
          type="search"
          name="q"
          autocomplete="off"
          placeholder="Nom, sigle, quartier ou repère"
        />
        <button class="bouton seulement-large" type="submit">
          Chercher
        </button>
      </form>
      <label class="liste-tri">
        <span class="visuellement-cache">Trier</span>
        <select class="champ" data-tri>
          <option value="recentes">Récemment vues</option>
          <option value="proches">Près de moi</option>
          <option value="nom">Par nom</option>
        </select>
      </label>
      <div class="liste-vues" role="group" aria-label="Vue">
        <a class="liste-vue" href="/ecoles/" data-vue="liste" aria-pressed="true">
          <Icone nom="liste" />
          Liste
        </a>
        <a class="liste-vue" href="/ecoles/?vue=carte" data-vue="carte" aria-pressed="false">
          <Icone nom="plan" />
          Carte
        </a>
      </div>
    </div>

    <div class="liste-barre">
      <button type="button" class="pastille-choix bouton-filtres" data-ouvrir-filtres>
        <Icone nom="reglages" />
        Filtres
        <span class="filtres-nombre" data-nombre-filtres hidden>
          0
        </span>
      </button>
      <div class="liste-puces" data-puces>
        <button type="button" class="pastille-choix" data-rayon="3000" aria-pressed="false">
          <Icone nom="cible" />
          Autour de moi
        </button>
        {villes.map((o) => (
          <button
            type="button"
            class="pastille-choix"
            data-groupe="ville"
            data-valeur={o.valeur}
            aria-pressed="false"
          >
            {o.libelle} <span class="filtre-nombre">({o.nombre})</span>
          </button>
        ))}
        {niveaux.map((o) => (
          <button
            type="button"
            class="pastille-choix avec-disque"
            data-groupe="niveau"
            data-valeur={o.valeur}
            aria-pressed="false"
          >
            <span class={`disque disque-s c-${o.valeur}`} aria-hidden="true">
              {o.valeur}
            </span>
            {LIBELLES_DES_CYCLES[o.valeur]}
          </button>
        ))}
      </div>
    </div>

    <div class="liste-corps">
      <aside class="liste-filtres" data-filtres aria-labelledby="titre-filtres">
        <div class="filtres-fond" data-fond-filtres></div>
        <div class="filtres-feuille" role="dialog" aria-labelledby="titre-filtres">
          <div class="filtres-tete">
            <h2 id="titre-filtres">Filtres</h2>
            <button type="button" class="lien-fort filtres-effacer-haut" data-effacer>
              Effacer tout
            </button>
            <button
              type="button"
              class="bouton-rond filtres-fermer"
              data-fermer-filtres
              aria-label="Fermer les filtres"
            >
              ×
            </button>
          </div>
          <div
            class="filtres-corps"
            data-filtres-corps
            set:html={htmlFiltres(groupes, etat, null)}
          />
          <div class="filtres-pied">
            <button type="button" class="bouton bouton-secondaire" data-effacer>
              Effacer tout
            </button>
            <button type="button" class="bouton" data-voir>
              Voir {compterLesEcoles(trouvees.length)}
            </button>
          </div>
        </div>
      </aside>

      <div class="liste-resultats">
        <div class="resultats-tete">
          <p class="texte-doux liste-message" role="status" data-message></p>
        </div>
        <ul class="cartes-liste" data-cartes aria-live="polite">
          {premieres.map((t, i) => (
            <li set:html={htmlCarteEcole(t.ligne, { forme: 'ligne', prioritaire: i < 2 })} />
          ))}
        </ul>
        <div class="liste-vide" data-vide hidden>
          <h2>Aucune école ne répond à tous ces choix</h2>
          <p>Retirez un choix&nbsp;:</p>
          <ul class="liste-sorties" data-sorties></ul>
          {/* Lot 1 de la refonte : un lieu de « Où ? » qui ne trouve rien se corrige ici, sans perdre les autres choix. */}
          <form class="liste-lieu" data-modifier-lieu action="/ecoles/" method="get" hidden>
            <label for="liste-ou">Modifier le lieu</label>
            <div class="liste-lieu-ligne">
              <input
                id="liste-ou"
                class="champ"
                type="search"
                name="ou"
                autocomplete="off"
                placeholder="Ville, arrondissement, quartier"
              />
              <button class="bouton bouton-secondaire" type="submit">
                Chercher
              </button>
            </div>
          </form>
          {manque && (
            <p>
              Une école manque&nbsp;? <a href={manque}>Dites-le-nous sur WhatsApp</a>
            </p>
          )}
        </div>
        <button
          type="button"
          class="bouton bouton-secondaire liste-plus"
          data-plus
          hidden={trouvees.length <= PAR_PAGE}
        >
          Afficher {Math.min(trouvees.length - PAR_PAGE, PAR_PAGE)} de plus
        </button>
        <p class="texte-doux liste-affiche" data-affiche>
          {premieres.length} sur {trouvees.length} écoles affichées
        </p>
        <noscript>
          <p class="liste-sans-js">
            Toutes les écoles, ville par ville&nbsp;:
            {villesDuPied.map((v, i) => (
              <>
                {i > 0 && ' · '}
                <a href={v.lien}>
                  {v.nom} ({compterEcoles(v.total)})
                </a>
              </>
            ))}
          </p>
        </noscript>
      </div>

      <div
        class="zone-carte"
        data-zone-carte
        data-boite={JSON.stringify(boite)}
        data-etat="attente"
      >
        <div class="zone-carte-toile" data-toile role="region" aria-label="Carte des écoles"></div>
        <div class="zone-carte-attente" aria-hidden="true">
          <Marque />
          <p class="zone-carte-lente">
            La connexion est lente&nbsp;: la liste reste là, aux mêmes filtres.
          </p>
        </div>
        <p class="zone-carte-aucune">Aucune de ces écoles n’a de position sur la carte.</p>
        <p class="zone-carte-note zone-carte-fond">
          Le fond de carte ne se charge pas&nbsp;: les zones et les écoles restent là.
        </p>
        <div class="zone-carte-note zone-carte-sans">
          <p>Ce téléphone ne peut pas afficher la carte. La liste, elle, reste là.</p>
          <a class="bouton" href="/ecoles/" data-vue="liste">
            Voir la liste
          </a>
        </div>
        <button type="button" class="bouton-chercher" data-chercher-zone hidden>
          <Icone nom="cible" />
          Chercher dans cette zone
        </button>
        <a class="bouton liste-retour" href="/ecoles/" data-vue="liste">
          <Icone nom="liste" />
          Liste
        </a>
        <div class="apercu-bas" data-apercu hidden></div>
      </div>
    </div>
  </section>
</PagePublique>

<script>
  import { demarrerListe } from '../../app/carte/liste-ecoles';
  const racine = document.querySelector<HTMLElement>('[data-liste]');
  if (racine) demarrerListe(racine);
</script>
