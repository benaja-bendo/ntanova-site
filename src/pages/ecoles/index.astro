---
// L'entrée des écoles : le pays, ses villes et départements avec ce que chacun compte d'écoles publiées, et les
// trois autres façons de chercher (par nom ou par formation, par ce qu'on enseigne, autour de soi).
// Construite à partir de la base ; aucun JavaScript.
import { PUBLIC_WHATSAPP } from 'astro:env/client';
import { obtenirSite } from '../../infra/index';
import { etatPublicDe, libelleDeploiement } from '../../modele/etat-zone';
import { compterEcoles, ecolesSous, lienDivision, nomAffiche } from '../../modele/geo-divisions';
import { lienWhatsApp } from '../../modele/whatsapp';
import PagePublique from '../../ui/PagePublique.astro';

const { arbre, ecoles, divisions } = await obtenirSite();
// Une ville sans école dit son état public (le même que la carte), jamais « 0 écoles » ni « relevé en cours » par défaut.
const detailDe = (enfant: (typeof arbre.racines)[number]) => {
  const n = ecolesSous(enfant).length;
  const etat = etatPublicDe(enfant.division, divisions);
  const morceaux = [n > 0 ? compterEcoles(n) : null, etat ? libelleDeploiement[etat] : null].filter(
    (x): x is string => x !== null,
  );
  return morceaux.length > 0 ? morceaux.join(' · ') : 'aucune école publiée';
};
const whatsapp = lienWhatsApp(PUBLIC_WHATSAPP, 'Bonjour NTanova, ');
const manque = lienWhatsApp(PUBLIC_WHATSAPP, 'Bonjour NTanova, une ville manque : ');
---

<PagePublique
  titre="Les écoles du Congo-Brazzaville · NTanova"
  description="Les écoles du Congo-Brazzaville publiées sur NTanova : par ville et par quartier, par formation, ou autour de vous."
  whatsapp={whatsapp}
>
  <section class="cadre page entree">
    <a class="retour" href="/">
      ← Accueil
    </a>
    <div>
      <h1>Les écoles</h1>
      <p class="texte-doux">
        {ecoles.length === 0
          ? 'Aucune école n’est encore publiée : le relevé commence.'
          : `${compterEcoles(ecoles.length)} publiée${ecoles.length > 1 ? 's' : ''}.`}
      </p>
    </div>

    <nav class="chercher" aria-label="Chercher une école">
      <a class="bouton" href="/recherche/">
        Rechercher par nom ou par formation
      </a>
      <a class="bouton bouton-secondaire" href="/autour-de-moi/">
        Autour de moi
      </a>
      <a class="bouton bouton-secondaire" href="/formations/">
        Séries, diplômes, domaines
      </a>
    </nav>

    {arbre.racines.map((racine) => (
      <section aria-label={racine.division.nom} class="pays">
        <h2>
          <a href={lienDivision(racine.adresse)}>
            {nomAffiche(racine.division.nom, racine.division.niveau)}
          </a>
          <span class="texte-doux"> · {compterEcoles(ecolesSous(racine).length)}</span>
        </h2>
        <ul class="zones">
          {racine.enfants.map((enfant) => (
            <li>
              <a class="zone" href={lienDivision(enfant.adresse)}>
                <span class="zone-nom">{enfant.division.nom}</span>
                <span class="zone-detail">{detailDe(enfant)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <div class="encadre-pointille">
      <p>
        Le relevé continue ville après ville&nbsp;: une ville apparaît ici dès que son déploiement
        est programmé ou qu'une première école est publiée.
      </p>
      {manque && <a href={manque}>Une ville manque&nbsp;? Dites-le-nous sur WhatsApp</a>}
    </div>
  </section>
</PagePublique>

<style>
  .entree {
    display: grid;
    gap: var(--espace-4);
  }
  .entree h1 {
    margin: 0;
    color: var(--marque-appuyee);
    font-family: var(--police-titre);
    font-size: var(--taille-titre-page);
    line-height: var(--interligne-titre);
  }
  .entree h2 {
    margin: 0;
    font-family: var(--police-titre);
    font-size: var(--taille-intertitre);
  }
  .entree h2 a {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
    color: var(--texte);
  }
  .entree p {
    margin: 0;
  }
  .chercher {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ecart-cibles);
  }
  .pays {
    display: grid;
    gap: var(--espace-3);
  }
  .zones {
    display: grid;
    gap: var(--espace-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .zone {
    display: grid;
    gap: var(--espace-1);
    min-height: var(--cible-principale);
    padding: var(--espace-3) var(--espace-4);
    border-radius: var(--rayon-m);
    background: var(--carte-releve-en-cours);
    color: var(--texte);
    text-decoration: none;
  }
  .zone:hover {
    outline: 2px solid var(--marque);
  }
  .zone-nom {
    font-family: var(--police-titre);
    font-weight: 700;
  }
  .zone-detail {
    color: var(--marque-appuyee);
    font-size: var(--taille-secondaire);
  }
  .encadre-pointille a {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
    color: var(--marque);
    font-weight: 700;
  }

  @media (min-width: 48rem) {
    .entree {
      gap: var(--espace-5);
      padding-block: var(--espace-7);
    }
    .entree h1 {
      font-size: var(--taille-titre-public);
    }
    .zones {
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
      gap: var(--espace-3);
    }
  }
</style>
