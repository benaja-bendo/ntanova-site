---
// Confidentialité (ticket 149, décision du fondateur du 08/11/2026) : la partie « données personnelles » de l'ancienne page
// « À propos », complétée de ce que l'article 46 de la loi n° 29-2019 demande d'écrire au plus tard à la collecte : le
// responsable, les finalités, les catégories de données, les destinataires, la durée de conservation, les transferts hors du
// Congo, les droits. Ce que NTanova ne sait pas encore reste entre crochets (rien n'est inventé).
//
// Refonte, lot 3C (24/11/2026) : les seules mentions que les formulaires rendaient inexactes ont changé, À RELIRE PAR UNE PERSONNE
// AVANT LA PRODUCTION (liste dans docs/refonte-site-public.md). Celles qui décrivent les formulaires ne paraissent que s'ils sont
// ouverts (`formulairesOuverts`) : fermé, la page dit toujours ce qui est vrai aujourd'hui. Rien n'y annonce l'adresse IP d'une
// personne qui écrit : la limite par connexion reste inactive.
//
// Recette, lot 6 (25/11/2026) : ce que le code et les réglages disent est écrit (paie des relais, demandes de vérification et nombre
// gardé par le navigateur, sauvegardes chez GitHub, courrier chez Infomaniak, CNPD lue au Journal officiel). Restent entre crochets les
// durées et la démarche auprès de la CNPD, que seul le fondateur connaît. Les membres de la CNPD sont nommés par le décret n° 2025-538
// du 31 décembre 2025 (Journal officiel n° 5-2026) ; aucune adresse de contact trouvée.
import { DELAI_DROITS_JOURS, LIEN_METHODE, LIEN_DONNEES } from '../modele/pages-de-confiance';
import { REGLAGES } from '../modele/demandes';
import ContactNtanova from '../ui/ContactNtanova.astro';
import { formulairesOuverts } from '../ui/formulaires/ouverture';
import PageDeTexte from '../ui/PageDeTexte.astro';

const TEXTE_DU = '25 novembre 2026';

// Les données gardées, une par ligne : pourquoi, qui les voit, combien de temps. Les durées restent à fixer par le fondateur.
const DONNEES: { nom: string; quoi: string; pourquoi: string; qui: string; duree: string }[] = [
  {
    nom: 'La fiche publique d’une école',
    quoi: 'Nom, enseigne, position, niveaux, type, repère, numéro affiché sur l’enseigne, preuves et leurs dates.',
    pourquoi: 'Faire connaître les écoles aux familles.',
    qui: 'Tout le monde, sur ntanova.com.',
    duree:
      'Tant que la fiche est publiée ; retirée à votre demande. [Durée de conservation après un retrait : à fixer.]',
  },
  {
    nom: 'Ce que l’école accepte de publier',
    quoi: 'Frais, contact, mot de la direction.',
    pourquoi: 'Informer les familles.',
    qui: 'Tout le monde, avec l’accord daté de la direction.',
    duree: 'Tant que l’accord vaut ; retiré à votre demande.',
  },
  {
    nom: 'Les photos publiées',
    quoi: 'Photo de l’enseigne, couverture et photos du lieu retenues par l’équipe.',
    pourquoi: 'Montrer l’établissement aux familles.',
    qui: 'Tout le monde, après contrôle : sans enfant ni personne reconnaissable.',
    duree:
      'Tant que la photo est publiée ; retirée à votre demande. [Durée de conservation après un retrait : à fixer.]',
  },
  {
    nom: 'Le contact privé de la direction',
    quoi: 'Nom, fonction, numéro de téléphone, date de l’accord ; ou le numéro de l’école lu sur un document, son enseigne, son site ou sa page.',
    pourquoi: 'Vérifier la fiche et écrire à la direction à ce sujet.',
    qui: 'NTanova seul. Jamais publié.',
    duree: '[À fixer.]',
  },
  {
    nom: 'Les photos non publiées',
    quoi: 'Photos envoyées par les relais et non retenues pour le site.',
    pourquoi: 'Vérifier la fiche.',
    qui: 'NTanova seul.',
    duree: '[À fixer.]',
  },
  {
    nom: 'Les relais',
    quoi: 'Prénom, adresse de connexion Google, identifiant du compte Google, fiches envoyées ; pour la paie : opérateur et numéro de paiement mobile, nom du titulaire, montants et dates.',
    pourquoi: 'Faire relever les écoles, vérifier le travail, payer.',
    qui: 'NTanova seul. Le nom d’un relais n’apparaît jamais sur le site.',
    duree: '[À fixer.]',
  },
  {
    nom: 'Le journal technique de l’application des relais',
    quoi: 'Type de téléphone, version de l’application, erreurs rencontrées.',
    pourquoi: 'Réparer l’application.',
    qui: 'NTanova seul.',
    duree: '[À fixer.]',
  },
  {
    nom: 'Les demandes de vérification d’une fiche',
    quoi: 'La fiche, le jour et une empreinte tirée d’un nombre au hasard gardé dans votre navigateur. Ni nom, ni numéro.',
    pourquoi:
      'Savoir quelles fiches vérifier d’abord, en ne comptant qu’une demande par appareil et par jour.',
    qui: 'NTanova seul.',
    duree: '[À fixer.]',
  },
  ...(formulairesOuverts
    ? [
        {
          nom: 'Vos messages par un formulaire du site',
          quoi: 'Ce que vous écrivez dans « Écrire à NTanova » ou « Compléter ou corriger l’annuaire », avec le numéro, l’adresse ou le nom que vous laissez.',
          pourquoi:
            'Traiter votre message et, si vous le demandez, vous répondre. Une personne vous répond, sur WhatsApp ou par e-mail.',
          qui: 'NTanova seul, dans une base privée. Jamais publié.',
          duree: `${REGLAGES.closeMois} mois après la clôture, puis effacés automatiquement ; ${REGLAGES.indesirableJours} jours pour un message indésirable. Les sauvegardes les gardent jusqu’à 30 jours de plus.`,
        },
        {
          nom: 'Nos échanges sur WhatsApp ou par e-mail',
          quoi: 'Ce que vous écrivez sur WhatsApp ou par e-mail, et nos réponses.',
          pourquoi: 'Vous répondre.',
          qui: 'NTanova. WhatsApp est un service de Meta.',
          duree:
            'Ils restent dans WhatsApp et dans la boîte de NTanova : l’effacement automatique du site ne les atteint pas. [Durée à fixer.]',
        },
      ]
    : [
        {
          nom: 'Vos messages à NTanova',
          quoi: 'Ce que vous écrivez sur WhatsApp ou par e-mail.',
          pourquoi: 'Vous répondre.',
          qui: 'NTanova. WhatsApp est un service de Meta.',
          duree: '[À fixer.]',
        },
      ]),
];
---

<PageDeTexte
  titre="Confidentialité : vos données personnelles · NTanova"
  description="Ce que NTanova publie, ce qu’il garde pour lui, qui reçoit quoi, où sont les données, combien de temps, et comment corriger, retirer ou effacer."
  surtitre="Transparence"
  intitule="Vos données personnelles"
>
  <Fragment slot="chapeau">
    <p class="texte-doux">
      NTanova publie des informations sur des écoles. Cette page dit ce qui se rapporte à des
      personnes, qui le voit, où cela est gardé et comment faire corriger, retirer ou effacer. Texte
      du {TEXTE_DU}.
    </p>
    <ContactNtanova
      message="Bonjour NTanova, une question sur mes données : "
      formulaire={{
        arrivee: { vers: 'contact', depuis: 'confidentialite', sujet: 'donnees' },
        texte: 'Écrire à NTanova',
      }}
    />
  </Fragment>

  <section class="carte bloc large" id="ce-que-nous-gardons">
    <h2>Ce que nous publions et ce que nous gardons</h2>
    <p>
      Pour chaque école, nous publions ce qui se voit de la rue&nbsp;: nom, enseigne, position,
      niveaux, numéro écrit sur l’enseigne. Frais, contact et mot de la direction ne sont publiés
      qu’avec l’accord daté de la direction. Les photos sont contrôlées une à une, sans enfant ni
      personne reconnaissable&nbsp;: <a href={`${LIEN_METHODE}#m-photos`}>les règles des photos</a>.
      Une fiche décrit un établissement, pas une personne&nbsp;; un numéro de téléphone peut
      pourtant se rapporter à une personne, et vous pouvez demander qu’il soit retiré.
    </p>
    <ul class="registre">
      {DONNEES.map((d) => (
        <li>
          <strong>{d.nom}</strong>
          <dl>
            <dt>Quoi</dt>
            <dd>{d.quoi}</dd>
            <dt>Pourquoi</dt>
            <dd>{d.pourquoi}</dd>
            <dt>Qui la voit</dt>
            <dd>{d.qui}</dd>
            <dt>Combien de temps</dt>
            <dd class={d.duree.includes('[') ? 'a-completer' : undefined}>{d.duree}</dd>
          </dl>
        </li>
      ))}
    </ul>
    <p>
      Rien n’est obligatoire pour une école&nbsp;: sans réponse de sa direction, la fiche reste ce
      qu’un relais a vu de la rue ou ce que l’équipe en connaît. Le numéro d’une personne n’est
      gardé que si elle l’accepte.
    </p>
  </section>

  <section class="carte bloc" id="ou-sont-les-donnees">
    <h2>Où sont les données</h2>
    <ul>
      <li>
        <strong>Base de données et photos</strong>&nbsp;: Supabase, région Paris (France).
      </li>
      <li>
        <strong>Site et fond de carte</strong>&nbsp;: Cloudflare.
      </li>
      <li>
        <strong>Connexion des relais</strong>&nbsp;: Google.
      </li>
      {formulairesOuverts ? (
        <>
          <li>
            <strong>Messages des formulaires</strong>&nbsp;: une base privée chez Supabase, région
            Paris.
          </li>
          <li>
            <strong>Autres messages et réponses</strong>&nbsp;: WhatsApp (Meta) ou e-mail
            (Infomaniak, Suisse).
          </li>
        </>
      ) : (
        <li>
          <strong>Messages</strong>&nbsp;: WhatsApp (Meta) ou e-mail (Infomaniak, Suisse).
        </li>
      )}
      <li>
        <strong>Sauvegardes chiffrées de la base et des photos</strong>&nbsp;: GitHub (Microsoft),
        pendant 30&nbsp;jours.
      </li>
      <li>
        <strong>Carte de position de l’application des relais</strong>&nbsp;: quand un relais
        l’ouvre, son navigateur demande des morceaux de carte aux serveurs d’OpenStreetMap, qui
        voient son adresse IP et la zone demandée.
      </li>
    </ul>
    <p>
      Ces services sont hors du Congo-Brazzaville. La loi n°&nbsp;29-2019 (article&nbsp;23)
      n’autorise le transfert de données personnelles vers un autre pays que s’il assure une
      protection suffisante, et demande d’en informer la commission chargée de la protection des
      données, la CNPD.{' '}
      <span class="a-completer">[Où en est cette démarche&nbsp;: à renseigner.]</span>
    </p>
  </section>

  <section class="carte bloc" id="visiteurs">
    <h2>Les familles qui visitent le site</h2>
    <p>
      Pas de compte, pas de cookie, pas de mesure de votre navigation. Comme tout hébergeur,
      Cloudflare reçoit l’adresse IP de votre appareil pour vous envoyer les pages.
    </p>
    <p>
      Le bouton «&nbsp;Demander la vérification&nbsp;» d’une fiche garde dans votre navigateur un
      nombre tiré au hasard. Nous n’en recevons qu’une empreinte, qui change chaque jour.
    </p>
    <h3>Votre position sur la carte</h3>
    <p>
      Le bouton «&nbsp;Ma position&nbsp;» demande votre accord. NTanova ne conserve pas vos
      coordonnées GPS. Le fond de carte est servi par Cloudflare&nbsp;: les demandes de tuiles
      correspondent à la zone que vous consultez. Le partage d’une école transmet sa position, pas
      votre position personnelle.
    </p>
    {formulairesOuverts ? (
      <>
        <h3>Quand vous nous écrivez</h3>
        <p>
          Vos messages partent par un formulaire du site ou sur WhatsApp. Pendant que vous écrivez
          dans un formulaire, votre texte reste dans l’onglet de votre navigateur, 24&nbsp;heures au
          plus après votre dernière saisie&nbsp;; il en est effacé quand l’envoi est confirmé.
        </p>
      </>
    ) : (
      <p>Vos messages partent sur WhatsApp.</p>
    )}
  </section>

  <section class="carte bloc" id="relais">
    <h2>Les relais</h2>
    <p>
      Les jeunes qui relèvent les écoles se connectent avec leur compte Google. Seuls leur prénom,
      leur adresse de connexion et l’identifiant de leur compte sont lus&nbsp;; NTanova n’accède à
      rien d’autre dans leur compte. Leur nom n’apparaît jamais sur le site.
    </p>
  </section>

  <section class="carte bloc" id="enfants">
    <h2>Les enfants</h2>
    <p>
      Le site ne contient aucune donnée sur des élèves. Nous demandons aux relais de ne jamais
      photographier un enfant&nbsp;; une photo qui en montre un n’est pas publiée.
    </p>
  </section>

  <section class="carte bloc large" id="droits">
    <h2>Vos droits</h2>
    <p>
      Vous pouvez demander, en montrant que vous êtes concerné, à voir ce qui vous concerne, à le
      corriger, à le retirer ou à l’effacer&nbsp;: une fiche, un numéro, un contact. Nous ne
      demandons pas de pièce d’identité par défaut. Écrivez-nous&nbsp;: nous le faisons dans notre
      base <span class="insecable">sous {DELAI_DROITS_JOURS} jours</span>.
    </p>
    <h3>Ce que cela veut dire sur le site</h3>
    <ul>
      <li>
        Le site est mis à jour par étapes&nbsp;: une correction n’est visible sur ntanova.com qu’à
        la mise en ligne suivante. Pour le retrait d’une fiche ou l’effacement d’un numéro, nous
        demandons cette mise en ligne sans attendre, et nous vous disons le résultat une fois
        constaté sur le site.
      </li>
      <li>
        Les moteurs de recherche et les aperçus de lien (par exemple dans WhatsApp) peuvent garder
        une copie plus longtemps&nbsp;: nous ne pouvons pas l’effacer chez eux.
      </li>
    </ul>
    <p>
      Si vous estimez que vos droits ne sont pas respectés, vous pouvez vous adresser à la
      commission nationale pour la protection des données à caractère personnel (CNPD), dont le
      siège est à Brazzaville&nbsp;: elle reçoit les réclamations et les plaintes. Nous n’avons pas
      trouvé ses coordonnées publiées au 25&nbsp;novembre 2026.
    </p>
    <ContactNtanova
      message="Bonjour NTanova, je voudrais faire corriger, retirer ou effacer : "
      formulaire={{
        arrivee: { vers: 'retrait', depuis: 'confidentialite' },
        texte: 'Demander un retrait',
      }}
    />
  </section>

  <div class="references">
    <p>
      Référence&nbsp;: loi congolaise n°&nbsp;29-2019 du 10&nbsp;octobre 2019 portant protection des
      données à caractère personnel (Journal officiel n°&nbsp;45-2019)&nbsp;; loi n°&nbsp;5-2025 du
      29&nbsp;mars 2025 portant création de la CNPD (Journal officiel n°&nbsp;15-2025).
    </p>
    <p>
      Comment les fiches sont tenues&nbsp;: <a href={LIEN_METHODE}>Fiabilité des informations</a>.
      Ce qui est publié, en chiffres&nbsp;: <a href={LIEN_DONNEES}>Données de l’annuaire</a>.
    </p>
  </div>
</PageDeTexte>

<style>
  .registre {
    display: grid;
    gap: var(--espace-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .registre li {
    display: grid;
    gap: var(--espace-1);
    padding-top: var(--espace-3);
    border-top: 1px solid var(--trait);
  }
  .registre dl {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--espace-1) var(--espace-3);
    margin: 0;
    font-size: var(--taille-secondaire);
  }
  .registre dt {
    color: var(--texte-doux);
  }
  .registre dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
</style>
