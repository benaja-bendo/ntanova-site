---
// L'accueil (refonte publique, lot 1, 24/11/2026 ; canevas « Accueil : trois directions », exploration « Points de repère »,
// planches « Accueil » ordinateur et téléphone, état « Aujourd'hui » seulement). Le lancement du lot par le fondateur accepte
// l'accueil illustré et son menu : ils remplacent « le premier écran sans image » et « les trois piliers sans Menu » du 15/11.
//
// L'ordre de lecture : la promesse et la recherche « Quoi ? / Où ? », cinq repères (deux services disponibles, trois en
// préparation, sans bouton), les mentions datées, S'orienter, les villes, les directions. Aucun JavaScript : la recherche est
// un formulaire qui ouvre « Les écoles » (`/ecoles/?q=…&ou=…`), le reste des liens. Chaque nombre, ville, niveau et date est
// calculé à la construction depuis le catalogue (`modele/accueil.ts`, `modele/carte-accueil.ts`).
//
// Ce que la page ne promet pas encore : les échanges, les demandes et leur suivi (en préparation, sans faux bouton) ; les
// activités de la future page S'orienter (lot 2) ; les formulaires de contact (lot 3) : écrire passe par WhatsApp.
import { PUBLIC_WHATSAPP } from 'astro:env/client';
import { obtenirSite } from '../infra/index';
import {
  arrondissementsCites,
  jourEtMois,
  niveauxDeLAccueil,
  profilsDeLAccueil,
  villesDeLAccueil,
  voirLesEcoles,
} from '../modele/accueil';
import { carteDeLAccueil } from '../modele/carte-accueil';
import { jourDuCongo } from '../modele/date-declaration';
import { compterEcoles } from '../modele/geo-divisions';
import { LIEN_METHODE } from '../modele/pages-de-confiance';
import { avecMessage, lienWhatsApp } from '../modele/whatsapp';
import DessinCongo from '../ui/DessinCongo.astro';
import Icone from '../ui/Icone.astro';
import PagePublique from '../ui/PagePublique.astro';
import RechercheAccueil from '../ui/RechercheAccueil.astro';
// Le trait des icônes (`.ico`), comme sur les autres pages publiques.
import '../ui/carte-pieces.css';

const { arbre, ecoles } = await obtenirSite();
const villes = villesDeLAccueil(arbre);
const niveaux = niveauxDeLAccueil(ecoles);
const profils = profilsDeLAccueil(ecoles);
const carte = carteDeLAccueil(arbre);
const jour = jourEtMois(jourDuCongo());
const whatsapp = lienWhatsApp(PUBLIC_WHATSAPP, 'Bonjour NTanova, ');
const manque = avecMessage(whatsapp, 'Bonjour NTanova, une école manque : ');
const DEMO = '/demo/fiche-ecole/';
// Le moteur de recherche du site, pour les moteurs : la recherche « Quoi ? » de « Les écoles ».
const site = new URL('/', Astro.site ?? Astro.url).href;
const donnees = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'NTanova',
  url: site,
  inLanguage: 'fr',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${site}ecoles/?q={q}`,
    'query-input': 'required name=q',
  },
};
---

<PagePublique
  titre="NTanova · Des repères pour choisir une école au Congo-Brazzaville"
  description="Cherchez une école au Congo-Brazzaville, de la maternelle au supérieur, par nom, formation ou lieu, puis lisez sa fiche : des informations datées, avec leur origine."
  whatsapp={whatsapp}
  donnees={donnees}
  typeOg="website"
>
  <section class="heros sur-marque" aria-labelledby="titre-accueil">
    <div class="cadre heros-grille">
      <div class="heros-texte">
        <p class="heros-surtitre">
          Congo-Brazzaville<span class="seulement-large"> · de la maternelle au supérieur</span>
        </p>
        <h1 id="titre-accueil">
          Des <span class="heros-accent">repères</span> pour choisir une école.
        </h1>
        <p class="heros-chapeau">
          Cherchez une école, puis lisez sa fiche&nbsp;: des informations datées, avec leur origine.
        </p>
        <RechercheAccueil />
        <div class="heros-raccourcis">
          <a class="lien-clair lien-autour" href="/ecoles/?autour=3">
            <Icone nom="cible" />
            Autour de moi
          </a>
          {niveaux.length > 0 && (
            <nav class="heros-niveaux" aria-label="Chercher par niveau">
              <span class="heros-niveaux-titre">Par niveau&nbsp;:</span>
              {niveaux.map((n) => (
                <a class="lien-clair" href={n.lien}>
                  {n.mot}
                </a>
              ))}
            </nav>
          )}
        </div>
        <a class="heros-orienter" href="/orienter/">
          <span class="heros-orienter-rond" aria-hidden="true">
            <Icone nom="boussole" />
          </span>
          <span class="heros-orienter-texte">
            <span>Pas encore d’école en tête&nbsp;?</span>
            <b>S’orienter selon votre situation</b>
          </span>
        </a>
      </div>
      <DessinCongo carte={carte} jour={jour} />
    </div>
  </section>

  <section class="cadre bloc-accueil" aria-labelledby="titre-reperes">
    <div class="bloc-tete">
      <h2 id="titre-reperes">Cinq repères sur votre chemin</h2>
      <p class="bloc-chapeau">Deux services sont disponibles. Trois sont en préparation.</p>
    </div>
    <div class="reperes">
      <section class="reperes-groupe" aria-labelledby="titre-disponibles">
        <h3 class="etat-groupe etat-disponible" id="titre-disponibles">
          <Icone nom="coche" />
          Disponible
        </h3>
        <ul class="reperes-liste">
          <li class="repere">
            <img src="/dessins/repere-trouver.svg" alt="" width="240" height="184" loading="lazy" />
            <h4>Trouver une école</h4>
            <p>Par nom, quartier ou niveau, ou autour de vous.</p>
            <a class="bouton bouton-secondaire repere-action" href="/ecoles/">
              {voirLesEcoles(ecoles.length)}
            </a>
          </li>
          <li class="repere">
            <img src="/dessins/repere-fiche.svg" alt="" width="240" height="184" loading="lazy" />
            <h4>Consulter une fiche</h4>
            <p>Niveaux, repère, photo, mentions datées. Le numéro, s’il est publié.</p>
            <a class="bouton bouton-secondaire repere-action" href={DEMO}>
              Fiche de démonstration
            </a>
          </li>
        </ul>
      </section>
      <section class="reperes-groupe" aria-labelledby="titre-preparation">
        <h3 class="etat-groupe etat-preparation" id="titre-preparation">
          <span class="etat-cercle" aria-hidden="true"></span>
          En préparation
        </h3>
        <ul class="reperes-liste reperes-liste-trois">
          <li class="repere repere-prepare">
            <img
              src="/dessins/repere-echanger.svg"
              alt=""
              width="240"
              height="184"
              loading="lazy"
            />
            <h4>Échanger sur NTanova</h4>
            <p>Écrire à l’école et lire sa réponse ici.</p>
            <p class="repere-note">Aujourd’hui&nbsp;: on appelle l’école.</p>
          </li>
          <li class="repere repere-prepare">
            <img src="/dessins/repere-demande.svg" alt="" width="240" height="184" loading="lazy" />
            <h4>Transmettre une demande</h4>
            <p>Une demande et ses pièces, envoyées à l’école.</p>
            <p class="repere-note">Selon l’établissement.</p>
          </li>
          <li class="repere repere-prepare">
            <img src="/dessins/repere-suivre.svg" alt="" width="240" height="184" loading="lazy" />
            <h4>Suivre ses démarches</h4>
            <p>Vos demandes, les réponses et les dates.</p>
            <p class="repere-note">Selon l’établissement.</p>
          </li>
        </ul>
      </section>
    </div>
    <p class="reperes-pied">
      Pour joindre une école aujourd’hui&nbsp;: son numéro, quand il est publié sur sa fiche. Les
      démarches en ligne dépendront de la participation de l’établissement.
    </p>
  </section>

  <section class="bande-accueil" aria-labelledby="titre-mentions">
    <div class="cadre mentions-grille">
      <div class="mentions-texte">
        <h2 id="titre-mentions">Des informations datées, avec leur origine</h2>
        <ul class="mentions">
          <li>
            <span class="mention-datee mention-datee-terrain">Vue sur place</span>
            <span>Un relais est passé devant l’école, ce jour-là.</span>
          </li>
          <li>
            <span class="mention-datee mention-datee-ecole">Déclarée par l’école</span>
            <span>La direction a transmis les informations.</span>
          </li>
          <li>
            <span class="mention-datee mention-datee-ajoutee">Ajoutée par NTanova</span>
            <span>L’équipe a documenté la fiche&nbsp;; personne n’est encore passé.</span>
          </li>
          <li>
            <span class="mention-datee mention-datee-direction">Confirmée par la direction</span>
            <span>La direction a relu la fiche et donné son accord, à une date.</span>
          </li>
        </ul>
        <p class="texte-doux">Une fiche peut porter plusieurs mentions, chacune avec sa date.</p>
        <div class="mentions-liens">
          <a class="lien-fort" href={DEMO}>
            Voir la fiche de démonstration
            <Icone nom="suite" />
          </a>
          <a class="lien-fort" href={LIEN_METHODE}>
            Fiabilité des informations
            <Icone nom="suite" />
          </a>
        </div>
      </div>
      {/* Un exemple, dit comme tel sur la ligne de son nom (règle du 17/11) : il ouvre la démonstration, jamais une fiche. */}
      <a
        class="exemple"
        href={DEMO}
        aria-label="École Les Manguiers, exemple : ouvrir la fiche de démonstration"
      >
        <img src="/dessins/demo-facade.svg" alt="" width="240" height="150" loading="lazy" />
        <span class="exemple-corps">
          <span class="exemple-nom">
            <b>
              École Les{' '}
              <span class="nom-exemple-fin">
                Manguiers <span class="etiquette-exemple">Exemple</span>
              </span>
            </b>
          </span>
          <span class="texte-doux">Primaire, collège · Privée</span>
          <span class="mention-datee mention-datee-terrain">
            Vue sur place · 12&nbsp;nov.&nbsp;2026
          </span>
          <span class="mention-datee mention-datee-direction">
            Confirmée par la direction · 18&nbsp;nov.&nbsp;2026
          </span>
          <span class="exemple-frais">Frais · OUI de l’école le 18&nbsp;nov.&nbsp;2026</span>
          <span class="texte-doux">L’itinéraire, le numéro s’il est publié, le partage.</span>
        </span>
      </a>
    </div>
  </section>

  {profils.length > 0 && (
    <section class="cadre bloc-accueil" aria-labelledby="titre-orienter">
      <div class="orienter-grille">
        <div class="orienter-texte">
          <div class="bloc-tete">
            <h2 id="titre-orienter">S’orienter, à chaque étape</h2>
            <p class="bloc-chapeau">Où en êtes-vous&nbsp;?</p>
          </div>
          <ul class="profils">
            {profils.map((p) => (
              <li>
                <a class="profil" href={p.lien}>
                  <span class="profil-texte">
                    <b>{p.titre}</b>
                    <span>{p.detail}</span>
                  </span>
                  <span class="profil-compte">{p.compte}</span>
                  <Icone nom="suite" />
                </a>
              </li>
            ))}
          </ul>
          <a class="lien-fort" href="/orienter/">
            Après le BEPC ou le bac&nbsp;: S’orienter
            <Icone nom="suite" />
          </a>
        </div>
        <img
          class="orienter-dessin"
          src="/dessins/orienter-carrefour.svg"
          alt=""
          width="300"
          height="240"
          loading="lazy"
        />
      </div>
    </section>
  )}

  <section class="cadre bloc-accueil" aria-labelledby="titre-villes">
    <div class="bloc-tete">
      <h2 id="titre-villes">Par ville</h2>
    </div>
    {villes.length > 0 ? (
      <ul class="villes">
        {villes.map((v) => (
          <li>
            <a class="ville" href={v.lien}>
              {v.dessin ? (
                <img src={v.dessin} alt="" width="240" height="150" loading="lazy" />
              ) : (
                <span class="ville-sans-dessin" aria-hidden="true" />
              )}
              <span class="ville-texte">
                <b>{v.nom}</b>
                <span>
                  {compterEcoles(v.total)} au {jour}
                  {v.puces.length > 0 && ` · ${arrondissementsCites(v)}`}
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="texte-doux">Les premières fiches arrivent au fil du relevé.</p>
    )}
  </section>

  <section class="cadre bloc-accueil bloc-dernier" aria-labelledby="titre-directions">
    <div class="directions sur-marque">
      <div class="directions-texte">
        <p class="directions-surtitre">Pour les écoles</p>
        <h2 id="titre-directions">Vous dirigez une école&nbsp;? Retrouvez sa fiche.</h2>
        <p>
          Corrigez-la, confirmez vos frais, ajoutez vos photos&nbsp;: sur WhatsApp, ou avec le code
          de votre fiche de liaison.
        </p>
        <div class="directions-actions">
          <a class="bouton bouton-accent" href="/pour-les-ecoles/">
            Présenter mon école
          </a>
          <p class="directions-prepare">
            <span class="etiquette-prepare">En préparation</span>
            Inscriptions, frais et reçus
          </p>
        </div>
      </div>
      <img
        class="directions-dessin"
        src="/dessins/ecole-directrice.svg"
        alt=""
        width="240"
        height="220"
        loading="lazy"
      />
    </div>
    {manque && (
      <div class="manque">
        <p>
          <b>Une école manque&nbsp;?</b>
          <span>Dites-nous son nom et son quartier.</span>
        </p>
        <a class="bouton bouton-secondaire" href={manque}>
          <Icone nom="bulle" />
          Signaler une école
        </a>
      </div>
    )}
  </section>
</PagePublique>

<style>
  /* L'échelle des grands titres de l'accueil (DESIGN_SYSTEM.md, « Échelle des titres publics », lot 1) ; les couleurs, rayons
     et espaces sont ceux des jetons. */
  .heros {
    background: var(--marque-appuyee);
    color: var(--texte-sur-marque);
  }
  .heros-grille {
    display: grid;
    gap: var(--espace-6);
    padding-top: var(--espace-5);
    padding-bottom: var(--espace-6);
  }
  /* Le dessin : jamais plus large que 30 rem tant qu'il est sous le texte, centré. */
  .heros-grille > :global(.dessin-congo) {
    justify-self: center;
    width: 100%;
    max-width: 30rem;
  }
  .heros-texte {
    display: grid;
    align-content: start;
    gap: 18px;
    min-width: 0;
  }
  .heros-surtitre {
    margin: 0;
    color: var(--vert-pale);
    font-family: var(--police-interface);
    font-size: var(--taille-secondaire);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .heros h1 {
    margin: 0;
    font-size: var(--taille-titre-accueil);
    line-height: 1.06;
    text-wrap: balance;
  }
  .heros-accent {
    color: var(--accent);
  }
  .heros-chapeau {
    margin: 0;
    max-width: 34rem;
    font-size: var(--taille-chapeau-accueil);
  }
  .heros-raccourcis {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--espace-4);
    font-size: 0.9375rem;
  }
  .heros-niveaux {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--espace-4);
  }
  .heros-niveaux-titre {
    color: var(--vert-pale);
  }
  .lien-clair {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--cible-min);
    color: var(--texte-sur-marque);
    font-weight: 700;
    text-underline-offset: 4px;
  }
  .lien-clair :global(svg) {
    width: 18px;
    height: 18px;
  }
  .lien-clair:focus-visible,
  .heros-orienter:focus-visible {
    outline: var(--epaisseur-focus) solid var(--focus);
    outline-offset: 2px;
    border-radius: var(--rayon-xs);
  }
  .heros-orienter {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: var(--espace-3);
    min-height: 52px;
    padding: 6px var(--espace-4) 6px var(--espace-2);
    border: 1px solid var(--vert);
    border-radius: var(--rayon-m);
    color: var(--texte-sur-marque);
    text-decoration: none;
  }
  .heros-orienter-rond {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--texte);
  }
  .heros-orienter-rond :global(svg) {
    width: 20px;
    height: 20px;
  }
  .heros-orienter-texte {
    display: grid;
    line-height: 1.25;
  }
  .heros-orienter-texte span {
    color: var(--vert-pale);
    font-size: var(--taille-secondaire);
  }
  .heros-orienter-texte b {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .seulement-large {
    display: none;
  }

  /* Les blocs de la page, sur le fond pierre. */
  .bloc-accueil {
    display: grid;
    gap: var(--espace-5);
    padding-top: var(--espace-7);
  }
  .bloc-dernier {
    padding-bottom: var(--espace-7);
  }
  .bloc-tete {
    display: grid;
    gap: var(--espace-2);
  }
  .bloc-accueil h2,
  .bande-accueil h2 {
    margin: 0;
    font-size: var(--taille-section-accueil);
    line-height: 1.15;
  }
  .bloc-chapeau {
    margin: 0;
    color: var(--texte-doux);
    font-size: var(--taille-intertitre);
  }

  /* Cinq repères : deux disponibles, trois en préparation (sans bouton). */
  .reperes {
    display: grid;
    gap: var(--espace-6);
  }
  .reperes-groupe {
    display: grid;
    align-content: start;
    gap: var(--espace-3);
  }
  .etat-groupe {
    display: inline-flex;
    align-items: center;
    gap: var(--espace-2);
    margin: 0;
    font-family: var(--police-interface);
    font-size: var(--taille-secondaire);
    font-weight: 700;
  }
  .etat-groupe :global(svg) {
    width: 18px;
    height: 18px;
    padding: 2px;
    border-radius: 50%;
    background: var(--marque-appuyee);
    color: var(--texte-sur-marque);
    stroke-width: 3;
  }
  .etat-cercle {
    width: 14px;
    height: 14px;
    border: 2px dashed var(--texte-doux);
    border-radius: 50%;
  }
  .reperes-liste {
    display: grid;
    gap: var(--espace-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .repere {
    display: flex;
    flex-direction: column;
    gap: var(--espace-2);
    padding: var(--espace-4);
    border: 1px solid var(--trait);
    border-radius: var(--rayon-m);
    background: var(--fond-releve);
  }
  .repere img {
    width: 100%;
    max-width: 130px;
    height: auto;
    align-self: center;
  }
  .repere h4 {
    margin: 0;
    font-family: var(--police-titre);
    font-size: var(--taille-intertitre);
  }
  .repere p {
    margin: 0;
    color: var(--texte-doux);
    font-size: 0.9375rem;
  }
  .repere-action {
    margin-top: auto;
    align-self: flex-start;
  }
  .repere-prepare {
    border-style: dashed;
    border-color: var(--trait-fort);
    background: transparent;
  }
  .repere-prepare img {
    opacity: 0.55;
    filter: grayscale(0.6);
  }
  .repere-note {
    margin-top: auto;
    font-size: var(--taille-secondaire);
  }
  .reperes-pied {
    margin: 0;
    color: var(--texte-doux);
  }

  /* Les mentions : la même grammaire que la fiche (vert : vu ou confirmé ; bleu : déclaré ; tirets : ajouté). */
  .bande-accueil {
    margin-top: var(--espace-7);
    padding-block: var(--espace-7);
    background: var(--fond-bande);
  }
  .mentions-grille {
    display: grid;
    gap: var(--espace-6);
  }
  .mentions-texte {
    display: grid;
    align-content: start;
    gap: var(--espace-4);
  }
  .mentions-texte p {
    margin: 0;
  }
  .mentions {
    display: grid;
    gap: var(--espace-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .mentions li {
    display: grid;
    justify-items: start;
    gap: var(--espace-1);
  }
  .mentions li > span:last-child {
    color: var(--texte-doux);
  }
  .mentions-liens {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--espace-5);
  }
  .lien-fort {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--cible-min);
    color: var(--marque);
    font-family: var(--police-interface);
    font-weight: 700;
  }
  .lien-fort :global(svg) {
    width: 18px;
    height: 18px;
  }
  .exemple {
    display: grid;
    align-self: start;
    overflow: hidden;
    border: 1px solid var(--trait);
    border-radius: var(--rayon-m);
    background: var(--fond-releve);
    color: var(--texte);
    text-decoration: none;
  }
  .exemple img {
    display: block;
    width: 100%;
    height: auto;
  }
  .exemple-corps {
    display: grid;
    justify-items: start;
    gap: var(--espace-2);
    padding: var(--espace-4);
  }
  .exemple-nom {
    display: block;
  }
  .exemple-nom b {
