---
// L'accueil du site à trois piliers (lot 3 ; planches « Accueil · téléphone » et « Accueil · ordinateur » de la version 44 du
// canevas, validées le 15/11/2026). Plus de carte : le premier écran n'a ni image ni carte, seulement la recherche et les villes
// (décision du 15/11, qui remplace le bloc de carte du 03/11 et l'aperçu du 14/11). `/carte/` est devenue la vue Carte de « Les écoles » (lot 4 bis).
//
// Aucun JavaScript : la recherche est un formulaire qui ouvre « Écoles » (`/ecoles/?q=…`), les puces sont des liens. Les
// chiffres sont calculés à la construction (`modele/accueil.ts`).
//
// État de passage, en attendant le lot 5 : le test d'orientation n'existe pas encore. La carte « Après le BEPC ou le bac »
// mène donc à « S'orienter » (`/orienter/`), qui ouvre les listes qui correspondent ; elle ne promet ni questions ni piste.
import { obtenirSite } from '../infra/index';
import {
  compterSuperieur,
  lienDuSuperieur,
  niveauxDeLAccueil,
  villesDeLAccueil,
  vuesRecemment,
} from '../modele/accueil';
import { compterEcoles } from '../modele/geo-divisions';
import { LIEN_METHODE } from '../modele/pages-de-confiance';
import Icone from '../ui/Icone.astro';
import PagePublique from '../ui/PagePublique.astro';
import CarteEcole from '../ui/CarteEcole.astro';
import '../ui/carte-pieces.css';

const { arbre, ecoles } = await obtenirSite();
const villes = villesDeLAccueil(arbre);
const niveaux = niveauxDeLAccueil(ecoles);
const superieur = lienDuSuperieur(compterSuperieur(ecoles));
// Les cartes « Vues sur place récemment » : la carte d'école partagée (lot 4), en colonne.
const recentes = vuesRecemment(ecoles);
---

<PagePublique
  titre="NTanova · Les écoles du Congo-Brazzaville, ville par ville"
  description="Maternelles, écoles, collèges, lycées, instituts et universités du Congo-Brazzaville, ville par ville et par formation : trouvez une école près de chez vous."
>
  <div class="cadre accueil">
    <div class="accueil-haut">
      <section class="ouverture" aria-labelledby="titre-accueil">
        <h1 id="titre-accueil">Trouvez une école au Congo-Brazzaville.</h1>
        <p class="chapeau">Des fiches relevées sur place, avec la date du passage.</p>
        <form class="recherche-accueil" action="/ecoles/" method="get" role="search">
          <Icone nom="loupe" petite={false} />
          <input
            class="champ"
            type="search"
            name="q"
            aria-label="Chercher une école"
            placeholder="Nom, quartier, filière"
          />
          <button class="bouton" type="submit">
            Chercher
          </button>
        </form>
      </section>

      <section class="ou" aria-labelledby="titre-ou">
        <h2 id="titre-ou">Où&nbsp;?</h2>
        {villes.length > 0 ? (
          <div class="villes">
            {villes.map((v) => (
              <section class="ville-carte" aria-label={v.nom}>
                <a class="ville-lien" href={v.lien}>
                  <b>
                    {v.nom}
                    <Icone nom="suite" />
                  </b>
                  <span>{compterEcoles(v.total)} sur NTanova</span>
                </a>
                {v.puces.length > 0 && (
                  <ul class="puces-lieux">
                    {v.puces.map((p) => (
                      <li>
                        <a class="puce-lieu" href={p.lien}>
                          <span class="puce-forme">
                            {p.nom}
                            <span class="puce-compte">
                              <span aria-hidden="true">{p.total}</span>
                              <span class="visuellement-cache">: {compterEcoles(p.total)}</span>
                            </span>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </section>
            ))}
          </div>
        ) : (
          <p class="texte-doux">Les premières fiches arrivent au fil du relevé.</p>
        )}
        <div class="ou-actions">
          <a class="bouton bouton-secondaire bouton-accueil" href="/ecoles/?autour=3">
            <Icone nom="cible" />
            Autour de moi
          </a>
          <a class="lien-fort" href="/ecoles/?vue=carte">
            <Icone nom="plan" />
            Voir la carte
          </a>
        </div>
      </section>
    </div>

    <section class="pour-qui" aria-labelledby="titre-pour-qui">
      <h2 id="titre-pour-qui">Pour qui&nbsp;?</h2>
      <div class="portes">
        <section class="porte" aria-labelledby="titre-enfant">
          <div class="porte-titre">
            <p class="surtitre">Pour mon enfant</p>
            <h3 id="titre-enfant">École, collège et lycée</h3>
          </div>
          <nav class="puces-niveaux" aria-label="Chercher par niveau">
            {niveaux.map((n) => (
              <a class="puce-niveau" href={n.lien}>
                <span class={`disque c-${n.lettre}`} aria-hidden="true">
                  {n.lettre}
                </span>
                {n.mot}
              </a>
            ))}
          </nav>
          <a class="lien-fort seulement-large" href="/ecoles/">
            Voir toutes les écoles ›
          </a>
        </section>
        <section class="porte" aria-labelledby="titre-apres">
          <div class="porte-titre">
            <p class="surtitre surtitre-superieur">
              <span class="disque c-S" aria-hidden="true">
                S
              </span>
              Après le BEPC ou le bac
            </p>
            <h3 id="titre-apres">Lycée, BTS, licence, formation pro</h3>
          </div>
          <p class="porte-texte">
            Dites où vous en êtes : vous voyez les adresses qui correspondent.
          </p>
          <a class="bouton bouton-accent bouton-accueil bouton-orienter" href="/orienter/">
            <Icone nom="boussole" />
            S’orienter
          </a>
          {superieur && (
            <a class="lien-fort" href="/ecoles/?niveau=S">
              {superieur} ›
            </a>
          )}
        </section>
      </div>
    </section>

    {recentes.length > 0 && (
      <section class="recentes" aria-labelledby="titre-recentes">
        <h2 id="titre-recentes">Vues sur place récemment</h2>
        <ul class="cartes-recentes">
          {recentes.map((e) => (
            <li>
              <CarteEcole ecole={e} />
            </li>
          ))}
        </ul>
        <a class="lien-fort recentes-toutes" href="/ecoles/">
          Toutes les écoles ›
        </a>
      </section>
    )}
  </div>

  {/* La preuve de la page : comment une fiche est tenue (audit du 05/11, D14 ; textes de la version 44). */}
  <section class="etapes-bande" aria-labelledby="titre-etapes">
    <div class="cadre etapes-cadre">
      <h2 id="titre-etapes">Comment les fiches sont tenues</h2>
      <ol class="etapes">
        <li class="etape">
          <span class="etape-numero" aria-hidden="true">
            1
          </span>
          <span class="etape-texte">
            <b>Relevée sur place</b>
            <span>Enseigne, position et niveaux relevés sur place, avec la date du passage.</span>
          </span>
        </li>
        <li class="etape">
          <span class="etape-numero" aria-hidden="true">
            2
          </span>
          <span class="etape-texte">
            <b>Confirmée par la direction</b>
            <span>
              La direction relit la fiche avec nous. La date de son accord est sur la fiche.
            </span>
          </span>
        </li>
        <li class="etape">
          <span class="etape-numero" aria-hidden="true">
            3
          </span>
          <span class="etape-texte">
            <b>Corrigée sur demande</b>
            <span>
              Une erreur&nbsp;? Écrivez-nous sur WhatsApp&nbsp;: nous corrigeons la fiche.
            </span>
          </span>
        </li>
      </ol>
      <a class="lien-fort" href={LIEN_METHODE}>
        Notre méthode ›
      </a>
    </div>
  </section>

  <div class="cadre accueil-bas">
    {/* « Rien de ce que vous nous confiez » : la fiche, elle, est publiée d'après le passage, sans attendre la direction. */}
    <aside class="appel-ecoles sur-marque" aria-labelledby="titre-appel">
      <div class="appel-ecoles-texte">
        <p class="appel-ecoles-surtitre">Espace écoles</p>
        <h2 id="titre-appel">
          Vous dirigez une école&nbsp;? Voyez sa fiche comme les familles la voient.
        </h2>
        <p class="appel-ecoles-detail">
          Un message WhatsApp suffit pour la compléter. Rien de ce que vous nous confiez n’est
          publié sans votre accord daté.
        </p>
      </div>
      <a class="bouton bouton-accent bouton-accueil" href="/pour-les-ecoles/">
        Ouvrir l’Espace écoles
      </a>
    </aside>
  </div>
</PagePublique>

<style>
  /* Les tailles sont celles des planches de la version 44 ; les couleurs, rayons et espaces, ceux des jetons. */
  .accueil {
    display: grid;
    gap: 28px;
    padding-top: 18px;
    padding-bottom: var(--espace-2);
  }
  /* L'interligne des titres de la planche (1,45) : celui de son texte, qu'ils héritent. */
  .accueil h2,
  .porte h3,
  .etapes-cadre h2 {
    line-height: 1.45;
  }
  .accueil h2 {
    font-size: 1.25rem;
  }
  .accueil-haut {
    display: grid;
    gap: 20px;
  }
  .ouverture {
    display: grid;
    gap: var(--espace-3);
  }
  .ouverture h1 {
    font-size: 1.875rem;
    line-height: 1.12;
    text-wrap: balance;
  }
  .chapeau {
    color: var(--texte-doux);
  }

  /* La recherche : un champ, sa loupe, et le bouton posé dedans. Sans JavaScript : elle ouvre « Écoles ». */
  .recherche-accueil {
    position: relative;
  }
  .recherche-accueil > :global(svg) {
    position: absolute;
    top: 15px;
    left: 14px;
    width: 22px;
    height: 22px;
    color: var(--texte-doux);
    pointer-events: none;
  }
  .recherche-accueil .champ {
    height: var(--hauteur-champ);
    padding: 0 112px 0 46px;
  }
  .recherche-accueil .bouton {
    position: absolute;
    top: 4px;
    right: 4px;
    min-height: 0;
    height: 44px;
    padding: 0 var(--espace-4);
    border-radius: 6px;
  }

  .ou,
  .pour-qui,
  .recentes {
    display: grid;
    gap: var(--espace-3);
  }
  .villes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--espace-2);
  }
  /* « .ville-carte », et non « .ville » : `.ville` est déjà la bulle du pays dans l'en-tête. */
  .ville-carte {
    display: flex;
    flex-direction: column;
    gap: var(--espace-3);
    min-width: 0;
    padding: var(--espace-3);
    border-radius: var(--rayon-m);
    background: var(--fond-bande);
  }
  .ville-lien {
    display: grid;
    align-content: start;
    gap: 2px;
    min-height: var(--cible-min);
    color: var(--texte);
    text-decoration: none;
  }
  .ville-lien b {
    display: flex;
    align-items: center;
    gap: var(--espace-1);
    font-family: var(--police-titre);
    font-size: 1.1875rem;
    line-height: 1.15;
  }
  .ville-lien :global(svg) {
    width: 18px;
    height: 18px;
    stroke-width: 2.2;
  }
  .ville-lien span {
    color: var(--texte-doux);
    font-size: 0.8125rem;
  }
  .puces-lieux {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* La puce de 40 px de la planche, dans un lien de 44 px (la cible de la charte) : la marge négative garde l'écart des puces. */
  .puce-lieu {
    display: inline-flex;
    padding-block: 2px;
    margin-block: -2px;
    border-radius: var(--rayon-pilule);
    color: var(--texte);
    text-decoration: none;
  }
  .puce-lieu:focus-visible {
    outline: none;
  }
  .puce-lieu:focus-visible .puce-forme {
    outline: var(--epaisseur-focus) solid var(--focus);
    outline-offset: 2px;
  }
  @media (hover: hover) {
    .puce-lieu:hover .puce-forme {
      border-color: var(--marque);
    }
  }
  .puce-forme {
    display: inline-flex;
    align-items: center;
    gap: var(--espace-2);
    min-height: 40px;
    padding: 0 6px 0 var(--espace-3);
    border: 1px solid var(--trait);
    border-radius: var(--rayon-pilule);
    background: var(--fond-releve);
    font-family: var(--police-interface);
    font-size: var(--taille-secondaire);
    font-weight: 700;
    white-space: nowrap;
  }
  .puce-compte {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 26px;
    height: 26px;
    padding: 0 7px;
    border-radius: var(--rayon-pilule);
    background: var(--vert-pale);
    color: var(--marque-appuyee);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .ou-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--espace-2) 20px;
  }
  .bouton-accueil {
    min-height: var(--cible-min);
    padding: 0 var(--espace-4);
    gap: 6px;
  }
  .bouton-accueil :global(svg),
  .lien-fort :global(svg) {
    width: 18px;
    height: 18px;
    stroke-width: 1.8;
  }
  .lien-fort {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--cible-min);
    color: var(--marque);
    font-family: var(--police-interface);
    font-weight: 700;
  }

  /* « Pour qui ? » : deux portes, l'une sous l'autre sur téléphone. */
  .portes {
    display: grid;
    gap: var(--espace-3);
  }
  .porte {
    display: flex;
    flex-direction: column;
    gap: var(--espace-3);
    padding: var(--espace-4);
    border: 1px solid var(--trait);
    border-radius: var(--rayon-m);
    background: var(--fond-releve);
  }
  .porte-titre {
    display: grid;
    gap: 2px;
  }
  .porte h3 {
    font-size: 1.25rem;
  }
  .surtitre {
    display: flex;
    align-items: center;
    gap: var(--espace-2);
    color: var(--texte-doux);
    font-family: var(--police-interface);
    font-size: var(--taille-mention);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .surtitre-superieur {
    color: var(--cycle-superieur);
  }
  .surtitre .disque {
    width: 20px;
    height: 20px;
    font-size: 0.6875rem;
    letter-spacing: 0;
  }
  .puces-niveaux {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espace-2);
  }
  .puce-niveau {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: var(--cible-min);
    padding: 0 var(--espace-3) 0 6px;
    border: 1px solid var(--trait);
    border-radius: var(--rayon-pilule);
    background: var(--fond-releve);
    color: var(--texte);
    font-family: var(--police-interface);
    font-size: var(--taille-secondaire);
    font-weight: 700;
    text-decoration: none;
  }
  .puce-niveau .disque {
    width: 24px;
    height: 24px;
  }
  .porte-texte {
    color: var(--texte-doux);
    font-size: 0.9375rem;
  }
  .bouton-orienter {
    align-self: flex-start;
    min-height: var(--cible-principale);
  }
  .seulement-large {
    display: none;
  }

  /* « Vues sur place récemment » : des cartes qui défilent sur téléphone, une rangée de quatre sur ordinateur. */
  .recentes {
    grid-template-areas: 'titre' 'liste' 'lien';
    margin-inline: calc(var(--espace-4) * -1);
  }
  .recentes h2 {
    grid-area: titre;
    padding-inline: var(--espace-4);
  }
  .cartes-recentes {
    grid-area: liste;
    display: flex;
    gap: 10px;
    margin: 0;
    padding: 0 var(--espace-4) var(--espace-1);
    overflow-x: auto;
    list-style: none;
  }
  .recentes-toutes {
    grid-area: lien;
    justify-self: start;
    padding-inline: var(--espace-4);
  }
  /* Toute la carte ouvre la fiche, comme une ligne de la liste « Écoles ». */
  .cartes-recentes > li {
    display: flex;
    flex: none;
    width: 220px;
  }
  /* « Comment les fiches sont tenues » : trois étapes, le numéro à gauche sur téléphone. */
  .etapes-bande {
    margin-top: 20px;
    background: var(--fond-bande);
  }
  .etapes-cadre {
    display: grid;
    gap: var(--espace-3);
    padding-block: var(--espace-5);
  }
  .etapes-cadre h2 {
    font-size: 1.25rem;
  }
  .etapes {
    display: grid;
    gap: var(--espace-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .etape {
    display: flex;
    gap: var(--espace-3);
    padding: var(--espace-3);
    border-radius: var(--rayon-m);
    background: var(--fond-releve);
  }
  .etape-numero {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--marque);
    color: var(--texte-sur-marque);
    font-family: var(--police-interface);
    font-weight: 700;
  }
  .etape-texte {
    display: flex;
    flex-direction: column;
  }
  .etape-texte span {
    color: var(--texte-doux);
    font-size: var(--taille-secondaire);
  }

  /* L'appel aux directions : la bande verte de l'Espace écoles. */
  .accueil-bas {
    padding-top: var(--espace-5);
    padding-bottom: 28px;
  }
  .appel-ecoles {
    display: flex;
    flex-direction: column;
    gap: var(--espace-4);
    padding: 20px;
    border-radius: var(--rayon-l);
    background: var(--marque-appuyee);
    color: var(--texte-sur-marque);
  }
  .appel-ecoles-texte {
    display: grid;
    gap: var(--espace-2);
    max-width: 640px;
  }
  .appel-ecoles-surtitre {
    color: var(--accent);
    font-family: var(--police-interface);
    font-size: var(--taille-mention);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .appel-ecoles h2 {
    font-size: 1.5rem;
    line-height: 1.15;
  }
  .appel-ecoles-detail {
    color: var(--vert-pale);
    font-size: 0.9375rem;
  }
  .appel-ecoles .bouton {
    align-self: flex-start;
    min-height: var(--cible-principale);
  }

  /* Ordinateur (planche « Accueil · ordinateur »). */
  @media (min-width: 48rem) {
    .accueil {
      gap: 40px;
      padding-top: var(--espace-5);
    }
    .accueil h2 {
      font-size: 1.625rem;
    }
    .accueil-haut {
      align-items: center;
      gap: 56px;
      padding-block: var(--espace-4) var(--espace-2);
    }
    .ouverture {
      gap: 20px;
    }
    .ouverture h1 {
      font-size: 2.875rem;
      line-height: 1.08;
    }
    .chapeau {
      max-width: 520px;
      font-size: 1.1875rem;
    }
    .recherche-accueil > :global(svg) {
      top: 17px;
    }
    .recherche-accueil .champ {
      height: 56px;
      padding-right: 140px;
    }
    .recherche-accueil .bouton {
      height: var(--cible-principale);
    }
    .villes {
      gap: var(--espace-4);
    }
    .ville-carte {
      padding: 20px;
    }
    .ville-lien b {
      font-size: 1.5rem;
    }
    .portes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--espace-4);
    }
    .porte h3 {
      font-size: 1.375rem;
    }
    .puce-niveau {
      padding: 0 14px 0 var(--espace-2);
    }
    .seulement-large {
      display: inline-flex;
    }
    .recentes {
      grid-template-areas: 'titre lien' 'liste liste';
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: baseline;
      gap: 14px var(--espace-4);
      margin-inline: 0;
    }
    .recentes h2,
    .recentes-toutes {
      padding-inline: 0;
    }
    /* Les liens « › » posés sur une ligne de texte, comme sur la planche : la cible garde 44 px, la marge négative la rend. */
    .recentes-toutes,
    .etapes-cadre .lien-fort {
      margin-block: -11px;
    }
    .cartes-recentes {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--espace-4);
      padding: 0;
      overflow: visible;
    }
    .cartes-recentes > li {
      width: auto;
    }
    .etapes-bande {
      margin-top: var(--espace-6);
    }
    .etapes-cadre {
      gap: 20px;
      padding-block: 40px;
    }
    .etapes-cadre h2 {
      font-size: 1.625rem;
    }
    .etapes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--espace-4);
    }
    .etape {
      flex-direction: column;
      gap: 10px;
      padding: 20px;
    }
    .etape-numero {
      width: 2.5rem;
      height: 2.5rem;
    }
    .etape-texte {
      gap: 10px;
    }
    .etape-texte b {
      font-family: var(--police-titre);
