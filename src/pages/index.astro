---
// L'accueil : les villes où des écoles sont publiées, et ce que chacune compte d'écoles.
// HTML construit à partir de la base ; îlot de carte différé à sa visibilité.
// Sous 48 rem, la page d'un téléphone. À partir de 48 rem, la planche « Accueil sur ordinateur » du canevas.
import { PUBLIC_WHATSAPP } from 'astro:env/client';
import { obtenirSite } from '../infra/index';
import { donneesDeLaCarte, arrondissementDuRepli } from '../modele/carte/instantane';
import { etatPublicDe, libelleDeploiement } from '../modele/etat-zone';
import { compterEcoles, ecolesSous, lienDivision } from '../modele/geo-divisions';
import { lienWhatsApp } from '../modele/whatsapp';
import ExplorateurCarte from '../ui/ExplorateurCarte.astro';
import PagePublique from '../ui/PagePublique.astro';

const site = await obtenirSite();
const { arbre, ecoles, divisions } = site;
const whatsapp = lienWhatsApp(PUBLIC_WHATSAPP, 'Bonjour NTanova, ');
const pointeNoire = arbre.parAdresse.get('congo/pointe-noire');
// Les villes et départements : les zones juste sous le pays. Là où l'on a des fiches d'abord, puis par nom.
const villes = arbre.racines
  .flatMap((racine) => racine.enfants)
  .map((zone) => {
    const siennes = ecolesSous(zone);
    return {
      zone,
      total: siennes.length,
      verifiees: siennes.filter((e) => e.etat === 'verifiee').length,
      // L'état public de la ville, celui de la carte : une ville sans école le dit au lieu d'afficher « 0 écoles ».
      etat: etatPublicDe(zone.division, divisions),
    };
  })
  .sort(
    (a, b) => b.total - a.total || a.zone.division.nom.localeCompare(b.zone.division.nom, 'fr'),
  );
---

<PagePublique
  titre="NTanova · Les écoles du Congo-Brazzaville, ville par ville"
  description="Maternelles, écoles, collèges, lycées, instituts et universités du Congo-Brazzaville, ville par ville et par formation : trouvez une école près de chez vous."
  whatsapp={whatsapp}
>
  <div class="cadre accueil">
    <div class="haut haut-carte">
      <div class="ouverture">
        <p class="surtitre-public">
          <span class="insecable">Congo-Brazzaville</span>
        </p>
        <h1>Trouvez une école au Congo-Brazzaville.</h1>
        <p class="chapeau">
          Explorez les écoles vues sur place ou cherchez par nom, ville et formation.
        </p>
        <nav class="actions-accueil" aria-label="Chercher une école">
          {/* Le seul bouton principal vers /carte/ (audit du 05/11, D9) : une fois la carte de l'aperçu chargée, son adresse
              emporte la vue choisie (`chargeur.ts`). */}
          <a class="bouton" href="/carte/" data-vers-carte>
            Explorer la carte
          </a>
          <a class="bouton bouton-secondaire" href="/recherche/">
            Rechercher une école
          </a>
          <a class="lien-carte" href="/autour-de-moi/">
            Autour de moi
          </a>
        </nav>
        {ecoles.length === 0 && (
          <p class="carte note">
            Le relevé commence à <span class="insecable">Pointe-Noire</span>. Les premières fiches
            arrivent au fil du relevé.
          </p>
        )}
      </div>

      <ExplorateurCarte donnees={donneesDeLaCarte(site)} repli={arrondissementDuRepli(site)} />
    </div>

    <section id="quartiers" aria-labelledby="titre-quartiers">
      <h2 id="titre-quartiers" class="titre-quartiers visuellement-cache">
        Les villes
      </h2>
      {villes.length > 0 ? (
        <ul class="quartiers">
          {villes.map((v) => (
            <li>
              <a
                class:list={['quartier', { 'quartier-plein': v.total > 0 }]}
                href={lienDivision(v.zone.adresse)}
              >
                <span class="quartier-nom">{v.zone.division.nom}</span>
                <span class="quartier-detail">
                  <span class="quartier-compte">
                    {v.total > 0
                      ? compterEcoles(v.total)
                      : v.etat
                        ? libelleDeploiement[v.etat]
                        : 'Aucune école publiée'}
                    {v.verifiees > 0
                      ? `, dont ${v.verifiees} confirmée${v.verifiees > 1 ? 's' : ''} par la direction`
                      : ''}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="texte-doux">Les premières villes arrivent avec les premières fiches.</p>
      )}
      <div class="liens-villes">
        {pointeNoire && (
          <a class="lien-carte" href={lienDivision(pointeNoire.adresse)}>
            <span>
              Les arrondissements de <span class="insecable">Pointe-Noire</span>
            </span>
          </a>
        )}
        <a class="lien-carte" href="/ecoles/">
          <span>Voir toutes les écoles</span>
        </a>
        <a class="lien-carte" href="/formations/">
          <span>Les écoles par formation</span>
        </a>
      </div>
    </section>
  </div>

  {/* La preuve de la page : comment une fiche est tenue. Visible aussi sur téléphone (audit du 05/11, D14), en une colonne
      entre les villes et l'appel aux directions. */}
  <section class="etapes-bande" aria-labelledby="titre-etapes">
    <div class="cadre">
      <h2 id="titre-etapes">Comment les fiches sont tenues</h2>
      <ol class="etapes">
        <li class="etape">
          <span class="etape-numero" aria-hidden="true">
            1
          </span>
          <h3>Vue sur place par des jeunes du quartier</h3>
          <p>
            Un jeune du quartier passe devant l'école&nbsp;: enseigne, position, niveaux. Seulement
            ce qui se voit de la rue, avec la date de son passage.
          </p>
        </li>
        <li class="etape">
          <span class="etape-numero" aria-hidden="true">
            2
          </span>
          <h3>Confirmée par la direction</h3>
          <p>
            La direction relit la fiche avec nous et donne son accord. La date de cet accord est sur
            la fiche. Rien de ce qu'elle nous confie n'est publié sans lui.
          </p>
        </li>
        <li class="etape">
          <span class="etape-numero" aria-hidden="true">
            3
          </span>
          <h3>Corrigée sur demande</h3>
          <p>
            Une erreur, une école qui a changé&nbsp;? Écrivez-nous sur WhatsApp&nbsp;: nous
            corrigeons la fiche.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <div class="cadre accueil-bas">
    <aside class="ecoles-appel ecoles-appel-large">
      <div class="appel-texte">
        <p class="appel-surtitre">Pour les écoles</p>
        <p class="appel-titre">
          <b>Vous dirigez une école&nbsp;?</b> Confirmez sa fiche avec nous.
        </p>
        <p class="appel-detail">
          La date de votre accord paraît sur la fiche. Rien de ce que vous nous confiez n'est publié
          sans lui.
        </p>
      </div>
      <a class="bouton bouton-accent" href="/pour-les-ecoles/">
        <span class="appel-court">Pour les écoles</span>
        <span class="appel-long">Confirmer la fiche de mon école</span>
      </a>
    </aside>
  </div>
</PagePublique>

<style>
  /* Les boutons gardent leur hauteur (48 px) : le lien « Autour de moi » est centré sur la ligne et n'a pas de marge qui
     étirerait le bouton à côté de lui (il mesurait 56 px au lieu de 48). */
  .actions-accueil {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ecart-cibles);
  }
  .actions-accueil .lien-carte {
    margin-top: 0;
  }
  .lien-carte {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
    margin-top: var(--espace-3);
    color: var(--marque);
    font-family: var(--police-titre);
    font-weight: 700;
  }
  /* Les liens sous les villes : jamais collés (ils se touchaient sur ordinateur, où ils tiennent sur une ligne). */
  .liens-villes {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--espace-5);
  }
  .liens-villes .lien-carte {
    margin-top: var(--espace-3);
  }
  .accueil {
    display: grid;
    gap: var(--espace-5);
    padding-top: var(--espace-6);
    padding-bottom: var(--espace-5);
  }
  .accueil-bas {
    padding-bottom: var(--espace-6);
  }
  /* L'ouverture et l'aperçu de la carte : l'un sous l'autre, puis côte à côte à partir de 64 rem. */
  .haut {
    display: grid;
    gap: var(--espace-5);
  }
  .ouverture {
    display: grid;
    gap: var(--espace-5);
  }
  .accueil h1 {
    margin: 0;
    color: var(--marque-appuyee);
    font-family: var(--police-titre);
    font-size: var(--taille-titre-page);
    line-height: var(--interligne-titre);
  }
  .chapeau,
  .note {
    margin: 0;
    color: var(--texte-doux);
  }
  .quartiers {
    display: grid;
    gap: var(--espace-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .quartier {
    display: grid;
    gap: var(--espace-1);
    min-height: var(--cible-principale);
    padding: var(--espace-4);
    border: 1px solid var(--trait);
    border-radius: var(--rayon-m);
    background: var(--fond-releve);
    color: var(--texte);
    text-decoration: none;
  }
  .quartier-nom {
    font-family: var(--police-titre);
    font-size: var(--taille-intertitre);
    font-weight: 700;
  }
  .quartier-detail {
    color: var(--texte-doux);
    font-size: var(--taille-secondaire);
  }
  /* Sur téléphone, « Arrondissement 3 · 1 école » sur une ligne. */
  .quartier-numero::after {
    content: ' · ';
  }
  /* « Comment les fiches sont tenues » sur téléphone : trois étapes l'une sous l'autre, le numéro à gauche du texte. */
  .etapes-bande {
    padding-block: var(--espace-5);
    background: var(--fond-bande);
  }
  .etapes-bande h2 {
    margin: 0 0 var(--espace-4);
    color: var(--marque-appuyee);
    font-family: var(--police-titre);
    font-size: var(--taille-intertitre);
  }
  .etapes {
    display: grid;
    gap: var(--espace-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .etape {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: var(--espace-1) var(--espace-3);
    padding: var(--espace-4);
    border-radius: var(--rayon-m);
    background: var(--fond-releve);
  }
  .etape h3,
  .etape p {
    margin: 0;
  }
  .etape h3 {
    font-family: var(--police-titre);
    font-size: var(--taille-courante);
  }
  .etape p {
    grid-column: 2;
    color: var(--texte-doux);
    font-size: var(--taille-secondaire);
  }
  .etape-numero {
    grid-row: 1 / span 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--marque);
    color: var(--texte-sur-marque);
    font-family: var(--police-titre);
    font-weight: 700;
  }

  /* À partir de 48 rem : la planche « Accueil sur ordinateur ». */
  @media (min-width: 48rem) {
    .accueil {
      gap: var(--espace-6);
      padding-top: var(--espace-7);
      padding-bottom: var(--espace-7);
    }
    .accueil-bas {
      padding-top: var(--espace-7);
      padding-bottom: var(--espace-7);
    }
    .ouverture {
      gap: var(--espace-4);
    }
    .haut-carte {
      gap: var(--espace-6);
    }
    .accueil h1 {
      font-size: var(--taille-titre-accueil);
      line-height: 1.05;
      text-wrap: balance;
    }
    .chapeau {
      font-size: var(--taille-chapeau);
      line-height: 1.55;
    }

    .titre-quartiers {
      position: static;
      width: auto;
      height: auto;
      margin-bottom: var(--espace-4);
      overflow: visible;
      clip-path: none;
      color: var(--marque-appuyee);
      font-size: var(--taille-titre-section);
      white-space: normal;
    }
    .quartiers {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
      gap: var(--espace-4);
    }
    .quartiers li {
      display: grid;
    }
    .quartier {
      display: flex;
      flex-direction: column;
      gap: var(--espace-2);
      min-height: 8.75rem;
      padding: var(--espace-5);
      border-radius: var(--rayon-l);
    }
    .quartier:hover {
      border-color: var(--marque);
    }
    .quartier-nom {
      font-size: var(--taille-titre-fiche);
    }
    .quartier-detail {
      display: flex;
      flex: 1;
      flex-direction: column;
      gap: var(--espace-2);
    }
    .quartier-numero::after {
      content: none;
    }
    .quartier-compte {
      margin-top: auto;
      align-self: flex-start;
      padding: var(--espace-1) var(--espace-3);
      border: 2px solid var(--marque);
      border-radius: var(--rayon-pilule);
      color: var(--marque);
      font-family: var(--police-titre);
      font-weight: 700;
    }
    .quartier-compte::first-letter {
      text-transform: uppercase;
    }
    /* Là où l'on a des fiches : la carte verte, et le compte en jaune. */
    .quartier-plein {
      border-color: var(--marque);
      background: var(--marque);
      color: var(--texte-sur-marque);
    }
    .quartier-plein:hover {
      border-color: var(--marque-appuyee);
      background: var(--marque-appuyee);
    }
    .quartier-plein .quartier-detail {
      color: var(--vert-pale);
    }
    .quartier-plein .quartier-compte {
      border-color: var(--accent);
      background: var(--accent);
      color: var(--texte);
    }

    /* Les étapes passent en cartes côte à côte : le numéro au-dessus du texte. */
    .etapes-bande {
      padding-block: var(--espace-7);
    }
    .etapes-bande h2 {
      margin-bottom: var(--espace-5);
      font-size: var(--taille-titre-section);
    }
    .etapes {
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
      gap: var(--espace-4);
    }
    .etape {
      grid-template-columns: none;
      align-content: start;
      gap: var(--espace-3);
      padding: var(--espace-5);
      border-radius: var(--rayon-l);
    }
    .etape h3 {
      font-size: var(--taille-intertitre);
    }
    .etape p {
      grid-column: auto;
      font-size: inherit;
    }
    .etape-numero {
      grid-row: auto;
      width: 2.5rem;
      height: 2.5rem;
    }
  }

  /* À partir de 64 rem : l'ouverture à gauche, l'aperçu de la carte à droite. */
  @media (min-width: 64rem) {
    .haut-carte {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      align-items: center;
    }
  }
</style>

<script>
  import { initialiserCartes } from '../app/carte/chargeur';
  initialiserCartes();
</script>
