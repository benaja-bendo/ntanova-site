---
// Pour les directions d'école : confirmer la fiche avec NTanova, sur WhatsApp.
// Le code de la fiche de liaison part dans le message, sans JavaScript : le
// formulaire ouvre wa.me avec le code comme texte.
import { PUBLIC_WHATSAPP } from 'astro:env/client';
import { lienWhatsApp } from '../modele/whatsapp';
import PagePublique from '../ui/PagePublique.astro';

const whatsapp = lienWhatsApp(PUBLIC_WHATSAPP, 'Bonjour NTanova, ');
const sansFiche = lienWhatsApp(PUBLIC_WHATSAPP, 'Bonjour NTanova, je dirige l’école ');
const referencer = lienWhatsApp(
  PUBLIC_WHATSAPP,
  'Bonjour NTanova, je souhaite référencer mon établissement au Congo-Brazzaville. Nom : … Ville ou localité : …',
);
const formulaire = lienWhatsApp(PUBLIC_WHATSAPP);
---

<PagePublique
  titre="Pour les écoles · NTanova"
  description="Vous dirigez un établissement au Congo-Brazzaville ? Demandez son référencement ou complétez sa fiche avec nous."
  whatsapp={whatsapp}
>
  <section class="cadre page ecoles-page">
    <div class="ecoles-gauche">
      <div class="pile-titre">
        <p class="surtitre-public">Pour les directions</p>
        <h1>Vous dirigez une école&nbsp;?</h1>
        <p class="texte-doux">
          Sa fiche est peut-être déjà sur NTanova, avec ce qui se voit de la rue. Confirmez-la et
          complétez-la avec nous.
        </p>
      </div>

      <section class="carte bloc" id="referencer" aria-labelledby="titre-referencer">
        <h2 id="titre-referencer">Référencez votre établissement</h2>
        <p class="texte-doux">
          Partout au Congo-Brazzaville, même si aucun relais n’est encore passé dans votre localité.
          Transmettez-nous le nom et la localité de l’établissement ; nous relirons les informations
          avec vous.
        </p>
        {referencer && (
          <a class="bouton" href={referencer}>
            Demander le référencement sur WhatsApp
          </a>
        )}
        <p class="mention-public">
          La demande ne publie pas automatiquement votre établissement. Avant un passage sur place,
          sa fiche porte la mention « Déclarée par l’école ». La confirmation par la direction reste
          une démarche distincte.
        </p>
      </section>
      {formulaire && (
        <form class="carte liaison" action={formulaire} method="get">
          <h2>Vous avez reçu une fiche de liaison&nbsp;?</h2>
          <label for="code">Le code à 4 chiffres écrit dessus</label>
          <input
            id="code"
            class="champ code"
            name="text"
            inputmode="numeric"
            pattern="[0-9]{4}"
            maxlength="4"
            autocomplete="off"
            required
            placeholder="_ _ _ _"
          />
          <button class="bouton" type="submit">
            Continuer sur WhatsApp
          </button>
          <p class="mention-public">
            Le message part avec votre code. NTanova vous répond pour relire la fiche avec vous.
          </p>
        </form>
      )}

      {sansFiche && (
        <a class="lien-fort" href={sansFiche}>
          Pas de fiche de liaison&nbsp;? Écrivez-nous sur WhatsApp
        </a>
      )}
    </div>

    <div class="ecoles-droite">
      <section class="carte bloc">
        <h2>Ce que votre école y gagne</h2>
        <ul class="avantages">
          <li>Une fiche juste, que vous relisez et corrigez avec nous.</li>
          <li>
            La mention «&nbsp;Confirmée par la direction&nbsp;» et la date de votre accord, sur la
            fiche.
          </li>
        </ul>
      </section>

      <section class="bloc">
        <h2>Ce que nous vous demanderons</h2>
        <ol class="etapes">
          <li>Les frais communiqués par l’école, avec leur période et leur date.</li>
          <li>Le numéro WhatsApp que l'école veut publier.</li>
          <li>Trois à cinq photos&nbsp;: la façade, une salle, la cour. Sans enfant.</li>
          <li>Si vous le voulez, quelques mots de la direction.</li>
        </ol>
        <p class="texte-doux">
          Le contact public, les frais et les équipements peuvent figurer sur la fiche avec leur
          source et leur date. Les photos ne sont pas encore publiées par cette démarche. Chaque
          publication se décide avec vous ; une modification apparaît après une mise à jour du site.
        </p>
      </section>

      <div class="fin">
        <p class="texte-doux">
          Rien n'est ajouté à la fiche sans votre accord. Vous voulez la corriger ou la
          retirer&nbsp;? Écrivez-nous&nbsp;: nous le faisons.
        </p>
        <a class="lien-fort" href="/a-propos/">
          Qui est NTanova&nbsp;? Ce que nous faisons de vos données
        </a>
      </div>
    </div>
  </section>
</PagePublique>

<style>
  .ecoles-page {
    display: grid;
    gap: var(--espace-5);
  }
  .ecoles-page h1 {
    margin: 0;
    color: var(--marque-appuyee);
    font-family: var(--police-titre);
    font-size: var(--taille-titre-page);
    line-height: var(--interligne-titre);
  }
  .ecoles-page h2 {
    margin: 0;
    font-family: var(--police-titre);
    font-size: var(--taille-intertitre);
  }
  .ecoles-page p {
    margin: 0;
  }
  .pile-titre,
  .liaison,
  .bloc,
  .fin {
    display: grid;
    gap: var(--espace-3);
  }
  /* Sur téléphone, les deux colonnes se suivent. */
  .ecoles-gauche,
  .ecoles-droite {
    display: grid;
    align-content: start;
    gap: var(--espace-5);
  }
  .liaison label {
    font-weight: 700;
  }
  .code {
    font-family: var(--police-titre);
    font-size: var(--taille-titre-fiche);
    font-weight: 700;
    letter-spacing: 0.5em;
    text-align: center;
  }
  .mention-public {
    color: var(--texte-doux);
    font-size: var(--taille-secondaire);
  }
  .lien-fort {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
    color: var(--marque);
    font-weight: 700;
  }
  .avantages,
  .etapes {
    display: grid;
    gap: var(--espace-2);
    margin: 0;
    padding-left: var(--espace-5);
  }

  /* À partir de 48 rem : une colonne de 44 rem ; à partir de 64 rem, le formulaire à gauche, les explications à droite. */
  @media (min-width: 48rem) {
    .ecoles-page {
      padding-block: var(--espace-7);
    }
    .ecoles-page h1 {
      font-size: var(--taille-titre-public);
    }
    .ecoles-gauche,
    .ecoles-droite {
      max-width: 44rem;
    }
  }
  @media (min-width: 64rem) {
    .ecoles-page {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--espace-7);
      align-items: start;
    }
    .ecoles-gauche,
    .ecoles-droite {
      max-width: none;
    }
  }
</style>
