# En-têtes servis par Cloudflare (Workers, fichiers statiques).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# L'espace relais a besoin de la position et de l'appareil photo.
/relais/*
  ! Permissions-Policy
  Permissions-Policy: camera=(self), microphone=(), geolocation=(self)

# « Autour de moi », filtre de la page « Écoles » (ticket 146), demande la position de la personne, à l'appui d'un bouton :
# elle sert à classer des écoles déjà dans la page et n'est envoyée à personne. Pas d'appareil photo ici. La page seule :
# les pages des lieux et les fiches, sous `/ecoles/…`, gardent la règle générale.
/ecoles/
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)

# Fichiers nommés d'après leur contenu : gardés un an.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Polices : gardées un mois (changer le nom du fichier si la police change).
/polices/*
  Cache-Control: public, max-age=2592000

# Les glyphes de la carte (ticket #114) : le dossier porte le nom de la police, qui change si la police change.
# Gardés un an : un téléphone ne repaie pas ses 74 Ko à chaque visite.
/polices/carte/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Le guide du relais (ticket #110) : public mais non listé. Ni la page, ni le PDF, ni les images dans un moteur de
# recherche. Les fichiers exportés portent la version et la date dans leur nom : ils ne changent jamais sous un même nom.
/guide-relais/*
  X-Robots-Tag: noindex, nofollow
/guide-relais/*.pdf
  Cache-Control: public, max-age=86400
/guide-relais/*.png
  Cache-Control: public, max-age=86400

# Carte : position uniquement à l’appui du bouton, sans caméra ni microphone.
/carte/*
  ! Permissions-Policy
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
