{
  "name": "ntanova-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pnpm guide:exporter",
    "guide:exporter": "node outils/guide-relais/exporter.ts",
    "preview": "wrangler dev",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:parcours": "PUBLIC_ADAPTATEUR=faux PUBLIC_WHATSAPP=${PUBLIC_WHATSAPP:-242000000000} astro build && PUBLIC_WHATSAPP=${PUBLIC_WHATSAPP:-242000000000} pnpm guide:exporter && playwright test",
    "captures": "PUBLIC_ADAPTATEUR=faux PUBLIC_WHATSAPP=${PUBLIC_WHATSAPP:-242000000000} astro build && playwright test -c playwright.captures.config.ts",
    "couleurs": "node outils/verifier-couleurs.mjs",
    "poids": "node outils/verifier-poids.mjs",
    "base:demarrer": "supabase start",
    "base:arreter": "supabase stop",
    "base:reset": "supabase db reset",
    "base:tests": "supabase test db",
    "verif": "pnpm format:check && pnpm lint && pnpm couleurs && pnpm check && pnpm test && pnpm build && pnpm poids",
    "test:en-ligne": "playwright test -c playwright.en-ligne.config.ts"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@supabase/supabase-js": "^2.118.0",
    "astro": "^7.4.4",
    "dexie": "^4.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "supabase": "^2.122.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
